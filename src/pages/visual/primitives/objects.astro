    <!-- DEEP CLONE -->
    <MethodCard
        id="deep-clone"
        methodName="Deep clone"
        signature="structuredClone(obj)"
        description="Create a deep copy of nested objects"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}user: {"{"}id: 1{"}"}{"}"}
                </div>
            </Node>

            <Arrow label="deep copy" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="structuredClone(obj)"
                    description="Clone all levels"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}user: {"{"}id: 1{"}"}{"}"}
                </div>
                <div class="text-center text-xs text-gray-400 mt-1">
                    fully independent
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns a <code
                >new object</code
            > with all nested levels cloned. Changes to nested objects don't
            affect the original.
        </MutableOrNot>

        <ProTip>
            <div>
                <strong>Shallow vs deep clone with nested objects:</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const obj = {"{"}user: {"{"}id: 1{"}"}{"}"}
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-red-400"
                        >// Shallow: nested still shared! <Mark type="warn" /></span
                    >
                </div>
                <div class="font-mono text-xs">
                    const shallow = {"{"} ...obj {"}"}
                </div>
                <div class="font-mono text-xs">
                    shallow.user.id = 999 <span class="text-red-400"
                        >// obj.user.id also becomes 999!</span
                    >
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-green-400"
                        >// Deep: fully independent <Mark type="yes" /></span
                    >
                </div>
                <div class="font-mono text-xs">
                    const deep = structuredClone(obj)
                </div>
                <div class="font-mono text-xs">
                    deep.user.id = 999 <span class="text-green-400"
                        >// obj.user.id stays 1 <Mark type="yes" /></span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- DEEP MERGE -->
    <MethodCard
        id="deep-merge"
        methodName="Deep merge pattern"
        signature="Custom recursive merge function"
        description="Merge nested objects recursively"
        mutates={false}
    >
        <Flow>
            <Node label="Two Objects" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: {"{"}x: 1{"}"}{"}"}
                </div>
                <div class="text-center text-sm font-mono">
                    {"{"}a: {"{"}y: 2{"}"}{"}"}
                </div>
            </Node>

            <Arrow label="merge" />

            <Node label="Deep Merge" type="process">
                <ProcessContent
                    name="deepMerge(obj1, obj2)"
                    description="Recursive merge"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Merged Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: {"{"}x: 1, y: 2{"}"}{"}"}
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns a <code
                >new object</code
            >. Needs a custom function or a library (lodash.merge).
        </MutableOrNot>

        <ProTip>
            <div><strong>Simple deep merge function:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    function deepMerge(target, source) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const result = {"{"} ...target {"}"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;for (const key in source) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;if (source[key] instanceof Object
                    &amp;&amp; key in target) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;result[key] =
                    deepMerge(target[key], source[key])
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"} else {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;result[key] =
                    source[key]
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"}
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"}</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return result
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>
    </MethodCard>

