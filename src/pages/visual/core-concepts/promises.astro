                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;)</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return Promise.race([promise, timeout])
                </div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// Clean usage anywhere:</span>
                </div>
                <div class="font-mono text-xs">
                    const user = await withTimeout(fetchUser(id), 3000)
                </div>
                <div class="font-mono text-xs">
                    const posts = await withTimeout(fetchPosts(), 5000)
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div>
                <strong
                    >Pattern 3: AbortController with fetch (modern)</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const controller = new AbortController()
                </div>
                <div class="font-mono text-xs">
                    const timeoutId = setTimeout(() =&gt; controller.abort(),
                    5000)
                </div>
                <div class="font-mono text-xs mt-1">try {"{"}</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const response = await fetch('/api/data', {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;signal: controller.signal <span
                        class="text-gray-400">// abort signal</span>
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"})</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;clearTimeout(timeoutId) <span
                        class="text-gray-400"
                        >// cancel timeout if successful</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return await response.json()
                </div>
                <div class="font-mono text-xs">{"}"} catch (err) {"{"}</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;if (err.name === 'AbortError') {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.error('Request timed out')
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"}</div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="text-xs mt-1 text-gray-400">
                    <Mark type="yes" /> Cancels the HTTP request, not only the wait
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div><Mark type="warn" /> <strong>Best practices:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">
                    <span class="text-green-400"><Mark type="yes" /></span> Use <code>AbortController</code> for <code>fetch</code> requests (it cancels the request)
                </div>
                <div class="text-xs">
                    <span class="text-green-400"><Mark type="yes" /></span> Clear the timeout when the operation finishes first
                </div>
                <div class="text-xs">
                    <span class="text-green-400"><Mark type="yes" /></span> Put the duration in timeout error messages
                </div>
                <div class="text-xs">
                    <span class="text-green-400"><Mark type="yes" /></span> Set reasonable timeouts
                    (API: 5-10s, DB: 30s)
                </div>
                <div class="text-xs">
                    <span class="text-yellow-400"></span> <code>Promise.race()</code> doesn't cancel the slow promise
                </div>
                <div class="text-xs">
                    <span class="text-red-400"><Mark type="no" /></span> Don't set timeouts so short that healthy requests fail
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- RETRY PATTERNS -->
    <MethodCard
        id="retry-patterns"
