        <ProTip>
            <div><strong>Pattern 2: reusable timeout wrapper</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    function withTimeout(promise, ms) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const timeout = new Promise((_, reject) =&gt;
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;setTimeout(() =&gt; reject(new
