---
import { stripLeadingEmoji } from "../../lib/strip-emoji";

interface Props {
    /**
     * The content of the info box. Can include HTML/JSX.
     */
}

const { } = Astro.props;
const html = stripLeadingEmoji(await Astro.slots.render("default"));
---
<div class="mt-3 px-3 py-2.5 bg-blue-900 text-sm leading-snug">
    <div class="text-ink space-y-1.5" set:html={html} />
</div>
