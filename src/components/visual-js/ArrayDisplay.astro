---
interface Props {
    values: (string | number)[];
    highlightIndices?: number[];
    highlightType?: 'added' | 'removed' | 'transformed';
}

const { values, highlightIndices = [], highlightType = 'added' } = Astro.props;

const highlightClasses = {
    added: 'bg-green-800 border-green-500 highlight-added',
    removed: 'bg-red-800 border-red-500 text-red-300 line-through',
    transformed: 'bg-orange-800 border-orange-500'
};
---

<div class="flex gap-1 justify-center flex-wrap pt-3">
    {values.map((value, index) => (
        <div class={`min-w-[40px] px-3 py-2 border-b-[3px] text-center font-mono font-semibold text-base relative ${
            highlightIndices.includes(index)
                ? highlightClasses[highlightType]
                : 'bg-gray-900 border-gray-600'
        }`}>
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 font-mono text-xs text-gray-400">
                {index}
            </div>
            {typeof value === 'string' ? `'${value}'` : value}
        </div>
    ))}
</div>
