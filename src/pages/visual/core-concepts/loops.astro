                >
                    <div class="text-blue-300 font-bold">
                        Loop completes normally
                    </div>
                </div>
            </div>
        </div>

        <MutableOrNot mutates={false} message="">
            Skips the rest of the current iteration and moves to the next. Cannot
            be used in <code
                >forEach()</code
            >.
        </MutableOrNot>

        <ProTip>
            <div>Common use case - skip unwanted items:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
