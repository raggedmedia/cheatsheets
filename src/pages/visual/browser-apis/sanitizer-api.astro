---
import Layout from "~layouts/VisualLayout.astro";
import MethodCard from "~components/visual-js/MethodCard.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import Mark from "~components/visual-js/Mark.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
---

<Layout pageTitle="setHTML() and Sanitizer API">
    <div class="max-w-5xl mx-auto">
        <p class="text-gray-400 mb-8">
            Modern XSS prevention - no more innerHTML vulnerabilities
        </p>

        <!-- ============================================ -->
        <!-- BROWSER SUPPORT -->
        <!-- ============================================ -->

        <section class="mb-8">
            <h3 class="font-semibold text-lg mb-1">Browser support status</h3>
            <dl class="text-sm divide-y divide-rule border-y border-rule">
                <div class="py-2 grid sm:grid-cols-[220px_1fr] gap-x-4">
                    <dt class="font-semibold text-immutable"><Mark type="yes" /> setHTMLUnsafe()</dt>
                    <dd>Supported in all modern browsers</dd>
                </div>
                <div class="py-2 grid sm:grid-cols-[220px_1fr] gap-x-4">
                    <dt class="font-semibold text-yellow-300"><Mark type="warn" /> Sanitizer API</dt>
                    <dd>Chrome and Edge 146+, Firefox 148+. Not in Safari yet.</dd>
                </div>
                <div class="py-2 grid sm:grid-cols-[220px_1fr] gap-x-4">
                    <dt class="font-semibold"><Mark type="yes" /> Trusted Types API</dt>
                    <dd>Supported in all modern browsers (Firefox 148+, Safari 26+)</dd>
                </div>
            </dl>
        </section>

        <!-- ============================================ -->
        <!-- setHTML() -->
        <!-- ============================================ -->

        <SectionTitle id="sethtml">
            setHTML() - safe HTML insertion
        </SectionTitle>

        <div id="sethtml-basics">
            <MethodCard
                methodName="element.setHTML()"
                signature="setHTML(htmlString, options?)"
                description="Inserts HTML and sanitises it to prevent XSS attacks"
                mutates={true}
            >
                <div class="space-y-3">
                    <!-- Basic usage -->
                    <div
                        class="bg-blue-900 p-4"
                    >
                        <div
                            class="text-blue-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2">
                                <Mark type="yes" /> Basic usage (auto-sanitized):
                            </div>
                            <div>
                                const div = document.querySelector('div');
                            </div>
                            <div>div.setHTML(html);</div>
                            <div></div>
                            <div class="text-gray-400">// Much safer than:</div>
                            <div class="text-red-300">
                                div.innerHTML = html; // <Mark type="warn" /> Dangerous!
                            </div>
                        </div>
                    </div>

                    <!-- What gets removed by default -->
                    <div
                        class="bg-red-900 p-4"
                    >
                        <div class="text-red-300 text-xs space-y-2">
                            <div class="text-yellow-400 mb-2">
                                <Mark type="no" /> Always removed (even with a custom sanitizer):
                            </div>
                            <div class="ml-4 space-y-1">
                                <div>
                                    • <code>&lt;script&gt;</code
                                    > tags
                                </div>
                                <div>
                                    • <code>&lt;iframe&gt;</code
                                    > tags
                                </div>
                                <div>
                                    • <code>&lt;embed&gt;</code
                                    >, <code>&lt;object&gt;</code
                                    >, <code>&lt;frame&gt;</code
                                    > tags
                                </div>
                                <div>
                                    • SVG <code>&lt;use&gt;</code
                                    > elements
                                </div>
                                <div>
                                    • Inline event handlers (onclick, onerror,
                                    etc.)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Example with malicious content -->
                    <div
                        class="bg-purple-900 p-4"
                    >
                        <div
                            class="text-purple-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Example - Malicious HTML gets sanitized:
                            </div>
                            <div>const html = `</div>
                            <div>
                                &nbsp;&nbsp;&lt;h1
                                onclick="console.log('hi')"&gt;testing&lt;/h1&gt;
                            </div>
                            <div>
                                &nbsp;&nbsp;&lt;button&gt;Click
                                me&lt;/button&gt;
                            </div>
                            <div>&nbsp;&nbsp;&lt;img src="cat.jpg"&gt;</div>
                            <div>
                                &nbsp;&nbsp;&lt;iframe
                                src="https://evil.com/"&gt;`;
                            </div>
                            <div></div>
                            <div>
                                const div = document.querySelector('div');
                            </div>
                            <div>div.setHTML(html);</div>
                            <div></div>
                            <div class="text-green-400">
                                // Result: Only &lt;h1&gt;testing&lt;/h1&gt;
                                remains!
                            </div>
                            <div class="text-gray-400">
                                // onclick, button, img, iframe all stripped
                            </div>
                        </div>
                    </div>

                    <!-- Default removes A LOT -->
                    <div
                        class="bg-orange-900 p-4"
                    >
                        <div class="text-orange-300 text-xs space-y-2">
                            <div class="text-yellow-400 mb-2">
                                <Mark type="warn" /> Default mode also removes (configurable):
                            </div>
                            <div class="ml-4 space-y-1">
                                <div>
                                    • <code>&lt;style&gt;</code
                                    >, <code>&lt;link&gt;</code
                                    >, <code>&lt;img&gt;</code
                                    >, <code>&lt;video&gt;</code>
                                </div>
                                <div>
                                    • <code>&lt;button&gt;</code
                                    >, <code>&lt;form&gt;</code
                                    >, <code>&lt;input&gt;</code
                                    >, <code>&lt;textarea&gt;</code>
                                </div>
                                <div>
                                    • <code>&lt;label&gt;</code
                                    >, <code>&lt;select&gt;</code
                                    >, <code>&lt;option&gt;</code
                                    >, <code>&lt;output&gt;</code>
                                </div>
                                <div>
                                    • <code>&lt;details&gt;</code
                                    >, <code>&lt;summary&gt;</code
                                    >, <code>&lt;template&gt;</code>
                                </div>
                                <div>
                                    • All custom elements (e.g. <code>&lt;my-component&gt;</code
                                    >)
                                </div>
                                <div>
                                    • <code>data-*</code
                                    > attributes, <code>aria-*</code
                                    > attributes
                                </div>
                                <div>
                                    • Inline <code>style</code
                                    > attributes
                                </div>
                                <div>• HTML comments</div>
                            </div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong>Use setHTML() by default.</strong> It is the modern,
                        safe alternative to innerHTML. It always blocks dangerous
                        elements. Safe elements need explicit configuration.
                    </div>
                </ProTip>
            </MethodCard>
        </div>

        <!-- ============================================ -->
        <!-- CUSTOM SANITIZER -->
        <!-- ============================================ -->

        <SectionTitle id="custom-sanitizer">
            Custom sanitizer configuration
        </SectionTitle>

        <div id="most-permissive">
            <MethodCard
                methodName="Most permissive config"
                signature="setHTML(html, {sanitizer: {}})"
                description="Allow everything except dangerous elements"
                mutates={true}
            >
                <div class="space-y-3">
                    <div
                        class="bg-green-900 p-4"
                    >
                        <div
                            class="text-green-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2">
                                Most permissive (but still safe):
                            </div>
                            <div>
                                div.setHTML(html, {`{`}sanitizer: {`{}`}{`}`});
                            </div>
                            <div></div>
                            <div class="text-gray-400">// Removes ONLY:</div>
                            <div class="text-red-300">
                                // • script, iframe, embed, object, frame, use
                            </div>
                            <div class="text-red-300">
                                // • Inline event handlers (onclick, etc.)
                            </div>
                            <div></div>
                            <div class="text-green-400">
                                // Keeps everything else including:
                            </div>
                            <div class="text-green-400">
                                // • img, video, style, button, form, etc.
                            </div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong>Use this for trusted content</strong> like rich
                        text editors where you control the input but want XSS protection.
                    </div>
                </ProTip>
            </MethodCard>
        </div>

        <div id="allowlist">
            <MethodCard
                methodName="Allowlist (whitelist) approach"
                signature="new Sanitizer({elements, attributes})"
                description="Lists what to allow and removes everything else"
                mutates={true}
            >
                <div class="space-y-3">
                    <!-- Basic allowlist -->
                    <div
                        class="bg-blue-900 p-4"
                    >
                        <div
                            class="text-blue-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Basic allowlist:
                            </div>
                            <div>const sanitizer = new Sanitizer({`{`}</div>
                            <div>
                                &nbsp;&nbsp;elements: ["h1", "p", "strong",
                                "em"],
                            </div>
                            <div>&nbsp;&nbsp;attributes: ["style"]</div>
                            <div>{`}`});</div>
                            <div></div>
                            <div>div.setHTML(html, {`{`}sanitizer{`}`});</div>
                            <div></div>
                            <div class="text-gray-400">
                                // Only h1, p, strong, em allowed
                            </div>
                            <div class="text-gray-400">
                                // Only style attribute allowed
                            </div>
                        </div>
                    </div>

                    <!-- Inline object -->
                    <div
                        class="bg-purple-900 p-4"
                    >
                        <div
                            class="text-purple-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Without creating Sanitizer object:
                            </div>
                            <div>div.setHTML(html, {`{`}</div>
                            <div>&nbsp;&nbsp;elements: ["h1", "h2", "p"],</div>
                            <div>
                                &nbsp;&nbsp;attributes: ["style", "class"]
                            </div>
                            <div>{`}`});</div>
                        </div>
                    </div>

                    <!-- Fine-grained control -->
                    <div
                        class="bg-green-900 p-4"
                    >
                        <div
                            class="text-green-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2">
                                Fine-grained control (per-element attributes):
                            </div>
                            <div>const sanitizer = new Sanitizer({`{`}</div>
                            <div>&nbsp;&nbsp;elements: [</div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;{`{`} name: "h1", attributes:
                                [] {`}`}, <span class="text-gray-400"
                                    >// h1 with NO attributes</span>
                            </div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;{`{`} name: "h2", attributes:
                                ["style"] {`}`}, <span class="text-gray-400"
                                    >// h2 with style only</span>
                            </div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;{`{`} name: "p", attributes:
                                ["class", "id"] {`}`}
                                <span class="text-gray-400"
                                    >// p with class & id</span>
                            </div>
                            <div>&nbsp;&nbsp;]</div>
                            <div>{`}`});</div>
                            <div></div>
                            <div>div.setHTML(html, {`{`}sanitizer{`}`});</div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong>An allowlist is the most secure.</strong> Use it for user-generated
                        content that needs strict control.
                    </div>
                </ProTip>
            </MethodCard>
        </div>

        <div id="blocklist">
            <MethodCard
                methodName="Blocklist (blacklist) approach"
                signature="new Sanitizer({removeElements, removeAttributes})"
                description="Lists elements and attributes to remove and allows everything else"
                mutates={true}
            >
                <div class="space-y-3">
                    <div
                        class="bg-orange-900 p-4"
                    >
                        <div
                            class="text-orange-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Blocklist approach:
                            </div>
                            <div>const sanitizer = new Sanitizer({`{`}</div>
                            <div>
                                &nbsp;&nbsp;removeElements: ["a", "img"], <span
                                    class="text-gray-400"
                                    >// Block links & images</span>
                            </div>
                            <div>
                                &nbsp;&nbsp;removeAttributes: ["id", "data-*"] <span
                                    class="text-gray-400"
                                    >// Block id & data attrs</span>
                            </div>
                            <div>{`}`});</div>
                            <div></div>
                            <div>div.setHTML(html, {`{`}sanitizer{`}`});</div>
                            <div></div>
                            <div class="text-gray-400">// Removes ONLY:</div>
                            <div class="text-gray-400">
                                // • a, img elements
                            </div>
                            <div class="text-gray-400">
                                // • id and data-* attributes
                            </div>
                            <div class="text-gray-400">
                                // • PLUS always-blocked: script, iframe, etc.
                            </div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong>A blocklist is less restrictive.</strong> Use it when
                        you trust the source but want to remove specific problem
                        elements.
                    </div>
                </ProTip>
            </MethodCard>
        </div>

        <!-- ============================================ -->
        <!-- TRUSTED TYPES -->
        <!-- ============================================ -->

        <SectionTitle id="trusted-types">
            Trusted Types API
        </SectionTitle>

        <div id="trusted-types-intro">
            <MethodCard
                methodName="Trusted Types"
                signature="Enforce sanitization at the framework level"
                description="Stops every developer from adding XSS vulnerabilities by accident"
                mutates={false}
            >
                <div class="space-y-3">
                    <!-- What is it -->
                    <div
                        class="bg-blue-900 p-4"
                    >
                        <div class="text-blue-300 text-xs space-y-2">
                            <div class="text-yellow-400 mb-2">
                                What is Trusted Types?
                            </div>
                            <div>
                                Trusted Types and the Sanitizer API <strong
                                    >complement each other:</strong>
                            </div>
                            <div class="ml-4 mt-2 space-y-1">
                                <div>
                                    • <strong>Sanitizer API:</strong> Provides a safe
                                    way to build DOM
                                </div>
                                <div>
                                    • <strong>Trusted Types:</strong> Makes sure
                                    only sanitised content is used
                                </div>
                            </div>
                            <div class="mt-2">
                                Result: no developer can bypass sanitisation
                                by accident.
                            </div>
                        </div>
                    </div>

                    <!-- Opt in via CSP -->
                    <div
                        class="bg-purple-900 p-4"
                    >
                        <div
                            class="text-purple-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Opt in via Content-Security-Policy header:
                            </div>
                            <div class="font-sans">Content-Security-Policy:</div>
                            <div>
                                &nbsp;&nbsp;trusted-types passthrough
                                legacysanitize;
                            </div>
                            <div>
                                &nbsp;&nbsp;require-trusted-types-for 'script';
                            </div>
                            <div></div>
                            <div class="text-gray-400">
                                // "passthrough" and "legacysanitize" are policy
                                names
                            </div>
                            <div class="text-gray-400">
                                // You can name them anything you want
                            </div>
                        </div>
                    </div>

                    <!-- What happens when enabled -->
                    <div
                        class="bg-red-900 p-4"
                    >
                        <div
                            class="text-red-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Now strings throw TypeError in unsafe sinks:
                            </div>
                            <div>
                                div.innerHTML = "&lt;h2&gt;Hello&lt;/h2&gt;"; <span
                                    class="text-red-400">// <Mark type="no" /> TypeError!</span>
                            </div>
                            <div></div>
                            <div>
                                div.setHTMLUnsafe(`&lt;iframe
                                src='evil.com'/&gt;`); <span
                                    class="text-red-400">// <Mark type="no" /> TypeError!</span>
                            </div>
                            <div></div>
                            <div class="text-green-400">
                                // But setHTML() still works fine with strings!
                            </div>
                            <div>
                                div.setHTML("&lt;h2&gt;Hello&lt;/h2&gt;"); <span
                                    class="text-green-400">// <Mark type="yes" /> Works!</span>
                            </div>
                        </div>
                    </div>

                    <!-- Unsafe sinks -->
                    <div
                        class="bg-orange-900 p-4"
                    >
                        <div class="text-orange-300 text-xs space-y-2">
                            <div class="text-yellow-400 mb-2">
                                <Mark type="warn" /> What are 'unsafe sinks'?
                            </div>
                            <div class="ml-4 space-y-1">
                                <div><strong>Modern:</strong></div>
                                <div>
                                    • <code>setHTMLUnsafe()</code>
                                </div>
                                <div>
                                    • <code>Document.parseHTMLUnsafe()</code>
                                </div>
                                <div class="mt-2"><strong>Legacy:</strong></div>
                                <div>
                                    • <code>innerHTML</code
                                    >, <code>outerHTML</code>
                                </div>
                                <div>
                                    • <code>parseFromString()</code>
                                </div>
                                <div>
                                    • <code>document.write()</code
                                    >, <code>document.writeln()</code>
                                </div>
                                <div>
                                    • Setting <code>iframe.srcdoc</code
                                    > via JS
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong>When to use Trusted Types:</strong> Production
                        apps with multiple developers. Enforces XSS protection at
                        the framework level - no one can bypass it.
                    </div>
                </ProTip>
            </MethodCard>
        </div>

        <div id="creating-policies">
            <MethodCard
                methodName="Creating a policy"
                signature="trustedTypes.createPolicy(name, {createHTML})"
                description="Defines how to sanitise strings"
                mutates={false}
            >
                <div class="space-y-3">
                    <!-- Passthrough policy (unsafe!) -->
                    <div
                        class="bg-red-900 p-4"
                    >
                        <div
                            class="text-red-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2">
                                <Mark type="warn" /> Passthrough policy (use sparingly!):
                            </div>
                            <div>
                                const passThrough =
                                trustedTypes.createPolicy("passthrough", {`{`}
                            </div>
                            <div>
                                &nbsp;&nbsp;createHTML: (input) =&gt; input <span
                                    class="text-gray-400"
                                    >// Returns unchanged</span>
                            </div>
                            <div>{`}`});</div>
                            <div></div>
                            <div>
                                const html = passThrough.createHTML(`&lt;iframe
                                src='evil.com'/&gt;`);
                            </div>
                            <div>
                                div.setHTMLUnsafe(html); <span
                                    class="text-green-400"
                                    >// <Mark type="yes" /> No error, but unsafe!</span>
                            </div>
                            <div></div>
                            <div class="text-red-400">
                                // Use ONLY for server-controlled HTML you trust
                            </div>
                        </div>
                    </div>

                    <!-- Real-world usage -->
                    <div
                        class="bg-green-900 p-4"
                    >
                        <div
                            class="text-green-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Real example: Fetching trusted server HTML:
                            </div>
                            <div>
                                const target =
                                document.getElementById('target');
                            </div>
                            <div></div>
                            <div>fetch('/trusted-content')</div>
                            <div>
                                &nbsp;&nbsp;.then(response =&gt;
                                response.text())
                            </div>
                            <div>&nbsp;&nbsp;.then((html) =&gt; {`{`}</div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;const trusted =
                                passThrough.createHTML(html);
                            </div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;target.setHTMLUnsafe(trusted);
                            </div>
                            <div>&nbsp;&nbsp;{`}`});</div>
                        </div>
                    </div>

                    <!-- With DOMPurify (production) -->
                    <div
                        class="bg-blue-900 p-4"
                    >
                        <div
                            class="text-blue-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                <Mark type="yes" /> Production: Use DOMPurify until Sanitizer API
                                ships:
                            </div>
                            <div>
                                window.trustedTypes.createPolicy('legacysanitize',
                                {`{`}
                            </div>
                            <div>&nbsp;&nbsp;createHTML: (input) =&gt;</div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;DOMPurify.sanitize(input,
                                {`{`}
                            </div>
                            <div>
                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;RETURN_TRUSTED_TYPE:
                                false
                            </div>
                            <div>&nbsp;&nbsp;&nbsp;&nbsp;{`}`})</div>
                            <div>{`}`});</div>
                            <div></div>
                            <div class="text-gray-400">
                                // RETURN_TRUSTED_TYPE: false is required
                            </div>
                            <div class="text-gray-400">
                                // createHTML expects a string, not TrustedHTML
                            </div>
                        </div>
                    </div>

                    <!-- Future with Sanitizer API -->
                    <div
                        class="bg-purple-900 p-4"
                    >
                        <div
                            class="text-purple-300 font-mono text-xs space-y-1"
                        >
                            <div class="text-yellow-400 mb-2 font-sans">
                                Future: Once Sanitizer API ships everywhere:
                            </div>
                            <div class="text-gray-400">
                                // Just use setHTML() directly!
                            </div>
                            <div>
                                div.setHTML(userContent); <span
                                    class="text-green-400"
                                    >// Auto-sanitized + Trusted Types compliant</span>
                            </div>
                            <div></div>
                            <div class="text-gray-400">
                                // No need for DOMPurify or createHTML
                                boilerplate
                            </div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong
                            >Until the Sanitizer API has wide support:</strong
                        > use DOMPurify in your Trusted Types policy. Then
                        switch to setHTML() for everything.
                    </div>
                </ProTip>
            </MethodCard>
        </div>

        <!-- ============================================ -->
        <!-- QUICK REFERENCE -->
        <!-- ============================================ -->

        <SectionTitle id="quick-ref">
            Quick reference
        </SectionTitle>

        <div id="best-practices">
            <MethodCard
                methodName="Best practices summary"
                signature="When to use what"
                description="Decision tree for XSS prevention"
                mutates={false}
            >
                <div class="space-y-3">
                    <!-- Decision tree -->
                    <div
                        class="bg-green-900 p-4"
                    >
                        <div class="text-green-300 text-xs space-y-3">
                            <div class="text-yellow-400 font-bold mb-2">
                                <Mark type="yes" /> Recommended approach (2025+):
                            </div>

                            <div class="border-t border-rule pt-3">
                                <div class="font-bold text-blue-400 mb-1">
                                    1. Use setHTML() by default
                                </div>
                                <div class="ml-4">
                                    Instead of innerHTML or setHTMLUnsafe()
                                </div>
                            </div>

                            <div class="border-t border-rule pt-3">
                                <div class="font-bold text-blue-400 mb-1">
                                    2. Use Document.parseHTML()
                                </div>
                                <div class="ml-4">
                                    Instead of parseFromString() or
                                    parseHTMLUnsafe()
                                </div>
                            </div>

                            <div class="border-t border-rule pt-3">
                                <div class="font-bold text-blue-400 mb-1">
                                    3. Configure sanitizer as needed
                                </div>
                                <div class="ml-4">
                                    <div>
                                        • Allowlist for user content (most
                                        secure)
                                    </div>
                                    <div>
                                        • <code
                                            class="px-1 py-0.5 rounded"
                                            >{`{sanitizer: {}}`}</code
                                        > for trusted content
                                    </div>
                                </div>
                            </div>

                            <div class="border-t border-rule pt-3">
                                <div class="font-bold text-blue-400 mb-1">
                                    4. Enable Trusted Types in production
                                </div>
                                <div class="ml-4">
                                    Via Content-Security-Policy header
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- When to use what -->
                    <div
                        class="bg-blue-900 p-4"
                    >
                        <div class="text-blue-300 text-xs space-y-2">
                            <div class="text-yellow-400 mb-2">
                                When to use what:
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="border-t border-rule pt-2">
                                    <div class="text-green-400 font-bold mb-1">
                                        setHTML()
                                    </div>
                                    <div class="text-xs">
                                        Default choice for inserting HTML safely
                                    </div>
                                </div>

                                <div class="border-t border-rule pt-2">
                                    <div class="text-yellow-400 font-bold mb-1">
                                        setHTMLUnsafe()
                                    </div>
                                    <div class="text-xs">
                                        Server-controlled HTML (with Trusted
                                        Types)
                                    </div>
                                </div>

                                <div class="border-t border-rule pt-2">
                                    <div class="text-red-400 font-bold mb-1">
                                        innerHTML
                                    </div>
                                    <div class="text-xs">
                                        <Mark type="no" /> Avoid. Use setHTML() instead
                                    </div>
                                </div>

                                <div class="border-t border-rule pt-2">
                                    <div class="text-purple-400 font-bold mb-1">
                                        Trusted Types
                                    </div>
                                    <div class="text-xs">
                                        Production apps with multiple devs
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Migration path -->
                    <div
                        class="bg-purple-900 p-4"
                    >
                        <div class="text-purple-300 text-xs space-y-2">
                            <div class="text-yellow-400 mb-2">
                                Migration path:
                            </div>
                            <div class="space-y-1">
                                <div>
                                    1. Replace <code>innerHTML</code
                                    > with <code>setHTML()</code>
                                </div>
                                <div>
                                    2. Test with different sanitizer configs
                                </div>
                                <div>
                                    3. Add Trusted Types CSP header (testing
                                    mode first)
                                </div>
                                <div>
                                    4. Fix any errors, create policies as needed
                                </div>
                                <div>
                                    5. Enable enforcement mode in production
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <ProTip>
                    <div>
                        <strong>Remember:</strong> setHTML() and Document.parseHTML()
                        are 'not' unsafe sinks. They work with strings even when Trusted
                        Types is enabled.
                    </div>
                </ProTip>
            </MethodCard>
