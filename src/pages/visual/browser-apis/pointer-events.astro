---
import '~styles/styles.css'
import MethodCard from '~components/visual-js/MethodCard.astro';
import Node from '~components/visual-js/Node.astro';
import Arrow from '~components/visual-js/Arrow.astro';
import ReturnValue from '~components/visual-js/ReturnValue.astro';
import ProcessContent from '~components/visual-js/ProcessContent.astro';
import InfoBox from '~components/visual-js/InfoBox.astro';
import ProTip from '~components/visual-js/ProTip.astro';
import SectionTitle from '~components/visual-js/SectionTitle.astro';
import VisualLayout from 'src/layouts/VisualLayout.astro';
import Flow from "~components/visual-js/Flow.astro";
import Mark from "~components/visual-js/Mark.astro";
---
<VisualLayout
    pageTitle="Pointer Events API"
>
    <ProTip>
        <div><strong>One API for all pointer input.</strong> Pointer Events unify mouse, touch, and stylus input.</div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="text-xs">Use Pointer Events instead of separate mouse and touch handlers:</div>
            <div class="font-mono text-xs mt-1"><span class="text-red-400">// <Mark type="no" /> Old way - need both</span></div>
            <div class="font-mono text-xs">el.addEventListener('mousedown', handleStart)</div>
            <div class="font-mono text-xs">el.addEventListener('touchstart', handleStart)</div>
            <div class="font-mono text-xs mt-1"><span class="text-green-400">// <Mark type="yes" /> New way - one handler</span></div>
            <div class="font-mono text-xs">el.addEventListener('pointerdown', handleStart)</div>
        </div>
    </ProTip>

    <ProTip>
        <div><strong>Why use Pointer Events?</strong></div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="text-xs"><Mark type="yes" /> Works for mouse, touch, and stylus with the same code</div>
            <div class="text-xs"><Mark type="yes" /> More information than mouse events (pressure, tilt, contact size)</div>
            <div class="text-xs"><Mark type="yes" /> Better than touch events (easier to use, more consistent)</div>
            <div class="text-xs"><Mark type="yes" /> Multi-touch support with unique pointer IDs</div>
            <div class="text-xs"><Mark type="yes" /> Supported in all modern browsers (2025)</div>
        </div>
    </ProTip>

    <!-- ============================================ -->
    <!-- POINTER EVENT TYPES -->
    <!-- ============================================ -->

    <SectionTitle id="event-types" color="blue">
        Pointer event types
    </SectionTitle>

    <!-- POINTERDOWN -->
    <MethodCard
        id="pointerdown"
        methodName="pointerdown"
        signature="element.addEventListener('pointerdown', handler)"
        description="Pointer is pressed down (mouse click, finger/stylus touch)"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm space-y-1">
                    <div>Mouse click</div>
                    <div>Touch screen</div>
                    <div>Stylus press</div>
                </div>
            </Node>

            <Arrow label="triggers" />

            <Node label="Event" type="process">
                <ProcessContent name="pointerdown" description="Pointer pressed" />
            </Node>

            <Arrow label="fires" />

            <Node label="Handler" type="output">
                <ReturnValue value="Event object" type="object" />
            </Node>
        </Flow>

        <ProTip>
            <div><strong>Basic usage:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">element.addEventListener('pointerdown', (e) =>{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;console.log('Pointer pressed!')</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;console.log('Type:', e.pointerType) <span class="text-gray-400">// "mouse", "touch", or "pen"</span></div>
                <div class="font-mono text-xs">&nbsp;&nbsp;console.log('ID:', e.pointerId) <span class="text-gray-400">// unique ID for this pointer</span></div>
                <div class="font-mono text-xs">{'}'})</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- POINTERMOVE -->
    <MethodCard
        id="pointermove"
        methodName="pointermove"
        signature="element.addEventListener('pointermove', handler)"
        description="Pointer moves (mouse move, finger/stylus drag)"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm">
                    Pointer moving
                </div>
            </Node>

            <Arrow label="triggers" />

            <Node label="Event" type="process">
                <ProcessContent name="pointermove" description="Fires continuously" />
            </Node>

            <Arrow label="provides" />

            <Node label="Data" type="output">
                <div class="text-center text-sm space-y-1">
                    <div class="text-gray-300">X, Y position</div>
                    <div class="text-gray-300">Pressure</div>
                    <div class="text-gray-300">Tilt (stylus)</div>
                </div>
            </Node>
        </Flow>

        <ProTip>
            <div><strong>Use for drawing apps:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">canvas.addEventListener('pointermove', (e) =>{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;if (e.buttons === 1){'{'} <span class="text-gray-400">// if primary button pressed</span></div>
                <div class="font-mono text-xs">&nbsp;&nbsp;&nbsp;&nbsp;drawLine(e.clientX, e.clientY, e.pressure)</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;}</div>
                <div class="font-mono text-xs">{'}'})</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- POINTERUP -->
    <MethodCard
        id="pointerup"
        methodName="pointerup"
        signature="element.addEventListener('pointerup', handler)"
        description="Pointer is released (mouse button up, finger/stylus lifted)"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm">
                    Pointer released
                </div>
            </Node>

            <Arrow label="triggers" />

            <Node label="Event" type="process">
                <ProcessContent name="pointerup" description="Pointer lifted" />
            </Node>
        </Flow>

        <ProTip>
            <div><strong>Complete interaction pattern:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">let isDragging = false</div>
                <div class="font-mono text-xs mt-1">el.addEventListener('pointerdown', () => isDragging = true)</div>
                <div class="font-mono text-xs">el.addEventListener('pointermove', (e) =>{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;if (isDragging){'{'} /* drag logic */ }</div>
                <div class="font-mono text-xs">{'}'})</div>
                <div class="font-mono text-xs">el.addEventListener('pointerup', () => isDragging = false)</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OTHER POINTER EVENTS -->
    <MethodCard
        id="other-events"
        methodName="Other Pointer Events"
        signature="Additional pointer event types"
        description="Complete set of pointer interactions"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Enter/Leave -->
                <div class="bg-purple-900 rounded p-3">
                    <div class="text-purple-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Hover events (don't bubble):</div>
                        <div><span class="text-purple-300"><code>pointerenter</code></span> - Pointer enters element boundary</div>
                        <div><span class="text-purple-300"><code>pointerleave</code></span> - Pointer leaves element boundary</div>
                        <div class="text-gray-400 mt-1">Use for hover effects, tooltips</div>
                    </div>
                </div>

                <!-- Over/Out -->
                <div class="bg-blue-900 rounded p-3">
                    <div class="text-blue-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Hover events (with bubbling):</div>
                        <div><span class="text-blue-300"><code>pointerover</code></span> - Pointer enters element or child (bubbles)</div>
                        <div><span class="text-blue-300"><code>pointerout</code></span> - Pointer leaves element or child (bubbles)</div>
                        <div class="text-gray-400 mt-1">Use when you need event delegation</div>
                    </div>
                </div>

                <!-- Cancel -->
                <div class="bg-red-900 rounded p-3">
                    <div class="text-red-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Interruption:</div>
                        <div><span class="text-red-300"><code>pointercancel</code></span> - Pointer interaction cancelled</div>
                        <div class="text-gray-400 mt-1">Fires when the browser or system interrupts the pointer (for example, a zoom or system gesture)</div>
                        <div class="text-yellow-400 mt-1">Handle it and clean up the drag state.</div>
                    </div>
                </div>

                <!-- Capture -->
                <div class="bg-green-900 rounded p-3">
                    <div class="text-green-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Pointer capture:</div>
                        <div><span class="text-green-300"><code>gotpointercapture</code></span> - Element captured pointer</div>
                        <div><span class="text-green-300"><code>lostpointercapture</code></span> - Element lost pointer capture</div>
                        <div class="text-gray-400 mt-1">Used with <code>setPointerCapture()</code> (see below)</div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><Mark type="warn" /> <strong>Always handle pointercancel:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">If you track pointer state (like dragging), always clean up on cancel:</div>
                <div class="font-mono text-xs mt-1">el.addEventListener('pointerup', endDrag)</div>
                <div class="font-mono text-xs">el.addEventListener('pointercancel', endDrag) <span class="text-gray-400">// same cleanup</span></div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- EVENT PROPERTIES -->
    <!-- ============================================ -->

    <SectionTitle id="event-properties" color="purple">
        Event properties
    </SectionTitle>

    <!-- BASIC PROPERTIES -->
    <MethodCard
        id="basic-properties"
        methodName="Basic event properties"
        signature="Information available in every pointer event"
        description="Essential data from pointer events"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Position -->
                <div class="bg-blue-900 rounded p-3">
                    <div class="text-blue-300 font-mono text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1 font-sans">Position:</div>
                        <div>event.clientX, event.clientY <span class="text-gray-400">// relative to viewport</span></div>
                        <div>event.pageX, event.pageY <span class="text-gray-400">// relative to document</span></div>
                        <div>event.screenX, event.screenY <span class="text-gray-400">// relative to screen</span></div>
                        <div>event.offsetX, event.offsetY <span class="text-gray-400">// relative to target element</span></div>
                    </div>
                </div>

                <!-- Pointer identification -->
                <div class="bg-green-900 rounded p-3">
                    <div class="text-green-300 font-mono text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1 font-sans">Identification:</div>
                        <div>event.pointerId <span class="text-gray-400">// unique ID for this pointer</span></div>
                        <div>event.pointerType <span class="text-gray-400">// "mouse", "touch", or "pen"</span></div>
                        <div>event.isPrimary <span class="text-gray-400">// true for primary pointer (first touch)</span></div>
                    </div>
                </div>

                <!-- Button state -->
                <div class="bg-purple-900 rounded p-3">
                    <div class="text-purple-300 font-mono text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1 font-sans">Button state:</div>
                        <div>event.button <span class="text-gray-400">// which button (0=left, 1=middle, 2=right)</span></div>
                        <div>event.buttons <span class="text-gray-400">// bitmask of all pressed buttons</span></div>
                        <div class="mt-1">event.buttons === 1 <span class="text-gray-400">// primary (left) button pressed</span></div>
                        <div>event.buttons === 2 <span class="text-gray-400">// secondary (right) button pressed</span></div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Position cheat sheet:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs"><span class="text-green-400"><code>clientX/Y</code>:</span> Position in viewport (most common)</div>
                <div class="text-xs"><span class="text-blue-400"><code>pageX/Y</code>:</span> Position in document (includes scroll)</div>
                <div class="text-xs"><span class="text-purple-400"><code>offsetX/Y</code>:</span> Position within target element</div>
                <div class="text-xs"><span class="text-orange-400"><code>screenX/Y</code>:</span> Position on physical screen (rarely used)</div>
            </div>
        </ProTip>

        <ProTip>
            <div><strong>Multi-touch with pointerId:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">const activePointers = new Map()</div>
                <div class="font-mono text-xs mt-1">el.addEventListener('pointerdown', (e) =>{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;activePointers.set(e.pointerId,{'{'} x: e.clientX, y: e.clientY {'}'})</div>
                <div class="font-mono text-xs">{'}'})</div>
                <div class="font-mono text-xs mt-1">el.addEventListener('pointerup', (e) =>{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;activePointers.delete(e.pointerId)</div>
                <div class="font-mono text-xs">{'}'})</div>
                <div class="text-xs text-gray-400 mt-1">This tracks several touches at the same time.</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ADVANCED PROPERTIES -->
    <MethodCard
        id="advanced-properties"
        methodName="Advanced properties (touch & stylus)"
        signature="Extra data for touch and stylus input"
        description="Pressure, tilt, and contact geometry"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Pressure -->
                <div class="bg-orange-900 rounded p-3">
                    <div class="text-orange-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Pressure:</div>
                        <div><code>event.pressure <span class="text-gray-400">// 0.0 to 1.0 (0 to max pressure)</span></code></div>
                        <div class="mt-1 text-gray-400">Mouse: always 0 or 0.5</div>
                        <div class="text-gray-400">Touch: varies by device (often just 0 or 0.5)</div>
                        <div class="text-gray-400">Stylus: full range based on pen pressure </div>
                    </div>
                </div>

                <!-- Tilt -->
                <div class="bg-cyan-900 rounded p-3">
                    <div class="text-cyan-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Tilt (stylus only):</div>
                        <div><code>event.tiltX <span class="text-gray-400">// angle from Y-Z plane (-90 to 90 degrees)</span></code></div>
                        <div><code>event.tiltY <span class="text-gray-400">// angle from X-Z plane (-90 to 90 degrees)</span></code></div>
                        <div class="mt-1 text-gray-400">0 = perpendicular to surface</div>
                        <div class="text-gray-400">Useful for realistic drawing and painting apps</div>
                    </div>
                </div>

                <!-- Contact geometry -->
                <div class="bg-pink-900 rounded p-3">
                    <div class="text-pink-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Contact area (touch/stylus):</div>
                        <div><code>event.width <span class="text-gray-400">// contact width in CSS pixels</span></code></div>
                        <div><code>event.height <span class="text-gray-400">// contact height in CSS pixels</span></code></div>
                        <div class="mt-1 text-gray-400">Mouse: usually 1x1</div>
                        <div class="text-gray-400">Touch: varies by finger size</div>
                    </div>
                </div>

                <!-- Twist -->
                <div class="bg-purple-900 rounded p-3">
                    <div class="text-purple-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Rotation (stylus with rotation support):</div>
                        <div><code>event.twist <span class="text-gray-400">// 0 to 359 degrees clockwise</span></code></div>
                        <div class="mt-1 text-gray-400">Rare. Only styluses with a rotation sensor report it.</div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Pressure-sensitive drawing:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">canvas.addEventListener('pointermove', (e) =>{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;if (e.buttons === 1){'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;&nbsp;&nbsp;const brushSize = e.pressure * 10 <span class="text-gray-400">// 0-10 pixels</span></div>
                <div class="font-mono text-xs">&nbsp;&nbsp;&nbsp;&nbsp;const opacity = e.pressure <span class="text-gray-400">// 0-1</span></div>
                <div class="font-mono text-xs">&nbsp;&nbsp;&nbsp;&nbsp;drawBrushStroke(e.clientX, e.clientY, brushSize, opacity)</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;}</div>
                <div class="font-mono text-xs">{'}'})</div>
            </div>
        </ProTip>

        <ProTip>
            <div><Mark type="warn" /> <strong>Feature detection:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">Some devices do not support every feature. Check before you use one:</div>
                <div class="font-mono text-xs mt-1">if (e.pointerType === 'pen'){'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Pen: pressure is likely real (mouse reports 0.5)</div>
                <div class="font-mono text-xs">}</div>
                <div class="font-mono text-xs mt-1">if (e.pointerType === 'pen' && e.tiltX !== 0){'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Stylus with tilt support</div>
                <div class="font-mono text-xs">}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- POINTER CAPTURE -->
    <!-- ============================================ -->

    <SectionTitle id="pointer-capture" color="green">
        Pointer capture
    </SectionTitle>

    <!-- SETPOINTERCAPTURE -->
    <MethodCard
        id="set-pointer-capture"
        methodName="setPointerCapture() & releasePointerCapture()"
        signature="element.setPointerCapture(pointerId)"
        description="Send all pointer events to one element"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-4">
                <!-- What it does -->
                <div class="bg-green-900 rounded p-3">
                    <div class="text-green-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">What is pointer capture?</div>
                        <div class="text-xs text-gray-300">After you capture a pointer, all its events go to that element,</div>
                        <div class="text-xs text-gray-300">even if the pointer moves outside the element's boundaries.</div>
                        <div class="text-xs mt-1 text-yellow-400">Use it for drag operations.</div>
                    </div>
                </div>

                <!-- Example -->
                <div class="bg-cyan-900 rounded p-3">
                    <div class="text-cyan-300 font-mono text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1 font-sans">Typical drag implementation:</div>
                        <div>element.addEventListener('pointerdown', (e) =>{'{'}</div>
                        <div>&nbsp;&nbsp;element.setPointerCapture(e.pointerId)</div>
                        <div>&nbsp;&nbsp;isDragging = true</div>
                        <div>{'}'})</div>
                        <div class="mt-1">element.addEventListener('pointermove', (e) =>{'{'}</div>
                        <div>&nbsp;&nbsp;if (isDragging){'{'}</div>
                        <div>&nbsp;&nbsp;&nbsp;&nbsp;// Update position - works even outside element!</div>
                        <div>&nbsp;&nbsp;&nbsp;&nbsp;element.style.left = e.clientX + 'px'</div>
                        <div>&nbsp;&nbsp;&nbsp;&nbsp;element.style.top = e.clientY + 'px'</div>
                        <div>&nbsp;&nbsp;}</div>
                        <div>{'}'})</div>
                        <div class="mt-1">element.addEventListener('pointerup', (e) =>{'{'}</div>
                        <div>&nbsp;&nbsp;element.releasePointerCapture(e.pointerId)</div>
                        <div>&nbsp;&nbsp;isDragging = false</div>
                        <div>{'}'})</div>
                    </div>
                </div>

                <!-- Auto release -->
                <div class="bg-purple-900 rounded p-3">
                    <div class="text-purple-300 text-xs space-y-0.5">
                        <div class="text-yellow-400 mb-1">Automatic release:</div>
                        <div>The browser releases pointer capture on <span class="text-orange-400"><code>pointerup</code></span></div>
                        <div>and <span class="text-orange-400"><code>pointercancel</code></span> events.</div>
                        <div class="mt-1 text-gray-400">To release it earlier, call <code>releasePointerCapture()</code>.</div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Why use pointer capture?</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs"><span class="text-green-400"><Mark type="yes" /> Without capture:</span> If the mouse moves fast, it leaves the element and events stop</div>
                <div class="text-xs"><span class="text-green-400"><Mark type="yes" /> With capture:</span> The element gets all events until release</div>
                <div class="text-xs mt-1">Use it for:</div>
                <div class="text-xs">• Drag and drop</div>
                <div class="text-xs">• Sliders and range inputs</div>
                <div class="text-xs">• Resizable panels</div>
                <div class="text-xs">• Drawing and painting apps</div>
            </div>
        </ProTip>

        <ProTip>
            <div><Mark type="warn" /> <strong>Always capture on pointerdown, release on pointerup:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs"><span class="text-red-400">// <Mark type="no" /> Bad - might not release</span></div>
                <div class="font-mono text-xs">el.setPointerCapture(e.pointerId)</div>
                <div class="font-mono text-xs">// ... forget to release</div>
                <div class="font-mono text-xs mt-1"><span class="text-green-400">// <Mark type="yes" /> Good - always paired</span></div>
                <div class="font-mono text-xs">el.addEventListener('pointerdown', (e) => el.setPointerCapture(e.pointerId))</div>
                <div class="font-mono text-xs">el.addEventListener('pointerup', (e) => el.releasePointerCapture(e.pointerId))</div>
                <div class="font-mono text-xs">el.addEventListener('pointercancel', (e) => el.releasePointerCapture(e.pointerId))</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- PRACTICAL EXAMPLES -->
    <!-- ============================================ -->

    <SectionTitle id="examples" color="orange">
        Practical examples
    </SectionTitle>

    <!-- DRAGGABLE ELEMENT -->
    <MethodCard
        id="draggable-example"
        methodName="Complete draggable element"
        signature="Real-world drag implementation"
        description="Drag any element around the screen"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="bg-orange-900 rounded p-3">
                <div class="text-orange-300 font-mono text-xs space-y-0.5">
                    <div class="text-yellow-400 mb-2">// Make any element draggable</div>
                    <div>const box = document.querySelector('.draggable')</div>
                    <div>let isDragging = false</div>
                    <div>let startX, startY, initialLeft, initialTop</div>
                    <div class="mt-2">box.addEventListener('pointerdown', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;isDragging = true</div>
                    <div>&nbsp;&nbsp;box.setPointerCapture(e.pointerId)</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;// Save starting positions</div>
                    <div>&nbsp;&nbsp;startX = e.clientX</div>
                    <div>&nbsp;&nbsp;startY = e.clientY</div>
                    <div>&nbsp;&nbsp;initialLeft = box.offsetLeft</div>
                    <div>&nbsp;&nbsp;initialTop = box.offsetTop</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;// Visual feedback</div>
                    <div>&nbsp;&nbsp;box.style.cursor = 'grabbing'</div>
                    <div>{'}'})</div>
                    <div class="mt-2">box.addEventListener('pointermove', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;if (!isDragging) return</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;// Calculate how far pointer moved</div>
                    <div>&nbsp;&nbsp;const deltaX = e.clientX - startX</div>
                    <div>&nbsp;&nbsp;const deltaY = e.clientY - startY</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;// Update position</div>
                    <div>&nbsp;&nbsp;box.style.left = (initialLeft + deltaX) + 'px'</div>
                    <div>&nbsp;&nbsp;box.style.top = (initialTop + deltaY) + 'px'</div>
                    <div>{'}'})</div>
                    <div class="mt-2">box.addEventListener('pointerup', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;if (!isDragging) return</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;isDragging = false</div>
                    <div>&nbsp;&nbsp;box.releasePointerCapture(e.pointerId)</div>
                    <div>&nbsp;&nbsp;box.style.cursor = 'grab'</div>
                    <div>{'}'})</div>
                    <div class="mt-2">// Handle cancel (important!)</div>
                    <div>box.addEventListener('pointercancel', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;isDragging = false</div>
                    <div>&nbsp;&nbsp;box.releasePointerCapture(e.pointerId)</div>
                    <div>&nbsp;&nbsp;box.style.cursor = 'grab'</div>
                    <div>{'}'})</div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>CSS needed:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">.draggable{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;position: absolute;</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;cursor: grab;</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;touch-action: none; <span class="text-gray-400">/* Prevent scrolling on touch */</span></div>
                <div class="font-mono text-xs">}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- DRAWING APP -->
    <MethodCard
        id="drawing-example"
        methodName="Pressure-sensitive drawing"
        signature="Canvas drawing with pressure support"
        description="Draw with variable line thickness based on pressure"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="bg-cyan-900 rounded p-3">
                <div class="text-cyan-300 font-mono text-xs space-y-0.5">
                    <div class="text-yellow-400 mb-2">// Pressure-sensitive drawing on canvas</div>
                    <div>const canvas = document.querySelector('canvas')</div>
                    <div>const ctx = canvas.getContext('2d')</div>
                    <div>let isDrawing = false</div>
                    <div>let lastX, lastY</div>
                    <div class="mt-2">canvas.addEventListener('pointerdown', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;isDrawing = true</div>
                    <div>&nbsp;&nbsp;canvas.setPointerCapture(e.pointerId)</div>
                    <div>&nbsp;&nbsp;lastX = e.offsetX</div>
                    <div>&nbsp;&nbsp;lastY = e.offsetY</div>
                    <div>{'}'})</div>
                    <div class="mt-2">canvas.addEventListener('pointermove', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;if (!isDrawing) return</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;// Pressure affects line width (0-10 pixels)</div>
                    <div>&nbsp;&nbsp;const pressure = e.pressure || 0.5 <span class="text-gray-400">// fallback for mouse</span></div>
                    <div>&nbsp;&nbsp;const lineWidth = pressure * 10</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;// Draw line</div>
                    <div>&nbsp;&nbsp;ctx.beginPath()</div>
                    <div>&nbsp;&nbsp;ctx.moveTo(lastX, lastY)</div>
                    <div>&nbsp;&nbsp;ctx.lineTo(e.offsetX, e.offsetY)</div>
                    <div>&nbsp;&nbsp;ctx.lineWidth = lineWidth</div>
                    <div>&nbsp;&nbsp;ctx.lineCap = 'round'</div>
                    <div>&nbsp;&nbsp;ctx.stroke()</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;lastX = e.offsetX</div>
                    <div>&nbsp;&nbsp;lastY = e.offsetY</div>
                    <div>{'}'})</div>
                    <div class="mt-2">canvas.addEventListener('pointerup', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;isDrawing = false</div>
                    <div>&nbsp;&nbsp;canvas.releasePointerCapture(e.pointerId)</div>
                    <div>{'}'})</div>
                    <div class="mt-2">canvas.addEventListener('pointercancel', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;isDrawing = false</div>
                    <div>&nbsp;&nbsp;canvas.releasePointerCapture(e.pointerId)</div>
                    <div>{'}'})</div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Enhanced with pointerType:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">// Different behavior for different input types</div>
                <div class="font-mono text-xs">if (e.pointerType === 'pen'){'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Full pressure sensitivity for stylus</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;lineWidth = e.pressure * 10</div>
                <div class="font-mono text-xs">} else if (e.pointerType === 'touch'){'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Medium size for finger</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;lineWidth = 5</div>
                <div class="font-mono text-xs">} else{'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Thin line for mouse</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;lineWidth = 2</div>
                <div class="font-mono text-xs">}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MULTI-TOUCH -->
    <MethodCard
        id="multitouch-example"
        methodName="Multi-touch tracking"
        signature="Handle multiple simultaneous touches"
        description="Track multiple fingers/pointers at once"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="bg-purple-900 rounded p-3">
                <div class="text-purple-300 font-mono text-xs space-y-0.5">
                    <div class="text-yellow-400 mb-2">// Track multiple touches (pinch zoom, multi-finger gestures)</div>
                    <div>const activePointers = new Map()</div>
                    <div class="mt-2">element.addEventListener('pointerdown', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;activePointers.set(e.pointerId,{'{'}</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;x: e.clientX,</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;y: e.clientY,</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;type: e.pointerType</div>
                    <div>&nbsp;&nbsp;{'}'})</div>
                    <div>&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;console.log(`Active pointers: ${'{'}activePointers.size{'}'}`)</div>
                    <div>{'}'})</div>
                    <div class="mt-2">element.addEventListener('pointermove', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;if (activePointers.has(e.pointerId)){'{'}</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;// Update pointer position</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;activePointers.set(e.pointerId,{'{'}</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;x: e.clientX,</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;y: e.clientY,</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;type: e.pointerType</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;{'}'})</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;// Detect multi-touch gestures</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;if (activePointers.size === 2){'{'}</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// Could calculate pinch distance here</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;console.log('Two-finger gesture!')</div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;}</div>
                    <div>&nbsp;&nbsp;}</div>
                    <div>{'}'})</div>
                    <div class="mt-2">element.addEventListener('pointerup', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;activePointers.delete(e.pointerId)</div>
                    <div>{'}'})</div>
                    <div class="mt-2">element.addEventListener('pointercancel', (e) =>{'{'}</div>
                    <div>&nbsp;&nbsp;activePointers.delete(e.pointerId)</div>
                    <div>{'}'})</div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Pinch-to-zoom calculation:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">if (activePointers.size === 2){'{'}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;const [p1, p2] = [...activePointers.values()]</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Calculate distance between two pointers</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;const dx = p2.x - p1.x</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;const dy = p2.y - p1.y</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;const distance = Math.sqrt(dx * dx + dy * dy)</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;// Compare to initial distance to determine zoom</div>
                <div class="font-mono text-xs">}</div>
            </div>
        </ProTip>
    </MethodCard>

