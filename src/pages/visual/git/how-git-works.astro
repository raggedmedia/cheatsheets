---
import "~styles/styles.css";
import InfoBox from "~components/visual-js/InfoBox.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="How Git actually works">
    <ProTip>
        <div><strong>Git is simpler than you think</strong></div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="text-xs">
                Git's odd command names hide a simple system.
            </div>
            <div class="text-xs">
                Learn the <strong>three core concepts</strong> and the rest
                makes sense.
            </div>
        </div>
    </ProTip>

    <!-- ============================================ -->
    <!-- CONTENT-ADDRESSED STORAGE -->
    <!-- ============================================ -->

    <SectionTitle id="content-addressed" color="blue">
        Content-addressed storage
    </SectionTitle>

    <div class="space-y-4 mb-8">
        <!-- Traditional vs Git Storage -->
        <div class="p-6 rounded">
            <div class="text-lg font-bold text-blue-300 mb-4">
                The filing cabinet analogy
            </div>

            <!-- Traditional Filing -->
            <div class="mb-6">
                <div class="text-sm font-semibold text-gray-300 mb-2">
                    <Mark type="no" /> Traditional filing (by name):
                </div>
                <div class="flex gap-3 items-center">
                    <div
                        class="bg-red-900 rounded-lg p-3 flex-1"
                    >
                        <div class="font-mono text-xs text-red-300 mb-1">
                            README.md
                        </div>
                        <div class="text-xs text-gray-400">
                            Content: "Hello World"
                        </div>
                    </div>
                    <div
                        class="bg-red-900 rounded-lg p-3 flex-1"
                    >
                        <div class="font-mono text-xs text-red-300 mb-1">
                            README.md (copy)
                        </div>
                        <div class="text-xs text-gray-400">
                            Content: "Hello World"
                        </div>
                    </div>
                    <div class="text-xs text-gray-400">
                        ← Same content, stored twice
                    </div>
                </div>
            </div>

            <!-- Git Filing -->
            <div>
                <div class="text-sm font-semibold text-green-300 mb-2">
                    <Mark type="yes" /> Git filing (by content fingerprint):
                </div>
                <div class="flex gap-3 items-center">
                    <div
                        class="bg-green-900 rounded-lg p-3 flex-1"
                    >
                        <div class="font-mono text-xs text-green-300 mb-1">
                            5e1c309d...
                        </div>
                        <div class="text-xs text-gray-400">
                            Content: "Hello World"
                        </div>
                    </div>
                    <div class="flex flex-col gap-1 flex-1">
                        <div class="font-mono text-xs text-yellow-400">
                            README.md → 5e1c309d...
                        </div>
                        <div class="font-mono text-xs text-yellow-400">
                            README-copy.md → 5e1c309d...
                        </div>
                    </div>
                    <div class="text-xs text-gray-400">
                        ← Both names point to one hash, stored once
                    </div>
                </div>
            </div>
        </div>

        <InfoBox>
            <div><strong>What's a hash/fingerprint?</strong></div>
            <div class="pl-2 border-l border-rule space-y-1 mt-1">
                <div class="text-xs">
                    Git runs your file through the SHA-1 algorithm and gets a
                    unique 40-character ID.
                </div>
                <div class="text-xs">
                    Same content, same hash <span class="text-green-400"
                        >(deterministic)</span
                    >.
                </div>
                <div class="text-xs">
                    Change 1 byte and the hash is completely different.
                </div>
                <div class="text-xs mt-2">
                    <span class="text-gray-400">Example:</span>
                </div>
                <div class="font-mono text-xs">
                    "Hello World" → 5e1c309dae7f45e0f39b1bf3ac3cd9db12e7d689
                </div>
                <div class="font-mono text-xs">
                    "Hello World!" → c57eff55ebc0c54973903af5f72bac72762cf4f4 <span
                        class="text-yellow-400">(one char change!)</span
                    >
                </div>
            </div>
        </InfoBox>

        <ProTip>
            <div><strong>Why this matters:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">
                    <Mark type="yes" /> Duplicate files use no extra storage
                    (automatic deduplication).
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Git compares two hashes to know at once
                    if two files are identical.
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Git detects corrupt data, because the
                    hash no longer matches.
                </div>
                <div class="text-xs">
                    <Mark type="no" /> You see hashes everywhere (those odd
                    '5e1c309d' strings).
                </div>
            </div>
        </ProTip>
    </div>

    <!-- ============================================ -->
    <!-- SNAPSHOTS NOT DIFFS -->
    <!-- ============================================ -->

    <SectionTitle id="snapshots" color="purple">
        Snapshots, not diffs
    </SectionTitle>

    <div class="space-y-4 mb-8">
        <!-- SVN vs Git -->
        <div class="p-6 rounded">
            <div class="text-lg font-bold text-purple-300 mb-4">
                The photo album vs. change log
            </div>

            <!-- SVN/Other VCS -->
            <div class="mb-6">
                <div class="text-sm font-semibold text-red-300 mb-3">
                    <Mark type="no" /> Most version control systems (SVN, perforce):
                </div>
                <div class="bg-red-900 rounded p-4">
                    <div class="text-xs space-y-1">
                        <div><strong>v1:</strong> Store the full file</div>
                        <div>
                            <strong>v2:</strong> +2 lines, -1 line <span
                                class="text-gray-400">(only the changes)</span
                            >
                        </div>
                        <div>
                            <strong>v3:</strong> +5 lines, -3 lines <span
                                class="text-gray-400">(only the changes)</span
                            >
                        </div>
                        <div class="text-xs text-yellow-400 mt-2">
                            To see v3, you replay v1, then the v2 and v3
                            changes. This is slow.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Git Snapshots -->
            <div>
                <div class="text-sm font-semibold text-green-300 mb-3">
                    <Mark type="yes" /> Git (snapshots):
                </div>
                <div
                    class="bg-green-900 rounded p-4"
                >
                    <div class="text-xs space-y-1">
                        <div>
                            <strong>Commit 1:</strong> Full snapshot of entire project
                            <span class="text-gray-400"
                                >(README.md, index.js, style.css)</span
                            >
                        </div>
                        <div>
                            <strong>Commit 2:</strong> Full snapshot of entire project
                            <span class="text-gray-400"
                                >(README.md, index.js, style.css)</span
                            >
                        </div>
                        <div>
                            <strong>Commit 3:</strong> Full snapshot of entire project
                            <span class="text-gray-400"
                                >(README.md, index.js, style.css)</span
                            >
                        </div>
                        <div class="text-xs text-green-400 mt-2">
                            Each commit is a complete picture. You can jump to
                            any version at once.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4 rounded">
            <div class="text-sm font-bold text-purple-300 mb-3">
                Visual representation:
            </div>
            <div class="flex gap-6 items-center">
                <!-- Commit 1 -->
                <div class="flex-1">
                    <div
                        class="bg-purple-900 rounded-lg p-3"
                    >
                        <div
                            class="text-center font-bold text-purple-300 text-xs mb-2"
                        >
                            Commit abc123
                        </div>
                        <div
                            class="rounded p-2 font-mono text-xs space-y-0.5"
                        >
                            <div>README.md</div>
                            <div>index.js</div>
                            <div>style.css</div>
                        </div>
                        <div class="text-center text-xs text-gray-400 mt-1">
                            Complete snapshot
                        </div>
                    </div>
                </div>

                <div class="text-2xl text-gray-500">→</div>

                <!-- Commit 2 -->
                <div class="flex-1">
                    <div
                        class="bg-purple-900 rounded-lg p-3"
                    >
                        <div
                            class="text-center font-bold text-purple-300 text-xs mb-2"
                        >
                            Commit def456
                        </div>
                        <div
                            class="rounded p-2 font-mono text-xs space-y-0.5"
                        >
                            <div>README.md</div>
                            <div class="text-yellow-400">
                                index.js (edited)
                            </div>
                            <div>style.css</div>
                        </div>
                        <div class="text-center text-xs text-gray-400 mt-1">
                            Complete snapshot
                        </div>
                    </div>
                </div>

                <div class="text-2xl text-gray-500">→</div>

                <!-- Commit 3 -->
                <div class="flex-1">
                    <div
                        class="bg-purple-900 rounded-lg p-3"
                    >
                        <div
                            class="text-center font-bold text-purple-300 text-xs mb-2"
                        >
                            Commit ghi789
                        </div>
                        <div
                            class="rounded p-2 font-mono text-xs space-y-0.5"
                        >
                            <div class="text-yellow-400">
                                README.md (edited)
                            </div>
                            <div>index.js</div>
                            <div>style.css</div>
                        </div>
                        <div class="text-center text-xs text-gray-400 mt-1">
                            Complete snapshot
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <InfoBox>
            <div><strong>Wait, doesn't that waste a lot of space?</strong></div>
            <div class="pl-2 border-l border-rule space-y-1 mt-1">
                <div class="text-xs">
                    No. Remember content-addressed storage?
                </div>
                <div class="text-xs mt-1">
                    If <code>index.js</code> did not change between commits:
                </div>
                <div class="text-xs">
                    → same content, same hash, stored once.
                </div>
                <div class="text-xs mt-1">
                    Each commit points to the same hash for unchanged files.
                </div>
                <div class="text-xs">
                    Only <span class="text-yellow-400">new or changed</span> files
                    take up space.
                </div>
            </div>
        </InfoBox>

        <ProTip>
            <div><strong>Why snapshots help:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">
                    <Mark type="yes" /> Checking out any commit is instant (no
                    changes to replay).
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Branches are cheap (they point to
                    different snapshots).
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Git is fast, even with a long history.
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Every commit is a complete, valid state of
                    your project.
                </div>
                <div class="text-xs mt-1">
                    <span class="text-gray-400"
                        >Note: Git still shows you diffs. It does not store them
                        that way.</span
                    >
                </div>
            </div>
        </ProTip>
    </div>

    <!-- ============================================ -->
    <!-- THE GRAPH (DAG) -->
    <!-- ============================================ -->

    <SectionTitle id="graph" color="cyan">
        The graph (history that never loops)
    </SectionTitle>

    <div class="space-y-4 mb-8">
        <div class="p-6 rounded">
            <div class="text-lg font-bold text-cyan-300 mb-4">
                Your history is a graph, not a line
            </div>

            <!-- Linear History (simple) -->
            <div class="mb-6">
                <div class="text-sm font-semibold text-gray-300 mb-3">
                    Simple case (no branches):
                </div>
                <div class="flex gap-3 items-center justify-center">
                    <div
                        class="bg-cyan-900 rounded-lg p-3 text-center"
                    >
                        <div class="font-mono text-xs text-cyan-300">A</div>
                        <div class="text-xs text-gray-400">
                            Initial commit
                        </div>
                    </div>
                    <div class="text-xl text-cyan-400">→</div>
                    <div
                        class="bg-cyan-900 rounded-lg p-3 text-center"
                    >
                        <div class="font-mono text-xs text-cyan-300">B</div>
                        <div class="text-xs text-gray-400">Add feature</div>
                    </div>
                    <div class="text-xl text-cyan-400">→</div>
                    <div
                        class="bg-cyan-900 rounded-lg p-3 text-center"
                    >
                        <div class="font-mono text-xs text-cyan-300">C</div>
                        <div class="text-xs text-gray-400">Fix bug</div>
                    </div>
                </div>
                <div class="text-center text-xs text-gray-400 mt-2">
                    Each commit points to its parent (the one before it)
                </div>
            </div>

            <!-- Branching History -->
            <div class="mb-6">
                <div class="text-sm font-semibold text-gray-300 mb-3">
                    With branches (where it gets interesting):
                </div>
                <div class="relative p-4">
                    <!-- ASCII-style diagram -->
                    <div class="font-mono text-xs space-y-1">
                        <div class="flex items-center">
                            <div
                                class="bg-cyan-900 rounded px-2 py-1"
                            >
                                A
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-cyan-900 rounded px-2 py-1"
                            >
                                B
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-cyan-900 rounded px-2 py-1"
                            >
                                C
                            </div>
                            <div class="mx-2 text-gray-500">← main branch</div>
                        </div>
                        <div class="flex items-center pl-24">
                            <div class="text-gray-500">↓</div>
                        </div>
                        <div class="flex items-center pl-24">
                            <div
                                class="bg-green-900 rounded px-2 py-1"
                            >
                                D
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-green-900 rounded px-2 py-1"
                            >
                                E
                            </div>
                            <div class="mx-2 text-gray-500">
                                ← feature branch
                            </div>
                        </div>
                    </div>
                    <div class="text-xs text-gray-400 mt-3">
                        B has two children: C (on main) and D (on the feature
                        branch)
                    </div>
                </div>
            </div>

            <!-- Merging -->
            <div>
                <div class="text-sm font-semibold text-gray-300 mb-3">
                    After merging:
                </div>
                <div class="relative p-4">
                    <div class="font-mono text-xs space-y-1">
                        <div class="flex items-center">
                            <div
                                class="bg-cyan-900 rounded px-2 py-1"
                            >
                                A
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-cyan-900 rounded px-2 py-1"
                            >
                                B
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-cyan-900 rounded px-2 py-1"
                            >
                                C
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-yellow-900 rounded px-2 py-1"
                            >
                                M
                            </div>
                            <div class="mx-2 text-gray-500">← merge commit</div>
                        </div>
                        <div class="flex items-center pl-24">
                            <div class="text-gray-500">↓</div>
                            <div class="ml-36 text-gray-500">↗</div>
                        </div>
                        <div class="flex items-center pl-24">
                            <div
                                class="bg-green-900 rounded px-2 py-1"
                            >
                                D
                            </div>
                            <div class="mx-2">→</div>
                            <div
                                class="bg-green-900 rounded px-2 py-1"
                            >
                                E
                            </div>
                            <div class="mx-2">─</div>
                        </div>
                    </div>
                    <div class="text-xs text-yellow-400 mt-3">
                        M has 'two' parents: C and E (combines both branches)
                    </div>
                </div>
            </div>
        </div>

        <InfoBox>
            <div><strong>What's a DAG (Directed Acyclic Graph)?</strong></div>
            <div class="pl-2 border-l border-rule space-y-1 mt-1">
                <div class="text-xs">
                    <strong>Directed:</strong> arrows point one way (parent ← child).
                </div>
                <div class="text-xs">
                    <strong>Acyclic:</strong> it never loops back.
                </div>
                <div class="text-xs">
                    <strong>Graph:</strong> it can branch and merge (not only a
                    straight line).
                </div>
                <div class="text-xs mt-2">
                    Your history can split and rejoin, but it always moves
                    forward in time.
                </div>
            </div>
        </InfoBox>

        <ProTip>
            <div><strong>Why the graph matters:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">
                    <Mark type="yes" /> Commits know their parents, so you can
                    walk back through history.
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Branches are labels that point to commits
                    in the graph.
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Many people can work on different branches
                    at the same time.
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> Git can find common ancestors (merges need
                    them).
                </div>
                <div class="text-xs">
                    <Mark type="yes" /> A commit is never 'lost' while something
                    points to it.
                </div>
            </div>
        </ProTip>

        <div class="p-4 rounded border-t border-rule">
            <div class="text-sm font-bold text-cyan-300 mb-2">Key insight:</div>
            <div class="text-xs text-gray-300">
                Git commands make more sense when you
                remember:
                <div class="mt-2 pl-3 border-l border-rule space-y-1">
                    <div>• Commits are snapshots with a hash</div>
                    <div>• Commits point to parent commits</div>
                    <div>
                        • Branches are movable labels that point to commits
                    </div>
                    <div>• Everything forms a graph of history</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- PUTTING IT ALL TOGETHER -->
    <!-- ============================================ -->

    <SectionTitle id="together" color="orange">
        Putting it all together
    </SectionTitle>

    <div class="space-y-4 mb-8">
        <div class="p-6 rounded">
            <div class="text-lg font-bold text-orange-300 mb-4">
                The complete picture
            </div>

            <div class="space-y-4">
                <!-- Example commit -->
                <div
                    class="bg-orange-900 rounded p-4"
                >
                    <div class="text-xs mb-3">
                        When you run <code
                            >git commit</code
                        >:
                    </div>
                    <div class="pl-4 space-y-2 text-xs">
                        <div>
                            <strong class="text-orange-300"
                                >1. Content-addressed:</strong
                            >
                            <div class="pl-3 text-gray-300">
                                Your files are already hashed and stored, for
                                example '5e1c309d...'. <code>git add</code> did
                                this. The commit hashes the tree and the commit
                                object.
                            </div>
                        </div>
                        <div>
                            <strong class="text-orange-300">2. Snapshot:</strong
                            >
                            <div class="pl-3 text-gray-300">
                                Creates a complete snapshot of 'all' files
                                (unchanged files reuse existing hashes)
                            </div>
                        </div>
                        <div>
                            <strong class="text-orange-300">3. Graph:</strong>
                            <div class="pl-3 text-gray-300">
                                The new commit points to its parent and joins
                                the history graph
                            </div>
                        </div>
                        <div>
                            <strong class="text-orange-300"
                                >4. Branch label moves:</strong
                            >
                            <div class="pl-3 text-gray-300">
                                Your current branch (for example 'main') moves
                                to point to the new commit
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visual representation -->
                <div class="p-4 rounded">
                    <div class="text-sm font-bold text-gray-300 mb-3">
                        Example commit structure:
                    </div>
                    <div class="font-mono text-xs space-y-1 text-gray-300">
                        <div class="text-yellow-400">Commit: abc123def456</div>
                        <div class="pl-3">
                            ├─ Parent: xyz789abc012 <span class="text-gray-500"
                                >(points to previous commit)</span
                            >
                        </div>
                        <div class="pl-3">
                            ├─ Tree: 4a5e6b7c8d9e <span class="text-gray-500"
                                >(snapshot of all files)</span
                            >
                        </div>
                        <div class="pl-3">
                            │ ├─ README.md → 5e1c309d... <span
                                class="text-gray-500">(file hash)</span
                            >
                        </div>
                        <div class="pl-3">
                            │ ├─ index.js → c57eff55... <span
                                class="text-gray-500">(file hash)</span
                            >
                        </div>
                        <div class="pl-3">
                            │ └─ style.css → 8c9a1b2c... <span
                                class="text-gray-500">(file hash)</span
                            >
                        </div>
                        <div class="pl-3">├─ Author: You</div>
                        <div class="pl-3">├─ Date: 2025-11-13</div>
                        <div class="pl-3">└─ Message: "Add new feature"</div>
                        <div class="mt-2 text-cyan-400">
                            Branch "main" → abc123def456 <span
                                class="text-gray-500"
                                >(branch points to this commit)</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Now the commands make sense:</strong></div>
            <div class="pl-2 border-l border-rule space-y-1 mt-1">
                <div class="text-xs">
                    <code
                        >git checkout abc123</code
                    >
                    <span class="text-gray-400 ml-2"
                        >→ Move to that snapshot in the graph</span
                    >
                </div>
                <div class="text-xs">
                    <code
                        >git branch feature</code
                    >
                    <span class="text-gray-400 ml-2"
                        >→ Create a new label pointing to current commit</span
                    >
                </div>
                <div class="text-xs">
                    <code
                        >git merge feature</code
                    >
                    <span class="text-gray-400 ml-2"
                        >→ Create a new commit with two parents</span
                    >
                </div>
                <div class="text-xs">
                    <code
                        >git log</code
                    >
                    <span class="text-gray-400 ml-2"
                        >→ Walk backwards through the graph</span
                    >
                </div>
            </div>
        </ProTip>

        <div class="bg-green-900 p-4 rounded">
            <div class="text-sm font-bold text-green-300 mb-2">
                You now understand Git's core model
            </div>
            <div class="text-xs text-gray-300">
                Everything else (staging area, branches, HEAD, remotes) builds
                on these three concepts. The commands might still seem odd,
                but now you know what they do underneath.
            </div>
        </div>
    </div>

    <Fragment slot="page-nav">
        <ul class="space-y-2 text-xs">
            <li>
                <a
                    href="#content-addressed"
                    class="text-ink font-semibold hover:underline block py-1"
                    >Content-addressed storage</a
                >
            </li>
            <li>
                <a
                    href="#snapshots"
                    class="text-ink font-semibold hover:underline block py-1"
                    >Snapshots, not diffs</a
                >
            </li>
            <li>
                <a
                    href="#graph"
                    class="text-ink font-semibold hover:underline block py-1"
                    >The graph (DAG)</a
                >
            </li>
            <li>
                <a
                    href="#together"
