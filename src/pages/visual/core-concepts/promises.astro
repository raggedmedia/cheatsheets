---
import "~styles/styles.css";
import MethodCard from "~components/visual-js/MethodCard.astro";
import InfoBox from "~components/visual-js/InfoBox.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import SubSectionTitle from "~components/visual-js/SubSectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Promises and async/await">
    <ProTip>
        <div><strong>3 Promise states:</strong></div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="text-xs">
                <strong>Pending</strong> - the initial state. Not fulfilled or rejected yet.
            </div>
            <div class="text-xs">
                <strong>Fulfilled</strong> - the operation succeeded.
            </div>
            <div class="text-xs">
                <strong>Rejected</strong> - the operation failed with an error.
            </div>
            <div class="text-xs mt-1">
                <span class="text-gray-400"
                    >Once fulfilled or rejected, a promise cannot change state
                    again</span>
            </div>
        </div>
    </ProTip>

    <InfoBox>
        <div><strong>Promises best practices - quick reference</strong></div>

        <div class="pl-2 border-l border-rule space-y-2 mt-2">
            <div>
                <div class="font-bold text-blue-300 text-xs mb-0.5">
                    Async/await in loops
                </div>
                <div class="text-xs pl-2 space-y-0.5">
                    <div>
                        <span class="text-green-400"><Mark type="yes" /> Sequential:</span>
                        <code>for...of</code> or <code>for</code> loop with <code>await</code>
                    </div>
                    <div>
                        <span class="text-green-400"><Mark type="yes" /> Parallel:</span>
                        <code>Promise.all(arr.map(async item => ...))</code>
                    </div>
                    <div>
                        <span class="text-red-400"><Mark type="no" /> Avoid:</span>
                        <code>forEach(async)</code> - doesn't wait for promises
                    </div>
                    <div class="text-gray-400">
                        Use <code>for await...of</code> for async iterables
                    </div>
                </div>
            </div>

            <div>
                <div class="font-bold text-blue-300 text-xs mb-0.5">
                    Common functions that return promises
                </div>
                <div class="text-xs pl-2 space-y-0.5">
                    <div>
                        <span class="text-purple-400"><code>fetch()</code>:</span> HTTP requests
                    </div>
                    <div>
                        <span class="text-purple-400"><code>fs.promises.*</code>:</span> Node.js file operations (<code>readFile</code>, <code>writeFile</code>)
                    </div>
                    <div>
                        <span class="text-purple-400"><code>setTimeout()</code>:</span> only when you wrap it in <code>new Promise()</code>
                    </div>
                    <div>
                        <span class="text-purple-400">Database queries:</span> most database clients (MongoDB, PostgreSQL)
                    </div>
                    <div>
                        <span class="text-purple-400"><code>axios</code> and other HTTP libraries:</span> API requests
                    </div>
                    <div class="text-gray-400">
                        Every <code>async</code> function returns a promise
                    </div>
                </div>
            </div>

            <div>
                <div class="font-bold text-blue-300 text-xs mb-0.5">
                    Performance tips
                </div>
                <div class="text-xs pl-2 space-y-0.5">
                    <div>
                        <span class="text-green-400"><Mark type="yes" /> Parallel:</span> use <code>Promise.all()</code> for independent operations
                    </div>
                    <div>
                        <span class="text-green-400"><Mark type="yes" /> Sequential:</span> use <code>await</code> in series for dependent operations
                    </div>
                    <div>
                        <span class="text-yellow-400">Timeouts:</span> <code>Promise.race()</code> against a timer
                    </div>
                    <div>
                        <span class="text-red-400"><Mark type="no" /> Avoid:</span> creating promises in loops when you do not need them
                    </div>
                    <div class="text-gray-400">
                        Start all promises first, then await them. Do not mix creation and waiting.
                    </div>
                </div>
            </div>

            <div>
                <div class="font-bold text-blue-300 text-xs mb-0.5">
                    Common pitfalls
                </div>
                <div class="text-xs pl-2 space-y-0.5">
                    <div>
                        <span class="text-red-400"><Mark type="no" /></span> Forgetting <code>await</code> - you get a promise, not the value
                    </div>
                    <div>
                        <span class="text-red-400"><Mark type="no" /></span> <code>async</code> without <code>await</code> (usually not needed)
                    </div>
                    <div>
                        <span class="text-red-400"><Mark type="no" /></span> Not handling errors (unhandled
                        rejection warnings)
                    </div>
                    <div>
                        <span class="text-red-400"><Mark type="no" /></span> <code>await</code> inside <code>forEach</code> (it does not wait, use <code>for...of</code>)
                    </div>
                    <div>
                        <span class="text-red-400"><Mark type="no" /></span> Wrapping promise-based code in <code>new Promise()</code> (the constructor anti-pattern)
                    </div>
                </div>
            </div>
        </div>
    </InfoBox>

    <!-- ============================================ -->
    <!-- CREATING PROMISES -->
    <!-- ============================================ -->

    <SectionTitle id="creating" color="blue">
        Creating promises
    </SectionTitle>

    <!-- NEW PROMISE -->
    <MethodCard
        id="new-promise"
        methodName="new Promise()"
        signature="new Promise((resolve, reject) => { })"
        description="Create a new promise with resolve/reject functions"
        mutates={false}
    >
        <!-- State Machine Diagram -->
        <div class="p-6 rounded">
            <!-- Pending State -->
            <div class="flex items-center justify-center mb-8">
                <div
                    class="bg-yellow-900 rounded-lg p-4 text-center"
                >
                    <div class="text-yellow-300 font-bold text-lg mb-1">
                        PENDING
                    </div>
                    <div class="text-xs text-gray-300">
                        Promise created, waiting...
                    </div>
                </div>
            </div>

            <!-- Arrows pointing down -->
            <div class="flex justify-center gap-24 mb-4">
                <div class="flex flex-col items-center">
                    <div class="text-2xl mb-2">↓</div>
                    <div class="text-xs text-green-400 font-mono">
                        resolve(value)
                    </div>
                </div>
                <div class="flex flex-col items-center">
                    <div class="text-2xl mb-2">↓</div>
                    <div class="text-xs text-red-400 font-mono">
                        reject(error)
                    </div>
                </div>
            </div>

            <!-- Final States -->
            <div class="flex justify-center gap-8">
                <div
                    class="bg-green-900 rounded-lg p-4 text-center flex-1 max-w-[200px]"
                >
                    <div class="text-green-300 font-bold text-lg mb-1">
                        <Mark type="yes" /> FULFILLED
                    </div>
                    <div class="text-xs text-gray-300">Succeeded with a value</div>
                </div>
                <div
                    class="bg-red-900 rounded-lg p-4 text-center flex-1 max-w-[200px]"
                >
                    <div class="text-red-300 font-bold text-lg mb-1">
                        <Mark type="no" /> REJECTED
                    </div>
                    <div class="text-xs text-gray-300">Failed with an error</div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            The executor function runs immediately. Call <code
                >resolve(value)</code
            > on success, <code
                >reject(error)</code
            > on failure.
        </div>

        <ProTip>
            <div>Basic promise creation:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const promise = new Promise((resolve, reject) =&gt; {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const success = true
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;if (success) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;resolve('It worked!') <span
                        class="text-green-400">// fulfills promise</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;{"}"} else {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;reject(new Error('Failed')) <span
                        class="text-red-400">// rejects promise</span>
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"}</div>
                <div class="font-mono text-xs">{"}"})</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- PROMISE.RESOLVE -->
    <MethodCard
        id="promise-resolve"
        methodName="Promise.resolve()"
        signature="Promise.resolve(value)"
        description="Create an immediately fulfilled promise"
        mutates={false}
    >
        <!-- Shortcut to Fulfilled State -->
        <div class="p-6 rounded">
            <div class="flex items-center justify-center gap-8">
                <div
                    class="bg-blue-900 rounded-lg p-4 text-center"
                >
                    <div class="text-blue-300 font-mono text-sm mb-1">
                        Promise.resolve('data')
                    </div>
                    <div class="text-xs text-gray-400">Skips pending state</div>
                </div>

                <div class="text-3xl text-green-400">→</div>

                <div
                    class="bg-green-900 rounded-lg p-4 text-center"
                >
                    <div class="text-green-300 font-bold text-lg mb-1">
                        <Mark type="yes" /> FULFILLED
                    </div>
                    <div class="text-xs text-gray-300">
                        Immediately resolved
                    </div>
                    <div class="text-xs text-yellow-400 font-mono mt-1">
                        value: 'data'
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Returns a promise that is already fulfilled with the given value.
            Use it to turn sync values into promises.
        </div>

        <ProTip>
            <div>Keep the return type consistent. Always return a promise:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-green-400"
                        >// <Mark type="yes" /> Good: Always returns promise</span>
                </div>
                <div class="font-mono text-xs">
                    function getUserData(id) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const cached = cache.get(id)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;if (cached) return Promise.resolve(cached)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return fetch(`/users/${"{"}id{"}"}`).then(r
                    =&gt; r.json())
                </div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="font-mono text-xs mt-1.5">
                    <span class="text-red-400"
                        >// <Mark type="no" /> Bad: Sometimes promise, sometimes not</span>
                </div>
                <div class="font-mono text-xs">
                    function getUserData(id) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const cached = cache.get(id)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;if (cached) return cached <span
                        class="text-gray-400">// Not a promise!</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return fetch(`/users/${"{"}id{"}"}`).then(r
                    =&gt; r.json())
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- PROMISE.REJECT -->
    <MethodCard
        id="promise-reject"
        methodName="Promise.reject()"
        signature="Promise.reject(reason)"
        description="Create an immediately rejected promise"
        mutates={false}
    >
        <!-- Shortcut to Rejected State -->
        <div class="p-6 rounded">
            <div class="flex items-center justify-center gap-8">
                <div
                    class="bg-blue-900 rounded-lg p-4 text-center"
                >
                    <div class="text-blue-300 font-mono text-sm mb-1">
                        Promise.reject(error)
                    </div>
                    <div class="text-xs text-gray-400">Skips pending state</div>
                </div>

                <div class="text-3xl text-red-400">→</div>

                <div
                    class="bg-red-900 rounded-lg p-4 text-center"
                >
                    <div class="text-red-300 font-bold text-lg mb-1">
                        <Mark type="no" /> REJECTED
                    </div>
                    <div class="text-xs text-gray-300">
                        Immediately rejected
                    </div>
                    <div class="text-xs text-yellow-400 font-mono mt-1">
                        reason: Error
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Returns a promise that is already rejected with the given reason.
            Use it for early error returns.
        </div>

        <ProTip>
            <div>Useful for early validation in async functions:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    async function updateUser(id, data) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;<span class="text-gray-400"
                        >// Validate early, return rejected promise</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;if (!id) return Promise.reject(new Error('ID
                    required'))
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;if (!data) return Promise.reject(new Error('Data
                    required'))
                </div>
                <div class="font-mono text-xs mt-0.5">
                    &nbsp;&nbsp;<span class="text-gray-400"
                        >// Continue with async work</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return fetch(`/users/${"{"}id{"}"}`, {"{"} method:
                    'PUT', body: data {"}"})
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- PROMISE CHAINING -->
    <!-- ============================================ -->

    <SectionTitle id="chaining" color="purple">
        Promise chaining
    </SectionTitle>

    <!-- PROMISE CHAIN - .then() .catch() .finally() -->
    <MethodCard
        id="then"
        methodName=".then() / .catch() / .finally()"
        signature="promise.then().catch().finally()"
        description="Chain handlers for promise results, errors, and cleanup"
        mutates={false}
    >
        <!-- Complete Chain Flow -->
        <div class="p-6 rounded">
            <div class="space-y-6">
                <!-- SUCCESS PATH -->
                <div>
                    <div class="text-green-400 font-bold text-sm mb-3">
                        <Mark type="yes" /> Success path:
                    </div>
                    <div class="flex items-center gap-3">
                        <!-- Initial Promise -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-green-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-green-300 font-bold text-xs mb-1"
                                >
                                    Promise
                                </div>
                                <div
                                    class="text-yellow-400 font-mono text-xs"
                                >
                                    'data'
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-purple-400">→</div>

                        <!-- .then() -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-purple-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-purple-300 font-mono text-xs mb-1"
                                >
                                    .then(d => d.toUpperCase())
                                </div>
                                <div
                                    class="text-yellow-400 font-mono text-xs"
                                >
                                    'DATA'
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-gray-500">→</div>

                        <!-- .catch() skipped -->
                        <div class="flex-1 text-center">
                            <div
                                class="rounded-lg p-2.5 border-t border-rule"
                            >
                                <div
                                    class="text-gray-500 font-mono text-xs mb-1"
                                >
                                    .catch()
                                </div>
                                <div class="text-gray-500 text-xs">
                                    skipped
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-purple-400">→</div>

                        <!-- .finally() -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-purple-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-purple-300 font-mono text-xs mb-1"
                                >
                                    .finally(cleanup)
                                </div>
                                <div class="text-gray-400 text-xs">
                                    runs
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-green-400">→</div>

                        <!-- Result -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-green-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-green-300 font-bold text-xs mb-1"
                                >
                                    Result
                                </div>
                                <div
                                    class="text-yellow-400 font-mono text-xs"
                                >
                                    'DATA'
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ERROR PATH -->
                <div>
                    <div class="text-red-400 font-bold text-sm mb-3">
                        <Mark type="no" /> Error path:
                    </div>
                    <div class="flex items-center gap-3">
                        <!-- Initial Promise -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-red-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-red-300 font-bold text-xs mb-1"
                                >
                                    Promise
                                </div>
                                <div
                                    class="text-yellow-400 font-mono text-xs"
                                >
                                    Error
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-gray-500">→</div>

                        <!-- .then() skipped -->
                        <div class="flex-1 text-center">
                            <div
                                class="rounded-lg p-2.5 border-t border-rule"
                            >
                                <div
                                    class="text-gray-500 font-mono text-xs mb-1"
                                >
                                    .then()
                                </div>
                                <div class="text-gray-500 text-xs">
                                    skipped
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-purple-400">→</div>

                        <!-- .catch() handles error -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-purple-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-purple-300 font-mono text-xs mb-1"
                                >
                                    .catch(e => 'fallback')
                                </div>
                                <div
                                    class="text-yellow-400 font-mono text-xs"
                                >
                                    'fallback'
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-purple-400">→</div>

                        <!-- .finally() -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-purple-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-purple-300 font-mono text-xs mb-1"
                                >
                                    .finally(cleanup)
                                </div>
                                <div class="text-gray-400 text-xs">
                                    runs
                                </div>
                            </div>
                        </div>

                        <div class="text-lg text-green-400">→</div>

                        <!-- Result (recovered!) -->
                        <div class="flex-1 text-center">
                            <div
                                class="bg-green-900 rounded-lg p-2.5"
                            >
                                <div
                                    class="text-green-300 font-bold text-xs mb-1"
                                >
                                    Result
                                </div>
                                <div
                                    class="text-yellow-400 font-mono text-xs"
                                >
                                    'fallback'
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            <strong>.then()</strong> handles success. <strong>.catch()</strong> handles
            errors and recovers the chain. <strong>.finally()</strong> always runs
            for cleanup. It does not receive or change values.
        </div>

        <ProTip>
            <div><Mark type="warn" /> <strong>Key behaviours:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// .catch() recovers the chain</span>
                </div>
                <div class="font-mono text-xs">fetchUser()</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.then(user =&gt; user.name)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.catch(err =&gt; 'Guest') <span
                        class="text-gray-400">// returns 'Guest' if error</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.then(name =&gt; console.log(name)) <span
                        class="text-gray-400">// runs with 'Guest'</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.finally(() =&gt; cleanup()) <span
                        class="text-gray-400">// always runs</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-yellow-400"
                        >// Each .then() returns a new promise</span>
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div><strong>Common pattern - loading states:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">setLoading(true)</div>
                <div class="font-mono text-xs">fetchData()</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.then(data =&gt; setData(data))
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.catch(err =&gt; setError(err))
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;.finally(() =&gt; setLoading(false)) <span
                        class="text-gray-400">// cleanup</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- ASYNC/AWAIT -->
    <!-- ============================================ -->

    <SectionTitle id="async-await" color="green">Async/await</SectionTitle>

    <!-- ASYNC FUNCTION -->
    <MethodCard
        id="async-function"
        methodName="async function"
        signature="async function name() { }"
        description="Declares a function that always returns a promise"
        mutates={false}
    >
        <!-- Auto-wrap in Promise -->
        <div class="p-6 rounded">
            <div class="flex items-center gap-4">
                <div class="flex-1 text-center">
                    <div
                        class="bg-blue-900 rounded-lg p-3 mb-2"
                    >
                        <div class="text-blue-300 font-mono text-xs mb-1">
                            async function getData()
                        </div>
                        <div class="text-yellow-400 font-mono text-xs mb-1">
                            {"{"}
                        </div>
                        <div class="text-yellow-400 font-mono text-xs mb-1">
                            &nbsp;&nbsp;return 'data'
                        </div>
                        <div class="text-yellow-400 font-mono text-xs">
                            {"}"}
                        </div>
                    </div>
                    <div class="text-xs text-gray-400">Returns a plain value</div>
                </div>

                <div class="text-2xl text-green-400"></div>

                <div class="flex-1 text-center">
                    <div
                        class="bg-green-900 rounded-lg p-3 mb-2"
                    >
                        <div class="text-green-300 font-bold text-sm mb-1">
                            <Mark type="yes" /> Promise
                        </div>
                        <div class="text-xs text-yellow-400 font-mono">
                            Promise&lt;'data'&gt;
                        </div>
                    </div>
                    <div class="text-xs text-gray-400">Wrapped automatically</div>
                </div>
            </div>
