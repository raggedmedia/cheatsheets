---
interface Props {
    type: "yes" | "no" | "warn";
}

const { type } = Astro.props;

const label = { yes: "Correct", no: "Incorrect", warn: "Warning" }[type];
const tone = { yes: "text-immutable", no: "text-mutates", warn: "text-yellow-300" }[type];
---

<svg role="img" aria-label={label} viewBox="0 0 12 12" class={`inline-block size-[0.9em] align-[-0.1em] ${tone}`} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {type === "yes" && <path d="M2 6.5 5 9.5 10 3" />}
    {type === "no" && <path d="M3 3l6 6M9 3l-6 6" />}
    {type === "warn" && <><path d="M6 1.5 11 10.5H1Z" /><path d="M6 5v2.5M6 9v.01" /></>}
</svg>
