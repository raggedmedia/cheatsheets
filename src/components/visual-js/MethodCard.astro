---
import { looksLikeCode } from "../../lib/code-name";

interface Props {
    id: string;
    methodName: string;
    signature: string;
    description: string;
    mutates: boolean;
    hideTag?: boolean
}

const { id, methodName, signature, description, mutates, hideTag = false } = Astro.props;
const isCode = looksLikeCode(methodName);
const anchor = id ?? methodName.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<section id={anchor} data-method={methodName} data-state={hideTag ? "none" : mutates ? "mutates" : "immutable"} class="border-t border-rule pt-5 pb-7 scroll-mt-6 2xl:grid 2xl:grid-cols-[240px_minmax(0,1fr)] 2xl:gap-x-8">
    <div class="mb-4">
        <div class="flex flex-wrap items-center gap-3 mb-1">
            <h4 class={`text-2xl font-semibold text-ink ${isCode ? "font-mono" : "tracking-tight"}`}>{methodName}</h4>
            {!hideTag && (
                <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-ground ${mutates ? "bg-mutates" : "bg-immutable"}`}>
                    <svg aria-hidden="true" viewBox="0 0 10 10" class="size-2.5">
                        <circle cx="5" cy="5" r="4" fill={mutates ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    {mutates ? "Mutates" : "Immutable"}
                </span>
            )}
        </div>
        <div class={`text-sm text-gray-400 mb-1 ${looksLikeCode(signature) ? "font-mono" : ""}`}>{signature}</div>
        <p class="text-base text-ink max-w-[70ch]">{description}</p>
    </div>

    <div class="min-w-0">
        <slot />
    </div>
</section>
