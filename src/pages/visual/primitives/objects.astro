                <div class="text-center text-sm font-mono">
                    value (otherwise)
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns the right side only if the left side is <code
                >null</code
            > or <code
                >undefined</code
            >. Unlike <code
                >||</code
            >, keeps falsy values like 0, "", false.
        </MutableOrNot>

        <ProTip>
            <div><strong>?? vs || (important difference):</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">const count = 0;</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-red-400">// || treats 0 as falsy <Mark type="no" /></span>
                </div>
                <div class="font-mono text-xs">
                    count || 10 → 10 <span class="text-gray-400"
                        >// loses your 0!</span
                    >
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-green-400"
                        >// ?? only checks null/undefined <Mark type="yes" /></span
                    >
                </div>
                <div class="font-mono text-xs">
                    count ?? 10 → 0 <span class="text-gray-400"
                        >// keeps your 0!</span
                    >
                </div>
                <div class="font-mono text-xs mt-1.5">
                    <span class="text-blue-400"
                        >// Perfect with optional chaining:</span
                    >
                </div>
                <div class="font-mono text-xs">obj?.user?.age ?? 18</div>
