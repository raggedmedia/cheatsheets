---
import MethodCard from "~components/visual-js/MethodCard.astro";
import InfoBox from "~components/visual-js/InfoBox.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import SubSectionTitle from "~components/visual-js/SubSectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Functions - best practices">
    <!-- QUICK DECISION GUIDE -->
    <InfoBox>
        <div class="font-bold text-blue-300 mb-2">Quick decision guide</div>
        <div class="space-y-3">
            <div>
                <div class="font-bold text-green-300 text-sm mb-1">
                    <Mark type="yes" /> Default choice (90% of the time):
                </div>
                <div
                    class="rounded border-t border-rule pt-2 mt-2"
                >
                    <div class="font-mono text-xs text-green-300">
                        const myFunction = (param) => {"{"} ... {"}"}
                    </div>
                    <div class="text-xs text-gray-300 mt-1">
                        Arrow functions - clean, predictable, modern
                    </div>
                </div>
            </div>

            <div>
                <div class="font-bold text-yellow-300 text-sm mb-1">
                    <Mark type="warn" /> Use regular functions when:
                </div>
                <div
                    class="rounded border-t border-rule pt-2 mt-2"
                >
                    <div
                        class="text-xs text-yellow-300 space-y-0.5"
                    >
                        <div>
                            • Object methods that need <code>this</code
                            >
                        </div>
                        <div>• Constructors (but use classes instead)</div>
                        <div>
                            • Code that needs the <code
                                >arguments</code
                            > object
                        </div>
                        <div>• Generator functions</div>
                    </div>
                </div>
            </div>

            <div class="text-xs text-gray-400 italic">
                If you're not sure, use an arrow function. You'll know when you
                need a regular function.
            </div>
        </div>
    </InfoBox>

    <!-- ============================================ -->
    <!-- FUNCTION TYPES & HOISTING -->
    <!-- ============================================ -->

    <SectionTitle id="function-types" color="cyan">
        Function types & hoisting
    </SectionTitle>

    <MethodCard
        id="three-types"
        methodName="Three ways to define functions"
        signature="Understanding declarations, expressions, and arrows"
        description="Why hoisting matters (but rarely in practice)"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-4">
                <!-- Function Declaration -->
                <div class="bg-blue-900 rounded p-3">
                    <div class="text-blue-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-2">
                            Function Declaration
                        </div>
                        <div>function greet(name) {"{"}</div>
                        <div>&nbsp;&nbsp;return `Hello ${"{"}name{"}"}`</div>
                        <div>{"}"}</div>
                        <div class="mt-2 text-xs text-gray-300">
                            <span class="text-green-400 font-sans"><Mark type="yes" /> Hoisted:</span> Can call
                            before definition
                        </div>
                        <div class="mt-1 rounded border-t border-rule pt-2 mt-2">
                            <div>
                                greet('Alice') <span class="text-gray-400"
                                    >// Works! <Mark type="yes" /></span>
                            </div>
                            <div>function greet(name) {"{"} ... {"}"}</div>
                        </div>
                    </div>
                </div>

                <!-- Function Expression -->
                <div
                    class="bg-purple-900 rounded p-3"
                >
                    <div class="text-purple-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-2">
                            Function Expression
                        </div>
                        <div>const greet = function(name) {"{"}</div>
                        <div>&nbsp;&nbsp;return `Hello ${"{"}name{"}"}`</div>
                        <div>{"}"}</div>
                        <div class="mt-2 text-xs text-gray-300">
                            <span class="text-orange-400"
                                ><Mark type="warn" /> Hoisted, but not initialised (temporal dead zone):</span
                            > Can't call before definition
                        </div>
                        <div class="mt-1 rounded border-t border-rule pt-2 mt-2">
                            <div>
                                greet('Alice') <span class="text-gray-400"
                                    >// ReferenceError! <Mark type="no" /></span>
                            </div>
                            <div>
                                const greet = function(name) {"{"} ... {"}"}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Arrow Function -->
                <div
                    class="bg-green-900 rounded p-3"
                >
                    <div class="text-green-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-2">
                            Arrow Function (Expression)
                        </div>
                        <div>
                            const greet = (name) =&gt; `Hello ${"{"}name{"}"}`
                        </div>
                        <div class="mt-2 text-xs text-gray-300">
                            <span class="text-orange-400 font-sans"
                                ><Mark type="warn" /> Same as function expression:</span
                            > Can't call before definition
                        </div>
                        <div class="mt-1 rounded border-t border-rule pt-2 mt-2">
                            <div>
                                greet('Alice') <span class="text-gray-400"
                                    >// ReferenceError! <Mark type="no" /></span>
                            </div>
                            <div>
                                const greet = (name) =&gt; `Hello ${"{"}name{
                                    "}"
                                }`
                            </div>
                        </div>
                        <div class="mt-2 text-xs text-green-300 font-bold">
                            Arrow functions are function expressions
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <InfoBox>
            <div class="font-bold text-cyan-300 mb-2">
                So when does hoisting matter?
            </div>
            <div class="space-y-3">
                <div
                    class="rounded border-t border-rule pt-2 mt-2"
                >
                    <div class="text-orange-300 text-xs space-y-1">
                        <div class="font-bold mb-1">
                            Function declarations (hoisted) - old school:
                        </div>
                        <div class="font-mono">
                            <div>
                                init() <span class="text-gray-400"
                                    >// Can call here</span>
                            </div>
                            <div class="mt-1">function init() {"{"}</div>
                            <div>&nbsp;&nbsp;setupApp()</div>
                            <div>&nbsp;&nbsp;loadData()</div>
                            <div>{"}"}</div>
                        </div>
                        <div class="text-gray-300 mt-2 italic">
                            Useful if you like putting helper functions at the
                            bottom of files
                        </div>
                    </div>
                </div>

                <div
                    class="rounded border-t border-rule pt-2 mt-2"
                >
                    <div class="text-green-300 text-xs space-y-1">
                        <div class="font-bold mb-1">
                            Function expressions (not hoisted) - modern:
                        </div>
                        <div class="font-mono">
                            <div>const init = () =&gt; {"{"}</div>
                            <div>&nbsp;&nbsp;setupApp()</div>
                            <div>&nbsp;&nbsp;loadData()</div>
                            <div>{"}"}</div>
                            <div class="mt-1">
                                init() <span class="text-gray-400"
                                    >// Must call after</span>
                            </div>
                        </div>
                        <div class="text-gray-300 mt-2 italic">
                            Makes you organise code in a logical order, which is good
                        </div>
                    </div>
                </div>

                <div class="text-xs text-gray-400 italic mt-2">
                    With modules and good code organisation, you rarely need
                    hoisting. Top-to-bottom flow is clearer.
                </div>
            </div>
        </InfoBox>

        <ProTip>
            <div><strong>Practical takeaway:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">
                    <span class="text-green-400"
                        ><Mark type="yes" /> Use arrow functions (expressions)</span
                    > - modern, concise, predictable `this`
                </div>
                <div class="text-xs">
                    <span class="text-gray-400"
                        >Use function declarations</span
                    > - only if you need hoisting (rare)
                </div>
                <div class="text-xs">
                    <span class="text-red-400"
                        ><Mark type="no" /> Avoid <code>function</code> expressions</span
                    > - use arrow functions instead
                </div>
                <div class="text-xs mt-2 text-gray-400">
                    In modern JS, use arrow functions almost everywhere. Use
                    regular functions for object methods.
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- Key Differences Summary -->
    <MethodCard
        id="key-differences"
        methodName="Key differences at a glance"
        signature="What actually matters"
        description="Summary of the three types"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                    <thead class="text-yellow-400 border-b border-gray-600">
                        <tr>
                            <th class="pb-2 pr-4">Feature</th>
                            <th class="pb-2 pr-4">Declaration</th>
                            <th class="pb-2 pr-4">Expression</th>
                            <th class="pb-2">Arrow</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-300">
                        <tr class="border-b border-gray-700">
                            <td class="py-2 pr-4 font-mono text-gray-400"
                                >Syntax</td
                            >
                            <td class="py-2 pr-4 font-mono text-blue-300"
                                >function fn() {"{}"}</td
                            >
                            <td class="py-2 pr-4 font-mono text-purple-300"
                                >const fn = function() {"{}"}</td
                            >
                            <td class="py-2 font-mono text-green-300"
                                >const fn = () =&gt; {"{}"}</td
                            >
                        </tr>
                        <tr class="border-b border-gray-700">
                            <td class="py-2 pr-4 font-bold">Hoisted?</td>
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span> (fully)</td
                            >
                            <td class="py-2 pr-4"
                                ><span class="text-orange-400"
                                    ><Mark type="warn" /> Variable only</span
                                ></td
                            >
                            <td class="py-2"
                                ><span class="text-orange-400"
                                    ><Mark type="warn" /> Variable only</span
                                ></td
                            >
                        </tr>
                        <tr class="border-b border-gray-700">
                            <td class="py-2 pr-4 font-bold">Has own `this`?</td>
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span></td
                            >
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span></td
                            >
                            <td class="py-2"
                                ><span class="text-red-400"><Mark type="no" /> No</span> (lexical)</td
                            >
                        </tr>
                        <tr class="border-b border-gray-700">
                            <td class="py-2 pr-4 font-bold">Has `arguments`?</td
                            >
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span></td
                            >
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span></td
                            >
                            <td class="py-2"
                                ><span class="text-red-400"><Mark type="no" /> No</span></td
                            >
                        </tr>
                        <tr class="border-b border-gray-700">
                            <td class="py-2 pr-4 font-bold"
                                >Can be constructor?</td
                            >
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span></td
                            >
                            <td class="py-2 pr-4"
                                ><span class="text-green-400"><Mark type="yes" /> Yes</span></td
                            >
                            <td class="py-2"
                                ><span class="text-red-400"><Mark type="no" /> No</span></td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 pr-4 font-bold">When to use?</td>
                            <td class="py-2 pr-4 text-orange-300"
                                >Need hoisting</td
                            >
                            <td class="py-2 pr-4 text-red-300"
                                >Don't (use arrow)</td
                            >
                            <td class="py-2 text-green-300 font-bold"
                                >Default choice</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <ProTip>
            <div><strong>Remember this:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="text-xs">
                    <strong
                        >Arrow functions are a subset of function expressions</strong
                    > - both are expressions.
                </div>
                <div class="text-xs">
                    Arrows don't have their own `this` or `arguments`. That is
                    usually what you want.
                </div>
                <div class="text-xs mt-2">
                    <span class="text-green-400"><Mark type="yes" /> Arrow =</span> concise, predictable
                    `this`, modern
                </div>
                <div class="text-xs">
                    <span class="text-blue-400">Declaration =</span> hoisting
                    (rarely needed)
                </div>
                <div class="text-xs">
                    <span class="text-red-400"><Mark type="no" /> Expression =</span> use an arrow
                    instead
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- MODERN DEFAULT: ARROW FUNCTIONS -->
    <!-- ============================================ -->

    <SectionTitle id="arrow-functions" color="blue">
        Modern default: arrow functions
    </SectionTitle>

    <!-- BASIC ARROW FUNCTIONS -->
    <MethodCard
        id="arrow-basics"
        methodName="Arrow function syntax"
        signature="const fn = () => {}"
        description="Your default choice for modern JavaScript"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-4">
                <!-- All syntax variations -->
                <div class="bg-blue-900 rounded p-3">
                    <div class="text-blue-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-2 font-sans">
                            All the ways to write arrow functions:
                        </div>

                        <div>
                            <span class="text-gray-400">// No parameters</span>
                        </div>
                        <div>const greet = () =&gt; console.log('Hi')</div>

                        <div class="mt-2">
                            <span class="text-gray-400"
                                >// One parameter (parens optional)</span
                            >
                        </div>
                        <div>const double = num =&gt; num * 2</div>
                        <div>
                            const triple = (num) =&gt; num * 3 <span
                                class="text-gray-400">// same thing</span
                            >
                        </div>

                        <div class="mt-2">
                            <span class="text-gray-400"
                                >// Multiple parameters (parens required)</span
                            >
                        </div>
                        <div>const add = (a, b) =&gt; a + b</div>

                        <div class="mt-2">
                            <span class="text-gray-400"
                                >// Function body (braces required for multiple
                                lines)</span
                            >
                        </div>
                        <div>const complex = (x) =&gt; {"{"}</div>
                        <div>&nbsp;&nbsp;const result = x * 2</div>
                        <div>&nbsp;&nbsp;return result</div>
                        <div>{"}"}</div>

                        <div class="mt-2">
                            <span class="text-gray-400"
                                >// Return object (wrap in parens)</span
                            >
                        </div>
                        <div>
                            const makeUser = (name) =&gt; ({"{"} name, active: true
                            {"}"})
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <InfoBox>
            <div class="font-bold text-blue-300 mb-2">
                Why arrow functions are better
            </div>
            <div class="space-y-3">
                <!-- Concise -->
                <div
                    class="rounded border-t border-rule pt-2 mt-2"
                >
                    <div class="text-green-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 font-bold mb-1 font-sans">
                            <Mark type="yes" /> More concise:
                        </div>
                        <div><span class="text-red-400">// Old way</span></div>
                        <div>
                            users.map(function(user) {"{"} return user.name {
                                "}"
                            })
                        </div>
                        <div class="mt-1">
                            <span class="text-green-400">// Modern way</span>
                        </div>
                        <div>users.map(user =&gt; user.name)</div>
                    </div>
                </div>

                <!-- Predictable this -->
                <div class="rounded border-t border-rule pt-2 mt-2">
                    <div class="text-cyan-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 font-bold mb-1">
                            <Mark type="yes" /> Predictable `this` (lexical binding):
                        </div>
                        <div>class Timer {"{"}</div>
                        <div>&nbsp;&nbsp;start() {"{"}</div>
                        <div>
                            &nbsp;&nbsp;&nbsp;&nbsp;setTimeout(() =&gt; {"{"}
                        </div>
                        <div>
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;this.tick() <span
                                class="text-gray-400"
                                >// 'this' is Timer instance <Mark type="yes" /></span
                            >
                        </div>
                        <div>&nbsp;&nbsp;&nbsp;&nbsp;{"}"}, 1000)</div>
                        <div>&nbsp;&nbsp;{"}"}</div>
                        <div>{"}"}</div>
                    </div>
                </div>

                <!-- Best for callbacks -->
                <div
                    class="rounded border-t border-rule pt-2 mt-2"
                >
                    <div
                        class="text-purple-300 font-mono text-xs space-y-1"
                    >
                        <div class="text-yellow-400 font-bold mb-1 font-sans">
                            <Mark type="yes" /> Perfect for callbacks:
                        </div>
                        <div>
                            button.addEventListener('click', () =&gt;
                            handleClick())
                        </div>
                        <div>fetch(url).then(res =&gt; res.json())</div>
                        <div>items.filter(x =&gt; x.active)</div>
                    </div>
                </div>

                <div class="text-xs text-gray-300 mt-2 italic">
                    Use arrow functions for everything except object methods
                    and constructors. They work best for array methods,
                    callbacks, promises and event handlers.
                </div>
            </div>
        </InfoBox>

        <ProTip>
            <div>
                <strong>When to use implicit vs explicit return:</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-green-400"
                        >// <Mark type="yes" /> Implicit - one expression, no braces</span
                    >
                </div>
                <div class="font-mono text-xs">
                    const double = n =&gt; n * 2
                </div>
                <div class="font-mono text-xs">items.map(x =&gt; x.id)</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-green-400"
                        >// <Mark type="yes" /> Explicit - multiple statements, braces + return</span
                    >
                </div>
                <div class="font-mono text-xs">
                    const process = n =&gt; {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;console.log(n)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return n * 2
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- WHEN TO USE REGULAR FUNCTIONS -->
    <!-- ============================================ -->

    <SectionTitle id="regular-functions" color="orange">
        <Mark type="warn" /> When to use regular functions
    </SectionTitle>

    <!-- OBJECT METHODS -->
    <MethodCard
        id="object-methods"
        methodName="Object methods"
        signature="Use regular functions for 'this' binding"
        description="When you need dynamic 'this' context"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-4">
                <!-- Correct -->
                <div
                    class="bg-green-900 rounded p-3"
                >
                    <div class="text-green-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-1 font-sans">
                            <Mark type="yes" /> Correct - Regular function:
                        </div>
                        <div>const user = {"{"}</div>
                        <div>&nbsp;&nbsp;name: 'Alice',</div>
                        <div>&nbsp;&nbsp;greet() {"{"}</div>
                        <div>
                            &nbsp;&nbsp;&nbsp;&nbsp;console.log(`Hi, I'm ${
                                "{"
                            }this.name{"}"}`) <span class="text-gray-400"
                                >// Works!</span
                            >
                        </div>
                        <div>&nbsp;&nbsp;{"}"}</div>
                        <div>{"}"}</div>
                    </div>
                </div>

                <!-- Wrong -->
                <div class="bg-red-900 rounded p-3">
                    <div class="text-red-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-1 font-sans">
                            <Mark type="no" /> Wrong - Arrow function:
                        </div>
                        <div>const user = {"{"}</div>
                        <div>&nbsp;&nbsp;name: 'Alice',</div>
                        <div>&nbsp;&nbsp;greet: () =&gt; {"{"}</div>
                        <div>
                            &nbsp;&nbsp;&nbsp;&nbsp;console.log(`Hi, I'm ${
                                "{"
                            }this.name{"}"}`) <span class="text-gray-400"
                                >// undefined!</span
                            >
                        </div>
                        <div>&nbsp;&nbsp;{"}"}</div>
                        <div>{"}"}</div>
                        <div class="mt-2 text-xs">
                            <span class="text-gray-400"
                                >// Arrow functions don't have their own 'this'</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Modern shorthand syntax:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">const obj = {"{"}</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;method() {"{"} ... {"}"}
                    <span class="text-gray-400">// Shorthand - use this!</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;method: function() {"{"} ... {"}"}
                    <span class="text-gray-400">// Old way - verbose</span>
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OTHER CASES -->
    <MethodCard
        id="other-regular-cases"
        methodName="Other regular function cases"
        signature="Special situations"
        description="Rare cases that need the function keyword"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Constructors -->
                <div
                    class="bg-orange-900 rounded p-3"
                >
                    <div
                        class="text-orange-300 font-mono text-xs space-y-1"
                    >
                        <div class="text-yellow-400 mb-1">
                            Constructors (but use classes instead):
                        </div>
                        <div>function Person(name) {"{"}</div>
                        <div>&nbsp;&nbsp;this.name = name</div>
                        <div>{"}"}</div>
                        <div class="mt-2">
                            <span class="text-green-400"
                                >// Better - use class syntax:</span
                            >
                        </div>
                        <div>class Person {"{"}</div>
                        <div>
                            &nbsp;&nbsp;constructor(name) {"{"} this.name = name
                            {"}"}
                        </div>
                        <div>{"}"}</div>
                    </div>
                </div>

                <!-- Arguments object -->
                <div
                    class="bg-purple-900 rounded p-3"
                >
                    <div
                        class="text-purple-300 font-mono text-xs space-y-1"
                    >
                        <div class="text-yellow-400 mb-1">
                            Need `arguments` object (use rest params instead):
                        </div>
                        <div>function old() {"{"}</div>
                        <div>
                            &nbsp;&nbsp;console.log(arguments) <span
                                class="text-gray-400">// [all args]</span
                            >
                        </div>
                        <div>{"}"}</div>
                        <div class="mt-2">
                            <span class="text-green-400"
                                >// Better - use rest parameters:</span
                            >
                        </div>
                        <div>
                            const modern = (...args) =&gt; console.log(args)
                        </div>
                    </div>
                </div>

                <!-- Generators -->
                <div class="bg-cyan-900 rounded p-3">
                    <div class="text-cyan-300 font-mono text-xs space-y-1">
                        <div class="text-yellow-400 mb-1">
                            Generator functions (must use function*):
                        </div>
