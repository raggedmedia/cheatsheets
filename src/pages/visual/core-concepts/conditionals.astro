        </SectionTitle>

        <!-- AND (&&) -->
        <MethodCard
            id="and"
            methodName="AND (&&)"
            signature="value1 && value2"
            description="Return first falsy value, or last value if all truthy"
            mutates={false}
        >
            <div class="p-4 rounded border-t border-rule">
                <!-- Expression -->
                <div class="font-mono text-sm mb-4">
                    <span class="text-orange-300">value1</span>
                    <span class="text-purple-300 mx-2">&&</span>
                    <span class="text-orange-300">value2</span>
                </div>

                <!-- Evaluation logic -->
                <div class="space-y-2 text-xs">
                    <div
                        class="bg-orange-900 p-3 rounded"
                    >
                        <div class="text-orange-300 font-bold mb-1">
                            1. Evaluate left side (value1)
                        </div>
                        <div class="text-gray-300">
                            Check if truthy or falsy
                        </div>
                    </div>

                    <div class="flex items-center justify-center gap-4">
                        <div
                            class="bg-red-900 flex-1 p-2 rounded text-center"
                        >
                            <div
                                class="text-red-300 text-xs mb-1"
                            >
                                If falsy
                            </div>
                            <div class="text-gray-300 text-xs">
                                Return <strong>value1</strong>
                            </div>
                            <div class="text-gray-400 text-xs mt-1">
                                (short-circuit)
                            </div>
                        </div>
                        <div
                            class="bg-green-900 flex-1 p-2 rounded text-center"
                        >
                            <div
                                class="text-green-300 text-xs mb-1"
                            >
                                If truthy
                            </div>
                            <div class="text-gray-300 text-xs">
                                Return <strong>value2</strong>
                            </div>
                            <div class="text-gray-400 text-xs mt-1">
                                (evaluate & return)
                            </div>
                        </div>
                    </div>

                    <!-- Examples -->
                    <div class="mt-3 p-3 rounded space-y-1">
                        <div class="font-mono text-xs">
                            <span class="text-green-300">true</span>
                            <span class="text-purple-300">&&</span>
                            <span class="text-green-300">'hello'</span>
                            <span class="text-gray-400 ml-3">→ 'hello'</span>
                        </div>
                        <div class="font-mono text-xs">
                            <span class="text-red-300">false</span>
                            <span class="text-purple-300">&&</span>
                            <span class="text-green-300">'hello'</span>
                            <span class="text-gray-400 ml-3">→ false</span>
                        </div>
                        <div class="font-mono text-xs">
                            <span class="text-red-300">0</span>
                            <span class="text-purple-300">&&</span>
                            <span class="text-green-300">'hello'</span>
                            <span class="text-gray-400 ml-3">→ 0</span>
                        </div>
                    </div>
                </div>
            </div>

            <div
