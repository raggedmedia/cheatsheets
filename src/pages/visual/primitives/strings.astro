---
import MethodCard from "~components/visual-js/MethodCard.astro";
import Node from "~components/visual-js/Node.astro";
import ArrayDisplay from "~components/visual-js/ArrayDisplay.astro";
import Arrow from "~components/visual-js/Arrow.astro";
import ReturnValue from "~components/visual-js/ReturnValue.astro";
import MutableOrNot from "~components/visual-js/MutableOrNot.astro";
import ProcessContent from "~components/visual-js/ProcessContent.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Flow from "~components/visual-js/Flow.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Strings">
    <ProTip>
        <div>
            <strong>Strings are iterable.</strong> Strings (along with arrays,
            Maps and Sets) are one of the few iterable types in JavaScript.
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                <span class="text-green-400">// Works with for...of loops:</span
                >
            </div>
            <div class="font-mono text-xs">
                for (const char of "hello") {"{"} console.log(char) {"}"}
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-green-400"
                    >// Works with spread operator:</span
                >
            </div>
            <div class="font-mono text-xs">
                [...'hello'] → ['h', 'e', 'l', 'l', 'o']
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-red-400"
                    >// Objects are NOT iterable (need
                    Object.keys/values/entries)</span
                >
            </div>
        </div>
    </ProTip>

    <ProTip>
        <div>
            <strong>Strings are immutable.</strong> All methods return a new string.
            The original never changes.
        </div>
        <div
            class="pl-2 border-l border-rule font-mono text-xs mt-1"
        >
            const str = 'hello'<br />
            str.toUpperCase() <span class="text-red-400"
                >// returns 'HELLO' but str stays 'hello'</span
            ><br />
            const upper = str.toUpperCase() <Mark type="yes" /> <span class="text-gray-400"
                >// always save the result!</span
            >
        </div>
    </ProTip>

    <ProTip>
        <div>
            <strong>String length property:</strong> Get the number of characters
            with <code
                >str.length</code
            >
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">const text = "hello";</div>
            <div class="font-mono text-xs">text.length → 5</div>
            <div class="font-mono text-xs mt-1">
                <span class="text-orange-400"
                    >// Read-only! Can't change it:</span
                >
            </div>
            <div class="font-mono text-xs">
                text.length = 3 <span class="text-red-400"
                    >// doesn't work (strings immutable)</span
                >
            </div>
        </div>
    </ProTip>

    <!-- ============================================ -->
    <!-- INSPECT / CHECK -->
    <!-- ============================================ -->

    <SectionTitle id="inspect" color="blue"> Inspect / check </SectionTitle>

    <!-- CHARAT -->
    <MethodCard
        id="charAt"
        methodName="charAt()"
        signature="str.charAt(index)"
        description="Get character at position"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="access" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.charAt(1)"
                    description="Get char at index"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Character" type="output">
                <ReturnValue value="'e'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            > (length 1). <strong>Index starts at 0.</strong> Returns an empty string
            if the index is out of bounds.
        </MutableOrNot>
    </MethodCard>

    <!-- INCLUDES -->
    <MethodCard
        id="includes"
        methodName="includes()"
        signature="str.includes(substring)"
        description="Check if substring exists"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello world'</div>
            </Node>

            <Arrow label="search" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.includes('world')"
                    description="Contains substring?"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Boolean" type="output">
                <ReturnValue value="true" type="boolean" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >boolean</code
            >. <Mark type="warn" /> Cannot be chained. Case-sensitive.
        </MutableOrNot>
    </MethodCard>

    <!-- INDEXOF -->
    <MethodCard
        id="indexOf"
        methodName="indexOf()"
        signature="str.indexOf(substring)"
        description="Find index of first occurrence"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="search" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.indexOf('l')"
                    description="First 'l' position"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Index" type="output">
                <ReturnValue value="2" type="number" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >number</code
            > (index) or <code
                >-1</code
            > if not found. <Mark type="warn" /> Cannot be chained.
        </MutableOrNot>
    </MethodCard>

    <!-- LASTINDEXOF -->
    <MethodCard
        id="lastIndexOf"
        methodName="lastIndexOf()"
        signature="str.lastIndexOf(substring)"
        description="Find index of last occurrence"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="search" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.lastIndexOf('l')"
                    description="Last 'l' position"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Index" type="output">
                <ReturnValue value="3" type="number" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >number</code
            > (index) or <code
                >-1</code
            > if not found. <Mark type="warn" /> Cannot be chained. Searches from the end.
        </MutableOrNot>
    </MethodCard>

    <!-- STARTSWITH -->
    <MethodCard
        id="startsWith"
        methodName="startsWith()"
        signature="str.startsWith(substring)"
        description="Check if string starts with substring"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello world'</div>
            </Node>

            <Arrow label="check" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.startsWith('hello')"
                    description="Starts with?"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Boolean" type="output">
                <ReturnValue value="true" type="boolean" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >boolean</code
            >. <Mark type="warn" /> Cannot be chained.
        </MutableOrNot>
    </MethodCard>

    <!-- ENDSWITH -->
    <MethodCard
        id="endsWith"
        methodName="endsWith()"
        signature="str.endsWith(substring)"
        description="Check if string ends with substring"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello world'</div>
            </Node>

            <Arrow label="check" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.endsWith('world')"
                    description="Ends with?"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Boolean" type="output">
                <ReturnValue value="true" type="boolean" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >boolean</code
            >. <Mark type="warn" /> Cannot be chained. Opposite of <code
                >startsWith()</code
            >.
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- EXTRACT PIECES -->
    <!-- ============================================ -->

    <SectionTitle id="extract" color="purple"> Extract pieces </SectionTitle>

    <!-- SLICE -->
    <MethodCard
        id="slice"
        methodName="slice()"
        signature="str.slice(start, end?)"
        description="Extract substring by indexes"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello world'</div>
            </Node>

            <Arrow label="extract" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.slice(0, 5)"
                    description="From 0 to 5"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hello'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Accepts negative indexes (counts from the end).
        </MutableOrNot>

        <ProTip>
            <div><strong>Negative indexes count from the end:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    'hello'.slice(-2) → 'lo' <span class="text-gray-400"
                        >// last 2 chars</span
                    >
                </div>
                <div class="font-mono text-xs">
                    'hello'.slice(1, -1) → 'ell' <span class="text-gray-400"
                        >// remove first and last</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- SUBSTRING -->
    <MethodCard
        id="substring"
        methodName="substring()"
        signature="str.substring(start, end?)"
        description="Extract substring (swaps arguments if start is greater than end)"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="extract" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.substring(1, 4)"
                    description="From 1 to 4"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'ell'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Does not accept negative indexes. Prefer <code
                >slice()</code
            > for consistency.
        </MutableOrNot>
    </MethodCard>

    <!-- SPLIT -->
    <MethodCard
        id="split"
        methodName="split()"
        signature="str.split(separator)"
        description="Break string into array"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'a,b,c'</div>
            </Node>

            <Arrow label="split by" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.split(',')"
                    description="Split on comma"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >array</code
            > of strings. <Mark type="warn" /> Cannot be chained with string methods.
        </MutableOrNot>

        <ProTip>
            <div>Common patterns:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    'hello'.split('') → ['h','e','l','l','o'] <span
                        class="text-gray-400">// split into chars</span
                    >
                </div>
                <div class="font-mono text-xs">
                    'a b c'.split(' ') → ['a','b','c'] <span
                        class="text-gray-400">// split on space</span
                    >
                </div>
                <div class="font-mono text-xs">
                    Array.from('hello') <span class="text-green-400"
                        >// better for Unicode (emoji safe)</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- CHANGE CASE -->
    <!-- ============================================ -->

    <SectionTitle id="case" color="orange"> Change case </SectionTitle>

    <!-- TOUPPERCASE -->
    <MethodCard
        id="toUpperCase"
        methodName="toUpperCase()"
        signature="str.toUpperCase()"
        description="Convert to uppercase"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="convert" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.toUpperCase()"
                    description="Make uppercase"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'HELLO'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Converts all characters to uppercase.
        </MutableOrNot>
    </MethodCard>

    <!-- TOLOWERCASE -->
    <MethodCard
        id="toLowerCase"
        methodName="toLowerCase()"
        signature="str.toLowerCase()"
        description="Convert to lowercase"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'HELLO'</div>
            </Node>

            <Arrow label="convert" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.toLowerCase()"
                    description="Make lowercase"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hello'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Converts all characters to lowercase.
        </MutableOrNot>
    </MethodCard>

    <!-- CAPITALIZE WORDS -->
    <MethodCard
        id="capitalize"
        methodName="Capitalize words"
        signature="str.replace(/\\b\\w/g, c => c.toUpperCase())"
        description="Capitalise first letter of each word"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello world'</div>
            </Node>

            <Arrow label="transform" />

            <Node label="Regex Replace" type="process">
                <ProcessContent
                    name="replace(/\\b\\w/g, ...)"
                    description="Capitalise each word"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'Hello World'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. No built-in method does this. Use a regex.
        </MutableOrNot>

        <ProTip>
            <div>Breaking down the regex:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    \b <span class="text-gray-400">// word boundary</span>
                </div>
                <div class="font-mono text-xs">
                    \w <span class="text-gray-400"
                        >// first character of word</span
                    >
                </div>
                <div class="font-mono text-xs">
                    /g <span class="text-gray-400">// global (all matches)</span
                    >
                </div>
                <div class="font-mono text-xs">
                    c =&gt; c.toUpperCase() <span class="text-gray-400"
                        >// capitalize it</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- TRIM / PAD -->
    <!-- ============================================ -->

    <SectionTitle id="trim-pad" color="green"> Trim / pad </SectionTitle>

    <!-- TRIM -->
    <MethodCard
        id="trim"
        methodName="trim()"
        signature="str.trim()"
        description="Remove whitespace from both ends"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">' hello '</div>
            </Node>

            <Arrow label="clean" />

            <Node label="Method" type="process">
                <ProcessContent name="str.trim()" description="Remove spaces" />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hello'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Use <code
                >trimStart()</code
            > or <code
                >trimEnd()</code
            > for one side only.
        </MutableOrNot>
    </MethodCard>

    <!-- PADSTART -->
    <MethodCard
        id="padStart"
        methodName="padStart()"
        signature="str.padStart(targetLength, padString)"
        description="Pad string to target length (adds padding to the left)"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'5'</div>
            </Node>

            <Arrow label="pad" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.padStart(3, '0')"
                    description="Pad left with 0s"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'005'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Use <code
                >padEnd()</code
            > for right padding.
        </MutableOrNot>

        <ProTip>
            <div>Common uses:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Time formatting: display '5' as '05' in times like
                        05:30</span
                    >
                </div>
                <div class="font-mono text-xs">
                    '5'.padStart(2, '0') → '05'
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Leading zeros for IDs/invoice numbers</span
                    >
                </div>
                <div class="font-mono text-xs">
                    '123'.padStart(6, '0') → '000123'
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- PADEND -->
    <MethodCard
        id="padEnd"
        methodName="padEnd()"
        signature="str.padEnd(targetLength, padString)"
        description="Pad string to target length (adds padding to the right)"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hi'</div>
            </Node>

            <Arrow label="pad" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.padEnd(5, '.')"
                    description="Pad right with dots"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hi...'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. The opposite of <code
                >padStart()</code
            >.
        </MutableOrNot>

        <ProTip>
            <div>
                <strong>Use it to build tables or align text:</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    'Name'.padEnd(10, ' ') + 'Age' → 'Name&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Age'
                </div>
                <div class="font-mono text-xs">
                    'Task'.padEnd(20, '.') + 'Done' → 'Task................Done'
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- MANIPULATION -->
    <!-- ============================================ -->

    <SectionTitle id="manipulation" color="red"> Manipulation </SectionTitle>

    <!-- CONCAT -->
    <MethodCard
        id="concat"
        methodName="concat()"
        signature="str.concat(str2, str3, ...)"
        description="Join strings together"
        mutates={false}
    >
        <Flow>
            <Node label="Input Strings" type="input">
                <div class="text-center text-sm font-mono">
                    'hello', ' ', 'world'
                </div>
            </Node>

            <Arrow label="join" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.concat(' ', 'world')"
                    description="Concatenate"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hello world'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Prefer template literals <code
                >`${"{"}a{"}"} ${"{"}b{"}"}`</code
            > for readability.
        </MutableOrNot>
    </MethodCard>

    <!-- REPEAT -->
    <MethodCard
        id="repeat"
        methodName="repeat()"
        signature="str.repeat(count)"
        description="Repeat string n times"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'ha'</div>
            </Node>

            <Arrow label="repeat" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.repeat(3)"
                    description="Repeat 3 times"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hahaha'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Useful for creating patterns or dividers.
        </MutableOrNot>
    </MethodCard>

    <!-- REPLACE -->
    <MethodCard
        id="replace"
        methodName="replace()"
        signature="str.replace(search, replacement)"
        description="Replace first match"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello hello'</div>
            </Node>

            <Arrow label="replace" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.replace('hello', 'hi')"
                    description="First match only"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'hi hello'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Only replaces the first match. Use <code
                >replaceAll()</code
            > for all matches.
        </MutableOrNot>

        <ProTip>
            <div><Mark type="warn" /> <strong>Gotcha:</strong> Only replaces the first match.</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    'a a a'.replace('a', 'b') → 'b a a' <span
                        class="text-red-400">// only first!</span
                    >
                </div>
                <div class="font-mono text-xs">
                    'a a a'.replaceAll('a', 'b') → 'b b b' <Mark type="yes" /> <span
                        class="text-green-400">// all matches</span
                    >
                </div>
                <div class="font-mono text-xs">
                    'a a a'.replace(/a/g, 'b') → 'b b b' <Mark type="yes" /> <span
                        class="text-gray-400">// regex global flag</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- REPLACEALL -->
    <MethodCard
        id="replaceAll"
        methodName="replaceAll()"
        signature="str.replaceAll(search, replacement)"
        description="Replace all matches"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'a a a'</div>
            </Node>

            <Arrow label="replace" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.replaceAll('a', 'b')"
                    description="All matches"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'b b b'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Replaces all matches. Modern browsers only (ES2021).
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- PATTERN MATCHING -->
    <!-- ============================================ -->

    <SectionTitle id="pattern" color="pink"> Pattern matching </SectionTitle>

    <!-- MATCH -->
    <MethodCard
        id="match"
        methodName="match()"
        signature="str.match(regex)"
        description="Find matches using regex"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello123'</div>
            </Node>

            <Arrow label="match" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.match(/\d+/g)"
                    description="Find all digits"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array or null" type="output">
                <ArrayDisplay values={["123"]} />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >array</code
            > of matches or <code
                >null</code
            >. <Mark type="warn" /> Cannot be chained.
        </MutableOrNot>
    </MethodCard>

    <!-- SEARCH -->
    <MethodCard
        id="search"
        methodName="search()"
        signature="str.search(regex)"
        description="Find index of first regex match"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello123'</div>
            </Node>

            <Arrow label="search" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="str.search(/\d/)"
                    description="First digit position"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Index" type="output">
                <ReturnValue value="5" type="number" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >number</code
            > (index) or <code
                >-1</code
            > if not found. <Mark type="warn" /> Cannot be chained.
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- CONVERTING TO STRINGS -->
    <!-- ============================================ -->

    <SectionTitle id="converting" color="yellow">
        Converting to strings
    </SectionTitle>

    <!-- ARRAY TO STRING -->
    <MethodCard
        id="array-to-string"
        methodName="Array to string"
        signature="arr.join(separator)"
        description="Convert array to string with separator"
        mutates={false}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>

            <Arrow label="join" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="arr.join(',')"
                    description="Join with comma"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="String" type="output">
                <ReturnValue value="'a,b,c'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. The default separator is a comma. Use <code
                >''</code
            > to join without a separator.
        </MutableOrNot>

        <ProTip>
            <div>Common use cases:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    ['a','b','c'].join(', ') → 'a, b, c' <span
                        class="text-gray-400">// comma + space</span
                    >
                </div>
                <div class="font-mono text-xs">
                    ['hi','there'].join(' ') → 'hi there' <span
                        class="text-gray-400">// words with spaces</span
                    >
                </div>
                <div class="font-mono text-xs">
                    ['h','i'].join('') → 'hi' <span class="text-gray-400"
                        >// no separator</span
                    >
                </div>
                <div class="font-mono text-xs">
                    arr.toString() → 'a,b,c' <span class="text-gray-400"
                        >// same as join() with comma</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- NUMBER TO STRING -->
    <MethodCard
        id="number-to-string"
        methodName="Number to string"
        signature="String(num) or num.toString()"
        description="Convert number to string"
        mutates={false}
    >
        <Flow>
            <Node label="Input Number" type="input">
                <div class="text-center text-sm font-mono">123</div>
            </Node>

            <Arrow label="convert" />

            <Node label="Method" type="process">
                <ProcessContent name="String(123)" description="To string" />
            </Node>

            <Arrow label="returns" />

            <Node label="String" type="output">
                <ReturnValue value="'123'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. Both <code
                >String(num)</code
            > and <code
                >num.toString()</code
            > work.
        </MutableOrNot>

        <ProTip>
            <div>Three ways to convert numbers:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    String(123) → '123' <Mark type="yes" /> <span class="text-gray-400"
                        >// recommended</span
                    >
                </div>
                <div class="font-mono text-xs">
                    (123).toString() → '123' <Mark type="yes" /> <span class="text-gray-400"
                        >// works too</span
                    >
                </div>
                <div class="font-mono text-xs">
                    '' + 123 → '123' <span class="text-gray-400"
                        >// quick but less readable</span
                    >
                </div>
                <div class="font-mono text-xs mt-1">
                    (42).toString(2) → '101010' <span class="text-green-400"
                        >// binary! (base 2)</span
                    >
                </div>
                <div class="font-mono text-xs">
                    (255).toString(16) → 'ff' <span class="text-green-400"
                        >// hexadecimal! (base 16)</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OBJECT TO STRING -->
    <MethodCard
        id="object-to-string"
        methodName="Object to string"
        signature="JSON.stringify(obj)"
        description="Convert object to JSON string"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>

            <Arrow label="stringify" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="JSON.stringify(obj)"
                    description="To JSON string"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="JSON String" type="output">
                <ReturnValue value='{"a":1,"b":2}' type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            > (JSON format). Use it for serialisation, API requests and localStorage.
        </MutableOrNot>

        <ProTip>
            <div>Formatting options:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    JSON.stringify(obj) → '{"{"}"a":1{"}"}' <span
                        class="text-gray-400">// compact</span
                    >
                </div>
                <div class="font-mono text-xs">
                    JSON.stringify(obj, null, 2) <span class="text-gray-400"
                        >// pretty-print with 2-space indent</span
                    >
                </div>
                <div class="text-xs mt-1">
                    <span class="text-red-400"
                        ><Mark type="warn" /> Skips functions, <code>undefined</code> and symbols.</span
                    >
                </div>
                <div class="text-xs">
                    <span class="text-red-400"
                        ><Mark type="warn" /> Circular references throw a <code>TypeError</code>.</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- COMMON PATTERNS -->
    <!-- ============================================ -->

    <SectionTitle id="patterns" color="cyan"> Common patterns </SectionTitle>

    <!-- PREPEND/APPEND -->
    <MethodCard
        id="prepend-append"
        methodName="Prepend / append"
        signature="`prefix${str}suffix`"
        description="Add text before or after a string"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="wrap" />

            <Node label="Template Literal" type="process">
                <ProcessContent
                    name="`#${str}-end`"
                    description="Add prefix and suffix"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New String" type="output">
                <ReturnValue value="'#hello-end'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. No built-in prepend or append. Use template literals or <code
                >concat()</code
            >.
        </MutableOrNot>

        <ProTip>
            <div>Common use cases:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    `#${"{"}hashtag{"}"}` <span class="text-gray-400"
                        >// add # prefix</span
                    >
                </div>
                <div class="font-mono text-xs">
                    `${"{"}url{"}"}?v=123` <span class="text-gray-400"
                        >// add query param</span
                    >
                </div>
                <div class="font-mono text-xs">
                    `${"{"}name{"}"}.js` <span class="text-gray-400"
                        >// add file extension</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- REVERSE STRING -->
    <MethodCard
        id="reverse"
        methodName="Reverse string"
        signature="str.split('').reverse().join('')"
        description="Reverse character order"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">'hello'</div>
            </Node>

            <Arrow label="split" />

            <Node label="Step 1" type="process">
                <ProcessContent
                    name=".split('')"
                    description="['h','e','l','l','o']"
                />
            </Node>

            <Arrow label="reverse" />

            <Node label="Step 2" type="process">
                <ProcessContent
                    name=".reverse()"
                    description="['o','l','l','e','h']"
                />
            </Node>

            <Arrow label="join" />

            <Node label="Result" type="output">
                <ReturnValue value="'olleh'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >string</code
            >. No built-in reverse. Chain array methods instead.
        </MutableOrNot>

        <ProTip>
            <div>
                <Mark type="warn" /> <strong>Not Unicode-safe.</strong> Use for simple ASCII only:
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    'hello'.split('').reverse().join('') → 'olleh' <Mark type="yes" />
                </div>
                <div class="font-mono text-xs">
                    '👨‍👩‍👧'.split('').reverse().join('') <span class="text-red-400"
                        >// breaks emoji! <Mark type="no" /></span
                    >
                </div>
                <div class="font-mono text-xs">
                    Array.from('👨‍👩‍👧').reverse().join('') <span
                        class="text-green-400">// better for Unicode</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- CHECK IF EMPTY -->
    <MethodCard
        id="is-empty"
        methodName="Check if empty"
        signature="str.trim() === ''"
        description="Check if string is empty or only whitespace"
        mutates={false}
    >
        <Flow>
            <Node label="Input String" type="input">
                <div class="text-center text-sm font-mono">' '</div>
            </Node>

            <Arrow label="check" />

            <Node label="Pattern" type="process">
                <ProcessContent
                    name="str.trim() === ''"
                    description="Empty after trim?"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Boolean" type="output">
                <ReturnValue value="true" type="boolean" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >boolean</code
            >. Trim first to catch whitespace-only strings.
        </MutableOrNot>

        <ProTip>
            <div>Different empty checks:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    str === '' <span class="text-gray-400">// truly empty</span>
                </div>
                <div class="font-mono text-xs">
                    str.length === 0 <span class="text-gray-400"
                        >// same as above</span
                    >
                </div>
                <div class="font-mono text-xs">
                    str.trim() === '' <span class="text-gray-400"
                        >// empty or whitespace only</span
                    >
                </div>
                <div class="font-mono text-xs">
                    !str <span class="text-gray-400"
                        >// falsy (includes empty string)</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

