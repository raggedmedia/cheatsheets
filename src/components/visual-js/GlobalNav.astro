---
import { groups } from "../../lib/topics";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<nav aria-label="Cheatsheets">
    <a href="/" class="flex items-center gap-2.5 mb-6 text-ink no-underline">
        <img src="/gideon-skull.svg" alt="" class="size-7" />
        <span class="font-extrabold text-sm tracking-wide uppercase"
            >Visual cheatsheets</span
        >
    </a>

    {
        groups.map((group) => (
            <div class="mb-5">
                <div class="flex items-center gap-2 mb-1.5 text-xs font-semibold uppercase tracking-wide text-gray-400">
                    <span class={`size-2.5 ${group.swatch}`} />
                    {group.name}
                </div>
                <ul>
                    {group.topics.map((topic) => (
                        <li>
                            <a
                                href={topic.href}
                                aria-current={isActive(topic.href) ? "page" : undefined}
                                class={`block px-2 py-[3px] text-sm no-underline ${
                                    isActive(topic.href)
                                        ? `${group.swatch} ${group.onSwatch} font-semibold`
                                        : "text-ink hover:bg-black/30"
                                }`}
                            >
                                {topic.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))
    }
</nav>
