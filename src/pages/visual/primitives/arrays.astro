    <!-- FOREACH -->
    <MethodCard
        id="forEach"
        methodName="forEach()"
        signature="arr.forEach(fn)"
        description="Runs a function for each array element"
        mutates={false}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>

            <Arrow label="iterates" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="forEach(console.log)"
                    description="Run function on each"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ReturnValue value="undefined" type="undefined" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Always returns <code
                >undefined</code
            >. Cannot be chained. Use for side effects only.
        </MutableOrNot>

        <ProTip>
            <div>
                For large arrays (10,000+ items), regular <code
                    >for</code
                > loops are faster:
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5">
                <div class="font-mono text-xs">
                    for (let i = 0; i &lt; arr.length; i++) {"{"} ... {"}"}
                    <span class="text-gray-400">// fastest</span>
                </div>
                <div class="font-mono text-xs">
                    arr.forEach(item =&gt; {"{"} ... {"}"}) <span
                        class="text-gray-400">// cleaner, slightly slower</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

