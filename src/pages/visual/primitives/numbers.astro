---
import MethodCard from "~components/visual-js/MethodCard.astro";
import Node from "~components/visual-js/Node.astro";
import Arrow from "~components/visual-js/Arrow.astro";
import ReturnValue from "~components/visual-js/ReturnValue.astro";
import MutableOrNot from "~components/visual-js/MutableOrNot.astro";
import ProcessContent from "~components/visual-js/ProcessContent.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Flow from "~components/visual-js/Flow.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Numbers">
    <ProTip>
        <div>
            <strong>Numbers are immutable.</strong> All methods return a new value.
            The original never changes.
        </div>
        <div
            class="pl-2 border-l border-rule font-mono text-xs mt-1"
        >
            const num = 3.14159<br />
            num.toFixed(2) <span class="text-red-400"
                >// returns '3.14' but num stays 3.14159</span
            ><br />
            const rounded = num.toFixed(2) <Mark type="yes" /> <span class="text-gray-400"
                >// always save the result!</span
            >
        </div>
    </ProTip>

    <ProTip>
        <div>
            <strong>Why is JavaScript bad at maths?</strong> Computers store numbers
            in binary (1s and 0s), not decimals.
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                0.1 + 0.2 === 0.3 <span class="text-red-400"
                    >// false! <Mark type="no" /> (0.30000000000000004)</span>
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-gray-400"
                    >// In binary, 0.1 = 0.00011001100110011... (infinite
                    repeat)</span>
            </div>
            <div class="font-mono text-xs">
                <span class="text-gray-400"
                    >// Computer cuts it off → tiny rounding error</span>
            </div>
            <div class="font-mono text-xs">
                <span class="text-gray-400"
                    >// 0.1 + 0.2 = two tiny errors combined = 0.30000...4</span>
            </div>
            <div class="font-mono text-xs mt-1">
                Number.MAX_SAFE_INTEGER <span class="text-gray-400"
                    >// 9007199254740991</span>
            </div>
            <div class="font-mono text-xs">
                <span class="text-yellow-400"
                    >// Above this, integers skip numbers (9007199254740992 =
                    9007199254740993)</span>
            </div>
        </div>
    </ProTip>

    <ProTip>
        <div>
            <strong>NaN means 'not a number'</strong>, but <code
                >typeof NaN === "number"</code
            > 
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                NaN === NaN <span class="text-red-400"
                    >// false <Mark type="no" /> (only value not equal to itself!)</span>
            </div>
            <div class="font-mono text-xs">
                Number.isNaN(NaN) <span class="text-green-400"
                    >// true <Mark type="yes" /> (use this!)</span>
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-gray-400">// When does NaN appear?</span>
            </div>
            <div class="font-mono text-xs">
                0 / 0 <span class="text-gray-400">// NaN (invalid math)</span>
            </div>
            <div class="font-mono text-xs">
                Math.sqrt(-1) <span class="text-gray-400"
                    >// NaN (impossible)</span>
            </div>
            <div class="font-mono text-xs">
                parseInt('hello') <span class="text-gray-400"
                    >// NaN (failed parse)</span>
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-yellow-400"
                    >// It's JavaScript's "math operation failed" signal</span>
            </div>
        </div>
    </ProTip>

    <!-- ============================================ -->
    <!-- PARSING & CONVERTING -->
    <!-- ============================================ -->
    <SectionTitle id="parsing" color="blue">
        Parsing & converting
    </SectionTitle>

    <!-- PARSEINT -->
    <MethodCard
        id="parse-int"
        methodName="parseInt()"
        signature="parseInt(string, radix?)"
        description="Parse a string and return an integer"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono">'42px'</div>
            </Node>

            <Arrow label="parse" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="parseInt('42px')"
                    description="Extract digits"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <ReturnValue value="42" type="number" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Parses until it reaches a non-digit. Returns <code
                >NaN</code
            > if it finds no valid digits.
        </MutableOrNot>

        <ProTip>
            <div><Mark type="warn" /> <strong>Always set the radix (base 10):</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    parseInt('10') <span class="text-gray-400">// 10</span>
                </div>
                <div class="font-mono text-xs">
                    parseInt('10', 10) <span class="text-green-400"
                        >// 10 <Mark type="yes" /> explicit</span>
                </div>
                <div class="font-mono text-xs">
                    parseInt('0x10') <span class="text-gray-400"
                        >// 16 (hex)</span>
                </div>
                <div class="font-mono text-xs">
                    parseInt('08') <span class="text-gray-400"
                        >// 8 (but was 0 in old browsers!)</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    parseInt('42px') <span class="text-gray-400">// 42</span>
                </div>
                <div class="font-mono text-xs">
                    parseInt('px42') <span class="text-red-400"
                        >// NaN (starts with non-digit)</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- PARSEFLOAT -->
    <MethodCard
        id="parse-float"
        methodName="parseFloat()"
        signature="parseFloat(string)"
        description="Parse a string and return a floating-point number"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono">'3.14rem'</div>
            </Node>

            <Arrow label="parse" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="parseFloat('3.14rem')"
                    description="Extract decimal"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <ReturnValue value="3.14" type="number" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Like <code
                >parseInt</code
            >, but keeps the decimal point.
        </MutableOrNot>

        <ProTip>
            <div>Examples:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    parseFloat('3.14') <span class="text-gray-400"
                        >// 3.14</span>
                </div>
                <div class="font-mono text-xs">
                    parseFloat('3.14.15') <span class="text-gray-400"
                        >// 3.14 (stops at 2nd dot)</span>
                </div>
                <div class="font-mono text-xs">
                    parseFloat(' 3.14 ') <span class="text-gray-400"
                        >// 3.14 (trims whitespace)</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- NUMBER() CONSTRUCTOR -->
    <MethodCard
        id="number-constructor"
        methodName="Number()"
        signature="Number(value)"
        description="Convert any value to a number"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono space-y-1">
                    <div>'42'</div>
                    <div>true</div>
                    <div>null</div>
                    <div>undefined</div>
                    <div>'42px'</div>
                </div>
            </Node>

            <Arrow label="convert" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Number(value)"
                    description="Type coercion"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <div class="text-center text-sm font-mono space-y-1">
                    <div class="text-green-400">42</div>
                    <div class="text-green-400">1</div>
                    <div class="text-green-400">0</div>
                    <div class="text-red-400">NaN</div>
                    <div class="text-red-400">NaN</div>
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Stricter than <code
                >parseInt</code
            >. The entire string must be a valid number.
        </MutableOrNot>

        <ProTip>
            <div><strong>The unary + operator does the same:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    Number('42') <span class="text-gray-400">// 42</span>
                </div>
                <div class="font-mono text-xs">
                    +'42' <span class="text-gray-400">// 42 (shorthand)</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    Number('42px') <span class="text-red-400">// NaN</span>
                </div>
                <div class="font-mono text-xs">
                    parseInt('42px') <span class="text-green-400"
                        >// 42 <Mark type="yes" /></span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- CHECKING & VALIDATION -->
    <!-- ============================================ -->

    <SectionTitle id="checking" color="purple">
        Checking & validation
    </SectionTitle>

    <!-- NUMBER.ISNAN -->
    <MethodCard
        id="is-nan"
        methodName="Number.isNaN()"
        signature="Number.isNaN(value)"
        description="Check if a value is NaN (not a number)"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono space-y-1">
                    <div>NaN</div>
                    <div>'hello'</div>
                    <div>42</div>
                </div>
            </Node>

            <Arrow label="check" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Number.isNaN()"
                    description="Strict NaN check"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <div class="text-center text-sm font-mono space-y-1">
                    <div class="text-green-400">true <Mark type="yes" /></div>
                    <div class="text-red-400">false <Mark type="no" /></div>
                    <div class="text-red-400">false <Mark type="no" /></div>
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Only returns <code
                >true</code
            > if the value is actually <code
                >NaN</code
            >.
        </MutableOrNot>

        <ProTip>
            <div><Mark type="warn" /> <strong>Don't use global isNaN():</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-red-400"
                        >// Global isNaN() coerces to number first <Mark type="no" /></span>
                </div>
                <div class="font-mono text-xs">
                    isNaN('hello') <span class="text-gray-400"
                        >// true (coerces to NaN)</span>
                </div>
                <div class="font-mono text-xs">
                    isNaN(undefined) <span class="text-gray-400"
                        >// true (coerces to NaN)</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-green-400"
                        >// Number.isNaN() is strict <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs">
                    Number.isNaN('hello') <span class="text-gray-400"
                        >// false (not NaN)</span>
                </div>
                <div class="font-mono text-xs">
                    Number.isNaN(NaN) <span class="text-gray-400">// true</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- NUMBER.ISINTEGER -->
    <MethodCard
        id="is-integer"
        methodName="Number.isInteger()"
        signature="Number.isInteger(value)"
        description="Check if a value is an integer"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono space-y-1">
                    <div>42</div>
                    <div>42.0</div>
                    <div>42.5</div>
                </div>
            </Node>

            <Arrow label="check" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Number.isInteger()"
                    description="Whole number?"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <div class="text-center text-sm font-mono space-y-1">
                    <div class="text-green-400">true <Mark type="yes" /></div>
                    <div class="text-green-400">true <Mark type="yes" /></div>
                    <div class="text-red-400">false <Mark type="no" /></div>
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >true</code
            > if the value is a number with no fractional part.
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- MATH OPERATIONS -->
    <!-- ============================================ -->

    <SectionTitle id="math" color="green"> Math operations </SectionTitle>

    <!-- MATH.ROUND/FLOOR/CEIL -->
    <MethodCard
        id="rounding"
        methodName="Math.round() / floor() / ceil()"
        signature="Math.round/floor/ceil(number)"
        description="Round numbers to integers"
        mutates={false}
    >
        <div class="space-y-4">
            <!-- Math.floor -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">3.7</div>
                </Node>

                <Arrow label="floor ↓" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.floor(3.7)"
                        description="Round down"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="3" type="number" />
                </Node>
            </Flow>

            <!-- Math.round -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">3.7</div>
                </Node>

                <Arrow label="round" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.round(3.7)"
                        description="Round to nearest"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="4" type="number" />
                </Node>
            </Flow>

            <!-- Math.ceil -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">3.7</div>
                </Node>

                <Arrow label="ceil ↑" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.ceil(3.7)"
                        description="Round up"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="4" type="number" />
                </Node>
            </Flow>
        </div>

        <MutableOrNot mutates={false} message="">
            <strong>floor</strong> = down, <strong>round</strong> = nearest, <strong
                >ceil</strong
            > = up (ceiling). All return integers.
        </MutableOrNot>

        <ProTip>
            <div>Round to decimal places:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    Math.round(3.14159 * 100) / 100 <span class="text-gray-400"
                        >// 3.14</span>
                </div>
                <div class="font-mono text-xs">
                    (3.14159).toFixed(2) <span class="text-gray-400"
                        >// '3.14' (string)</span>
                </div>
                <div class="font-mono text-xs">
                    Number((3.14159).toFixed(2)) <span class="text-gray-400"
                        >// 3.14 (number)</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.TRUNC -->
    <MethodCard
        id="trunc"
        methodName="Math.trunc()"
        signature="Math.trunc(number)"
        description="Remove the decimal part (truncate)"
        mutates={false}
    >
        <div class="space-y-4">
            <!-- Positive -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">3.7</div>
                </Node>

                <Arrow label="truncate" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.trunc(3.7)"
                        description="Chop decimals"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="3" type="number" />
                </Node>
            </Flow>

            <!-- Negative -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">-3.7</div>
                </Node>

                <Arrow label="truncate" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.trunc(-3.7)"
                        description="Chop decimals"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="-3" type="number" />
                </Node>
            </Flow>
        </div>

        <MutableOrNot mutates={false} message="">
            Removes everything after the decimal point. Always rounds
            towards zero (unlike <code
                >floor()</code
            >).
        </MutableOrNot>

        <ProTip>
            <div><strong>Difference from floor:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    Math.trunc(3.7) → 3 <span class="text-gray-400"
                        >// same as floor</span>
                </div>
                <div class="font-mono text-xs">Math.floor(3.7) → 3</div>
                <div class="font-mono text-xs mt-1">
                    Math.trunc(-3.7) → -3 <span class="text-green-400"
                        >// toward zero</span>
                </div>
                <div class="font-mono text-xs">
                    Math.floor(-3.7) → -4 <span class="text-yellow-400"
                        >// always down</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.ABS -->
    <MethodCard
        id="abs"
        methodName="Math.abs()"
        signature="Math.abs(number)"
        description="Get the absolute value (remove the negative sign)"
        mutates={false}
    >
        <div class="space-y-4">
            <!-- Negative -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">-42</div>
                </Node>

                <Arrow label="absolute" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.abs(-42)"
                        description="Remove sign"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="42" type="number" />
                </Node>
            </Flow>

            <!-- Positive -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">42</div>
                </Node>

                <Arrow label="absolute" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.abs(42)"
                        description="Already positive"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="42" type="number" />
                </Node>
            </Flow>
        </div>

        <MutableOrNot mutates={false} message="">
            Returns the distance from zero. Always positive (or zero).
        </MutableOrNot>

        <ProTip>
            <div>Common use cases:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Calculate distance between two points</span>
                </div>
                <div class="font-mono text-xs">
                    Math.abs(x1 - x2) <span class="text-gray-400"
                        >// distance on number line</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Get magnitude regardless of direction</span>
                </div>
                <div class="font-mono text-xs">
                    const speed = Math.abs(velocity)
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.SIGN -->
    <MethodCard
        id="sign"
        methodName="Math.sign()"
        signature="Math.sign(number)"
        description="Get the sign of a number (-1, 0, or 1)"
        mutates={false}
    >
        <div class="space-y-4">
            <!-- Positive -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">42</div>
                </Node>

                <Arrow label="sign" />

                <Node label="Result" type="output">
                    <ReturnValue value="1" type="number" />
                </Node>
            </Flow>

            <!-- Negative -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">-42</div>
                </Node>

                <Arrow label="sign" />

                <Node label="Result" type="output">
                    <ReturnValue value="-1" type="number" />
                </Node>
            </Flow>

            <!-- Zero -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">0</div>
                </Node>

                <Arrow label="sign" />

                <Node label="Result" type="output">
                    <ReturnValue value="0" type="number" />
                </Node>
            </Flow>
        </div>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >1</code
            > for positive, <code
                >-1</code
            > for negative, <code
                >0</code
            > for zero.
        </MutableOrNot>

        <ProTip>
            <div>Useful for animation and game development:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Flip sprite based on movement direction</span>
                </div>
                <div class="font-mono text-xs">
                    sprite.scaleX = Math.sign(velocity.x) <span
                        class="text-gray-400">// -1 or 1</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Preserve direction while clamping magnitude</span>
                </div>
                <div class="font-mono text-xs">
                    const clamped = Math.sign(v) * Math.min(Math.abs(v), max)
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.POW -->
    <MethodCard
        id="pow"
        methodName="Math.pow() / **"
        signature="Math.pow(base, exponent) or base ** exponent"
        description="Raise a number to a power (exponentiation)"
        mutates={false}
    >
        <div class="space-y-4">
            <!-- Square -->
            <Flow>
                <Node label="Base" type="input">
                    <div class="text-center text-sm font-mono">5</div>
                </Node>

                <Arrow label="²" />

                <Node label="Method" type="process">
                    <ProcessContent name="5 ** 2" description="5 squared" />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="25" type="number" />
                </Node>
            </Flow>

            <!-- Cube -->
            <Flow>
                <Node label="Base" type="input">
                    <div class="text-center text-sm font-mono">2</div>
                </Node>

                <Arrow label="³" />

                <Node label="Method" type="process">
                    <ProcessContent name="2 ** 3" description="2 cubed" />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="8" type="number" />
                </Node>
            </Flow>
        </div>

        <MutableOrNot mutates={false} message="">
            Prefer the <code
                >**</code
            > operator over <code
                >Math.pow()</code
            > (cleaner syntax).
        </MutableOrNot>

        <ProTip>
            <div>Common patterns:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    x ** 2 <span class="text-gray-400">// square (x²)</span>
                </div>
                <div class="font-mono text-xs">
                    x ** 3 <span class="text-gray-400">// cube (x³)</span>
                </div>
                <div class="font-mono text-xs">
                    2 ** 8 <span class="text-gray-400"
                        >// 256 (powers of 2)</span>
                </div>
                <div class="font-mono text-xs">
                    10 ** 6 <span class="text-gray-400"
                        >// 1000000 (scientific)</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Fractional exponents = roots!</span>
                </div>
                <div class="font-mono text-xs">
                    x ** 0.5 <span class="text-gray-400"
                        >// same as Math.sqrt(x)</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.SQRT -->
    <MethodCard
        id="sqrt"
        methodName="Math.sqrt()"
        signature="Math.sqrt(number)"
        description="Calculate square root"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono">25</div>
            </Node>

            <Arrow label="√" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Math.sqrt(25)"
                    description="Square root"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <ReturnValue value="5" type="number" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >NaN</code
            > for negative numbers. Undoes squaring for non-negative x, since √(x²) = |x|.
        </MutableOrNot>

        <ProTip>
            <div>Common use: distance formula (Pythagorean theorem):</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Distance between two points</span>
                </div>
                <div class="font-mono text-xs">const dx = x2 - x1</div>
                <div class="font-mono text-xs">const dy = y2 - y1</div>
                <div class="font-mono text-xs">
                    const distance = Math.sqrt(dx**2 + dy**2) <Mark type="yes" />
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-yellow-400"
                        >// Pro tip: avoid sqrt if you only need to compare
                        distances</span>
                </div>
                <div class="font-mono text-xs">
                    if (dx**2 + dy**2 &lt; radius**2) <span
                        class="text-gray-400">// faster!</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.MIN/MAX -->
    <MethodCard
        id="min-max"
        methodName="Math.min() / Math.max()"
        signature="Math.min/max(...numbers)"
        description="Find the smallest or largest number"
        mutates={false}
    >
        <div class="space-y-4">
            <!-- Math.max -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">5, 2, 8, 1</div>
                </Node>

                <Arrow label="compare" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.max(5, 2, 8, 1)"
                        description="Find largest"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="8" type="number" />
                </Node>
            </Flow>

            <!-- Math.min -->
            <Flow>
                <Node label="Input" type="input">
                    <div class="text-center text-sm font-mono">5, 2, 8, 1</div>
                </Node>

                <Arrow label="compare" />

                <Node label="Method" type="process">
                    <ProcessContent
                        name="Math.min(5, 2, 8, 1)"
                        description="Find smallest"
                    />
                </Node>

                <Arrow label="returns" />

                <Node label="Result" type="output">
                    <ReturnValue value="1" type="number" />
                </Node>
            </Flow>
        </div>

        <MutableOrNot mutates={false} message="">
            Takes multiple arguments. Use the spread operator <code
                >...</code
            > to find the min or max of an array.
        </MutableOrNot>

        <ProTip>
            <div>Common use cases:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Clamp value between min and max</span>
                </div>
                <div class="font-mono text-xs">
                    Math.min(Math.max(value, 0), 100) <span
                        class="text-gray-400">// 0-100</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// Find max in array</span>
                </div>
                <div class="font-mono text-xs">Math.max(...prices)</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- MATH.RANDOM -->
    <MethodCard
        id="random"
        methodName="Math.random()"
        signature="Math.random()"
        description="Generate a random number between 0 and 1"
        mutates={false}
    >
        <!-- Important callout -->
        <div class="bg-yellow-900 rounded p-4 mb-4">
            <div class="text-yellow-300 font-bold text-sm mb-2">
                <Mark type="warn" /> Math.random() 'only' gives 0-1
            </div>
            <div class="text-gray-300 text-xs mb-3">
                For other ranges (1-10, 1-100 and so on), multiply and add:
            </div>

            <div class="rounded space-y-0.5 border-t border-rule pt-2 mt-2">
                <div class="font-mono text-xs text-gray-300">
                    function randomInt(min, max) {"{"}
                </div>
                <div class="font-mono text-xs text-gray-300">
                    &nbsp;&nbsp;return Math.floor(Math.random() * (max - min +
                    1)) + min
                </div>
                <div class="font-mono text-xs text-gray-300">{"}"}</div>
                <div class="font-mono text-xs mt-2">
                    <span class="text-gray-400"
                        >// How it works for randomInt(1, 6):</span>
                </div>
                <div class="font-mono text-xs">
                    <span class="text-yellow-400">(max - min + 1)</span>
                    <span class="text-gray-400"
                        >→ (6 - 1 + 1) = 6 possible values</span>
                </div>
                <div class="font-mono text-xs">
                    <span class="text-yellow-400">Math.random() * 6</span>
                    <span class="text-gray-400">→ 0 to 5.999...</span>
                </div>
                <div class="font-mono text-xs">
                    <span class="text-yellow-400">Math.floor(...)</span>
                    <span class="text-gray-400">→ 0, 1, 2, 3, 4, or 5</span>
                </div>
                <div class="font-mono text-xs">
                    <span class="text-yellow-400">+ min</span>
                    <span class="text-gray-400">→ 1, 2, 3, 4, 5, or 6 <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs mt-2">
                    randomInt(1, 6) <span class="text-gray-400"
                        >// dice roll (1-6)</span>
                </div>
                <div class="font-mono text-xs">
                    randomInt(1, 100) <span class="text-gray-400"
                        >// 1-100</span>
                </div>
                <div class="font-mono text-xs">
                    randomInt(50, 100) <span class="text-gray-400"
                        >// 50-100</span>
                </div>
            </div>
        </div>

        <MutableOrNot mutates={false} message="">
            Returns a decimal from 0 (inclusive) to 1 (exclusive). For 1-100, use <code
                >Math.floor(Math.random() * 100) + 1</code
            >
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- FORMATTING -->
    <!-- ============================================ -->

    <SectionTitle id="formatting" color="orange"> Formatting </SectionTitle>

    <!-- TOFIXED -->
    <MethodCard
        id="to-fixed"
        methodName=".toFixed()"
        signature="number.toFixed(digits)"
        description="Format a number with fixed decimal places"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono">3.14159</div>
            </Node>

            <Arrow label="format" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="(3.14159).toFixed(2)"
                    description="2 decimal places"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <ReturnValue value="'3.14'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns a <strong>string</strong> with the set number of decimal
            places. Rounds if needed.
        </MutableOrNot>

        <ProTip>
            <div><Mark type="warn" /> <strong>Returns a string, not a number.</strong></div>
            <div class="text-xs mt-2 mb-3">
                It's a <strong>formatting method</strong> for display, not maths.
                Keeps trailing zeros like <span
                    class="font-mono text-orange-400">"42.00"</span
                > that numbers can't have.
            </div>
            <div class="pl-2 border-l border-rule space-y-1 mt-2">
                <div class="text-xs text-gray-400">Use for UI:</div>
                <div class="font-mono text-xs">
                    "$" + price.toFixed(2) <span class="text-gray-400"
                        >// "$42.00"</span>
                </div>

                <div class="text-xs text-gray-400 mt-2">
                    <Mark type="no" /> Never for maths:
                </div>
                <div class="font-mono text-xs">
                    "10.50" + "2.30" <span class="text-gray-400"
                        >// "10.502.30" </span>
                </div>

                <div class="text-xs text-gray-400 mt-2">
                    <Mark type="yes" /> Convert back if needed:
                </div>
                <div class="font-mono text-xs">
                    Number((3.14).toFixed(2)) <span class="text-gray-400"
                        >// 3.14</span>
                </div>
                <div class="font-mono text-xs">
                    +(3.14).toFixed(2) <span class="text-gray-400"
                        >// 3.14 (shorthand)</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- TOLOCALESTRING -->
    <MethodCard
        id="to-locale-string"
        methodName=".toLocaleString()"
        signature="number.toLocaleString(locale, options)"
        description="Format a number for a specific locale"
        mutates={false}
    >
        <Flow>
            <Node label="Input" type="input">
                <div class="text-center text-sm font-mono">1234567.89</div>
            </Node>

            <Arrow label="format" />

            <Node label="Method" type="process">
                <ProcessContent
                    name=".toLocaleString('en-US')"
                    description="Locale formatting"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Result" type="output">
                <ReturnValue value="'1,234,567.89'" type="string" />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Formats with thousands separators, currency and percentages. Returns a <strong
                >string</strong
            >.
        </MutableOrNot>

        <ProTip>
            <div>Currency formatting:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    (1234.5).toLocaleString('en-US', {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;style: 'currency',
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;currency: 'USD'
                </div>
                <div class="font-mono text-xs">
                    {"}"}) <span class="text-gray-400">// '$1,234.50'</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// Percentage</span>
                </div>
                <div class="font-mono text-xs">
                    (0.42).toLocaleString('en-US', {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;style: 'percent'
                </div>
                <div class="font-mono text-xs">
                    {"}"}) <span class="text-gray-400">// '42%'</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

