---
import VisualLayout from "src/layouts/VisualLayout.astro";
import MethodCard from "~components/visual-js/MethodCard.astro";
import InfoBox from "~components/visual-js/InfoBox.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Conditionals">
    <InfoBox>
        <div>
            <strong
                >true/false vs truthy/falsy - what's the difference?</strong>
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="text-xs mt-1">
                <strong><code>false</code></strong> = the boolean value itself
            </div>
            <div class="text-xs">
                <strong>falsy</strong> = any value that <em>acts like false</em>
                in a boolean context, such as an <code>if</code> condition
            </div>
            <div class="text-xs mt-1">
                <span class="text-yellow-400">8 falsy values:</span>
                <code>false</code>, <code>0</code
                >, <code>-0</code>, <code>0n</code
                >, <code>""</code>, <code>null</code
                >, <code>undefined</code
                >, <code>NaN</code>
            </div>
            <div class="text-xs mt-1">
                <strong>truthy</strong> = every other value, which acts like true
            </div>
            <div class="text-xs mt-1">
                <span class="text-red-400">Common gotchas:</span>
            </div>
            <div class="font-mono text-xs">
                if ([]) {"{"} ... {"}"}
                <span class="text-gray-400"
                    >// RUNS! [] is truthy even when empty</span>
            </div>
            <div class="font-mono text-xs">
                if ("0") {"{"} ... {"}"}
                <span class="text-gray-400">// RUNS! string "0" is truthy</span>
            </div>
            <div class="font-mono text-xs">
                if ("false") {"{"} ... {"}"}
                <span class="text-gray-400"
                    >// RUNS! string "false" is truthy</span>
            </div>
            <div class="font-mono text-xs mt-1">
                0 === false <span class="text-red-400">// false (different
                types, but both falsy)</span>
            </div>
            <div class="font-mono text-xs">
                [] == true <span class="text-red-400">// false ([] is truthy,
                but not equal to true)</span>
            </div>
        </div>
    </InfoBox>

    <!-- ============================================ -->
    <!-- IF/ELSE -->
    <!-- ============================================ -->

    <SectionTitle id="if-else" color="blue">
        If/else statements
    </SectionTitle>

    <!-- IF -->
    <MethodCard
        id="if"
        methodName="if"
        signature="if (condition) { }"
        description="Run code if the condition is truthy"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Visual flow diagram -->
                <div
                    class="rounded-lg p-4 text-sm border-t border-rule"
                >
                    <div class="flex items-center gap-3 mb-3">
                        <div class="text-blue-400 font-bold"><code>if</code></div>
                        <div
                            class="bg-blue-900 px-3 py-1.5 rounded"
                        >
                            <span class="text-blue-300"><code>condition</code></span>
                        </div>
                    </div>
                    <div
                        class="ml-8 pl-4 border-l-4 border-green-500 space-y-1"
                    >
                        <div class="text-gray-400 text-xs mb-1">
                            ↳ if <span class="text-green-400"><code>true</code></span>, runs:
                        </div>
                        <div class="text-green-300"><code>doSomething()</code></div>
                        <div class="text-green-300"><code>console.log('success')</code></div>
                    </div>
                    <div class="ml-8 mt-3 text-gray-500 text-xs">
                        ↳ if <span class="text-red-400"><code>false</code></span>, skips
                        block entirely
                    </div>
                </div>

                <!-- Example -->
                <div class="rounded p-3 border-t border-rule">
                    <div class="text-gray-400 text-xs mb-2">Example:</div>
                    <div class="font-mono text-xs text-gray-300 space-y-0.5">
                        <div>
                            <span class="text-blue-400">if</span> (age &gt;= 18)
                            {"{"}
                        </div>
                        <div class="ml-4 text-green-300">
                            console.log('Can vote')
                        </div>
                        <div>{"}"}</div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Runs the block only if the condition is truthy. <strong
                >JavaScript coerces the condition to a boolean.</strong
            >
        </div>

        <ProTip>
            <div>Common patterns:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400">// Check existence</span>
                </div>
                <div class="font-mono text-xs">
                    if (user) {"{"} ... {"}"}
                    <span class="text-gray-400">// truthy check</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// Check array has items</span>
                </div>
                <div class="font-mono text-xs">
                    if (arr.length) {"{"} ... {"}"}
                    <span class="text-gray-400">// 0 is falsy</span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// Early return pattern</span>
                </div>
                <div class="font-mono text-xs">
                    if (!user) return <span class="text-gray-400"
                        >// guard clause</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- IF...ELSE -->
    <MethodCard
        id="if-else-statement"
        methodName="if...else"
        signature="if (condition) { } else { }"
        description="Run one of two code paths"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Visual flow diagram -->
                <div
                    class="rounded-lg p-4 text-sm border-t border-rule"
                >
                    <div class="flex items-center gap-3 mb-3">
                        <div class="text-blue-400 font-bold"><code>if</code></div>
                        <div
                            class="bg-blue-900 px-3 py-1.5 rounded"
                        >
                            <span class="text-blue-300"><code>condition</code></span>
                        </div>
                    </div>
                    <div
                        class="ml-8 pl-4 border-l-4 border-green-500 space-y-1 mb-3"
                    >
                        <div class="text-gray-400 text-xs mb-1">
                            ↳ if <span class="text-green-400"><code>true</code></span>:
                        </div>
                        <div class="text-green-300"><code>doThisThing()</code></div>
                    </div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="text-orange-400 font-bold"><code>else</code></div>
                    </div>
                    <div
                        class="ml-8 pl-4 border-l-4 border-orange-500 space-y-1"
                    >
                        <div class="text-gray-400 text-xs mb-1">
                            ↳ if <span class="text-red-400"><code>false</code></span>:
                        </div>
                        <div class="text-orange-300"><code>doOtherThing()</code></div>
                    </div>
                </div>

                <!-- Example -->
                <div class="rounded p-3 border-t border-rule">
                    <div class="text-gray-400 text-xs mb-2">Example:</div>
                    <div class="font-mono text-xs text-gray-300 space-y-0.5">
                        <div>
                            <span class="text-blue-400">if</span> (age &gt;= 18)
                            {"{"}
                        </div>
                        <div class="ml-4 text-green-300">
                            console.log('Adult')
                        </div>
                        <div>
                            {"}"}
                            <span class="text-orange-400">else</span>
                            {"{"}
                        </div>
                        <div class="ml-4 text-orange-300">
                            console.log('Minor')
                        </div>
                        <div>{"}"}</div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Exactly one block runs. Use it when you have two mutually exclusive
            paths.
        </div>
    </MethodCard>

    <!-- ELSE IF -->
    <MethodCard
        id="else-if"
        methodName="else if"
        signature="if (cond1) { } else if (cond2) { } else { }"
        description="Chain multiple conditions"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Visual cascade diagram -->
                <div
                    class="rounded-lg p-4 text-sm border-t border-rule"
                >
                    <!-- First if -->
                    <div class="flex items-center gap-3 mb-2">
                        <div class="text-blue-400 font-bold"><code>if</code></div>
                        <div
                            class="bg-blue-900 px-3 py-1.5 rounded"
                        >
                            <span class="text-blue-300"><code>condition1</code></span>
                        </div>
                        <div class="text-xs text-gray-500">← checks first</div>
                    </div>
                    <div class="ml-8 pl-4 border-l-4 border-green-500 mb-4">
                        <div class="text-green-300"><code>executeThis()</code></div>
                        <div class="text-xs text-gray-500 mt-1">
                            <Mark type="yes" /> done, skip rest
                        </div>
                    </div>

                    <!-- else if 1 -->
                    <div class="flex items-center gap-3 mb-2">
                        <div class="text-purple-400 font-bold"><code>else if</code></div>
                        <div
                            class="bg-purple-900 px-3 py-1.5 rounded"
                        >
                            <span class="text-purple-300"><code>condition2</code></span>
                        </div>
                        <div class="text-xs text-gray-500">
                            ← if first was false
                        </div>
                    </div>
                    <div class="ml-8 pl-4 border-l-4 border-purple-500 mb-4">
                        <div class="text-purple-300"><code>executeThat()</code></div>
                        <div class="text-xs text-gray-500 mt-1">
                            <Mark type="yes" /> done, skip rest
                        </div>
                    </div>

                    <!-- else if 2 -->
                    <div class="flex items-center gap-3 mb-2">
                        <div class="text-purple-400 font-bold"><code>else if</code></div>
                        <div
                            class="bg-purple-900 px-3 py-1.5 rounded"
                        >
                            <span class="text-purple-300"><code>condition3</code></span>
                        </div>
                        <div class="text-xs text-gray-500">
                            ← if previous were false
                        </div>
                    </div>
                    <div class="ml-8 pl-4 border-l-4 border-purple-500 mb-4">
                        <div class="text-purple-300"><code>executeOther()</code></div>
                        <div class="text-xs text-gray-500 mt-1">
                            <Mark type="yes" /> done, skip rest
                        </div>
                    </div>

                    <!-- else -->
                    <div class="flex items-center gap-3 mb-2">
                        <div class="text-orange-400 font-bold"><code>else</code></div>
                        <div class="text-xs text-gray-500">
                            ← if all above were false
                        </div>
                    </div>
                    <div class="ml-8 pl-4 border-l-4 border-orange-500">
                        <div class="text-orange-300"><code>fallback()</code></div>
                        <div class="text-xs text-gray-500 mt-1">
                            default case
                        </div>
                    </div>
                </div>

                <!-- Example -->
                <div class="rounded p-3 border-t border-rule">
                    <div class="text-gray-400 text-xs mb-2">
                        Example - grade calculator:
                    </div>
                    <div class="font-mono text-xs text-gray-300 space-y-0.5">
                        <div>
                            <span class="text-blue-400">if</span> (score &gt;= 90)
                            {"{"}
                        </div>
                        <div class="ml-4 text-green-300">grade = 'A'</div>
                        <div>
                            {"}"}
                            <span class="text-purple-400">else if</span> (score &gt;=
                            80) {"{"}
                        </div>
                        <div class="ml-4 text-purple-300">grade = 'B'</div>
                        <div>
                            {"}"}
                            <span class="text-purple-400">else if</span> (score &gt;=
                            70) {"{"}
                        </div>
                        <div class="ml-4 text-purple-300">grade = 'C'</div>
                        <div>
                            {"}"}
                            <span class="text-orange-400">else</span>
                            {"{"}
                        </div>
                        <div class="ml-4 text-orange-300">grade = 'F'</div>
                        <div>{"}"}</div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Checks conditions in order. <strong
                >Stops at the first true condition.</strong
            > Only one block runs.
        </div>

        <ProTip>
            <div><Mark type="warn" /> Order matters. Put the most specific condition first:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs text-red-400">
                    <span class="text-gray-400">// <Mark type="no" /> Wrong order:</span>
                </div>
                <div class="font-mono text-xs">
                    if (score &gt;= 70) {"{"} grade = 'C' {"}"}
                    <span class="text-gray-400">// catches 90 too!</span>
                </div>
                <div class="font-mono text-xs">
                    else if (score &gt;= 90) {"{"} grade = 'A' {"}"}
                    <span class="text-gray-400">// never runs</span>
                </div>
                <div class="font-mono text-xs mt-1 text-green-400">
                    <span class="text-gray-400">// <Mark type="yes" /> Correct order:</span>
                </div>
                <div class="font-mono text-xs">
                    if (score &gt;= 90) {"{"} grade = 'A' {"}"}
                    <span class="text-gray-400">// most specific first</span>
                </div>
                <div class="font-mono text-xs">
                    else if (score &gt;= 70) {"{"} grade = 'C' {"}"}
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- SWITCH -->
    <!-- ============================================ -->

    <SectionTitle id="switch" color="purple">
        Switch statements
    </SectionTitle>

    <!-- SWITCH/CASE -->
    <MethodCard
        id="switch-case"
        methodName="switch...case"
        signature="switch (value) { case x: ... break; default: ... }"
        description="Match a value against multiple cases, with a fallback"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-3">
                <!-- Visual switch diagram -->
                <div
                    class="rounded-lg p-4 text-sm border-t border-rule"
                >
                    <div class="flex items-center gap-3 mb-3">
                        <div class="text-purple-400 font-bold"><code>switch</code></div>
                        <div
                            class="bg-purple-900 px-3 py-1.5 rounded"
                        >
                            <span class="text-purple-300"><code>value</code></span>
                        </div>
                        <span class="text-gray-500 text-xs"
                            >← match against cases</span
                        >
                    </div>

                    <!-- Cases -->
                    <div class="space-y-3 ml-4">
                        <!-- Case 1 -->
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <div class="text-blue-400"><code>case</code></div>
                                <div
                                    class="bg-blue-900 px-2 py-0.5 rounded text-xs"
                                >
                                    <span class="text-blue-300"><code>'value1'</code></span>
                                </div>
                                <span class="text-gray-500 text-xs">:</span>
                            </div>
                            <div
                                class="ml-6 pl-3 border-l-2 border-blue-500 space-y-0.5"
                            >
                                <div class="text-blue-300 text-xs">
                                    <code>doSomething()</code>
                                </div>
                                <div class="text-yellow-400 text-xs">
                                    <code>break</code> <span class="text-gray-500"
                                        >← stops here</span>
                                </div>
                            </div>
                        </div>

                        <!-- Case 2 -->
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <div class="text-blue-400"><code>case</code></div>
                                <div
                                    class="bg-blue-900 px-2 py-0.5 rounded text-xs"
                                >
                                    <span class="text-blue-300"><code>'value2'</code></span>
                                </div>
                                <span class="text-gray-500 text-xs">:</span>
                            </div>
                            <div
                                class="ml-6 pl-3 border-l-2 border-blue-500 space-y-0.5"
                            >
                                <div class="text-blue-300 text-xs">
                                    <code>doOtherThing()</code>
                                </div>
                                <div class="text-yellow-400 text-xs"><code>break</code></div>
                            </div>
                        </div>

                        <!-- Default -->
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <div class="text-orange-400"><code>default</code></div>
                                <span class="text-gray-500 text-xs"
                                    >: ← if no matches</span
                                >
                            </div>
                            <div
                                class="ml-6 pl-3 border-l-2 border-orange-500 space-y-0.5"
                            >
                                <div class="text-orange-300 text-xs">
                                    <code>fallback()</code>
                                </div>
                                <div class="text-gray-500 text-xs">
                                    no <code>break</code> needed (last)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Example -->
                <div class="rounded p-3 border-t border-rule">
                    <div class="text-gray-400 text-xs mb-2">Example:</div>
                    <div class="font-mono text-xs text-gray-300 space-y-0.5">
                        <div>
                            <span class="text-purple-400">switch</span> (day) {
                                "{"
                            }
                        </div>
                        <div class="ml-4">
                            <span class="text-blue-400">case</span> 'Mon':
                        </div>
                        <div class="ml-8">console.log('Start of week')</div>
                        <div class="ml-8">
                            <span class="text-yellow-400">break</span>
                        </div>
                        <div class="ml-4">
                            <span class="text-blue-400">case</span> 'Fri':
                        </div>
                        <div class="ml-8">console.log('Almost weekend!')</div>
                        <div class="ml-8">
                            <span class="text-yellow-400">break</span>
                        </div>
                        <div class="ml-4">
                            <span class="text-orange-400">default</span>:
                        </div>
                        <div class="ml-8">console.log('Regular day')</div>
                        <div>{"}"}</div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Uses <code
                >===</code
            > strict equality. <Mark type="warn" /> <strong>Always add break.</strong> Without break,
            execution 'falls through' to the next case.
        </div>

        <ProTip>
            <div><Mark type="warn" /> <strong>The break gotcha:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">switch (day) {"{"}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Mon':</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.log('Monday')
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;break <span class="text-green-400"
                        >// stops here <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Tue':</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.log('Tuesday') <span
                        class="text-red-400"
                        >// without break, runs this too! <Mark type="no" /></span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;break
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;default:</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.log('Other')
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>

        <ProTip>
            <div>
                <strong
                    >Grouping multiple cases (fall-through pattern):</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">switch (day) {"{"}</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Mon':</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Tue':</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Wed':</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Thu':</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Fri':</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.log('Weekday') <span
                        class="text-gray-400"
                        >// shared code for all weekdays</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;break
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Sat':</div>
                <div class="font-mono text-xs">&nbsp;&nbsp;case 'Sun':</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.log('Weekend') <span
                        class="text-gray-400">// shared code for weekend</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;break
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;default:</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.error('Invalid day') <span
                        class="text-green-400">// handle unexpected <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Stack cases without break to share code - falls
                        through until hitting break</span>
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div><strong>Always include default:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    default: <span class="text-gray-400"
                        >// optional but recommended (like 'else')</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;console.error('Unknown value') <span
                        class="text-gray-400">// catch unexpected values</span>
                </div>
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// No break needed (it's last)</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- TERNARY -->
    <!-- ============================================ -->

    <SectionTitle id="ternary" color="green">
        Ternary operator
    </SectionTitle>

    <!-- TERNARY -->
    <MethodCard
        id="ternary-op"
        methodName="Ternary"
        signature="condition ? valueIfTrue : valueIfFalse"
        description="Inline conditional expression (returns a value)"
        mutates={false}
    >
        <div class="p-4 rounded border-t border-rule">
            <!-- Inline expression -->
            <div class="font-mono text-sm mb-4">
                <span class="text-gray-400">const</span>
                <span class="text-blue-300">status</span> =
                <span class="text-orange-300 ml-2">age &gt;= 18</span>
                <span class="text-purple-300 mx-2">?</span>
                <span class="text-green-300">'Adult'</span>
                <span class="text-purple-300 mx-2">:</span>
                <span class="text-yellow-300">'Minor'</span>
            </div>

            <!-- Visual breakdown -->
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <div class="w-24 text-xs text-gray-400">Condition</div>
                    <div
                        class="bg-orange-900 flex-1 p-2 rounded font-mono text-xs text-orange-300"
                    >
                        age &gt;= 18
                    </div>
                </div>

                <div class="flex items-center gap-2">
