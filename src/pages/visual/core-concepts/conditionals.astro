                <span class="text-orange-300 ml-2">user</span><span
                    class="text-cyan-300">?.</span
                ><span class="text-orange-300">address</span><span
                    class="text-cyan-300">?.</span
                ><span class="text-orange-300">city</span>
                <span class="text-purple-300 mx-2">??</span>
                <span class="text-green-300">'Unknown'</span>
            </div>

            <!-- Two operators working together -->
            <div class="space-y-3">
                <div
                    class="bg-cyan-900 p-3 rounded"
                >
                    <div class="text-xs text-cyan-300 font-bold mb-2">
                        Step 1: optional chaining (?.) → safe navigation
                    </div>
                    <div class="text-xs text-gray-300 space-y-1">
                        <div class="font-mono">
                            user<span class="text-cyan-300">?.</span
                            >address<span class="text-cyan-300">?.</span>city
