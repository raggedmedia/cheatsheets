                                </div>
                                <div>
                                    !<span class="text-green-300">42</span> → <span
                                        class="text-red-300">false</span>
                                </div>
                                <div>
                                    !<span class="text-green-300"
                                        >{"{"}{"}"}</span
                                    > → <span class="text-red-300">false</span>
                                </div>
                            </div>
                        </div>

                        <!-- Falsy values -->
                        <div
                            class="bg-red-900 p-2 rounded"
                        >
                            <div
                                class="text-red-300 text-xs font-bold mb-1"
                            >
                                Falsy → true
                            </div>
                            <div
                                class="font-mono text-xs space-y-0.5 text-gray-300"
                            >
                                <div>
                                    !<span class="text-red-300">false</span> → <span
                                        class="text-green-300">true</span>
                                </div>
                                <div>
                                    !<span class="text-red-300">null</span> → <span
                                        class="text-green-300">true</span>
                                </div>
                                <div>
                                    !<span class="text-red-300">0</span> → <span
                                        class="text-green-300">true</span>
                                </div>
                                <div>
                                    !<span class="text-red-300">''</span> → <span
                                        class="text-green-300">true</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Double negation -->
                    <div
                        class="bg-purple-900 p-3 rounded mt-3"
                    >
                        <div class="text-purple-300 text-xs font-bold mb-1">
                            Double negation (!!) = boolean conversion
                        </div>
                        <div
                            class="font-mono text-xs space-y-0.5 text-gray-300"
                        >
                            <div>
                                !!<span class="text-green-300">'hello'</span> → <span
                                    class="text-green-300">true</span>
                            </div>
                            <div>
                                !!<span class="text-red-300">0</span> → <span
                                    class="text-red-300">false</span>
                            </div>
                            <div>
                                !!<span class="text-green-300">[1,2,3]</span> → <span
                                    class="text-green-300">true</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div
                class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
            >
                Always returns <code
                    >true</code
                > or <code
                    >false</code
                >. Double negation (!!) converts to boolean.
            </div>

            <ProTip>
                <div>Common patterns:</div>
                <div
                    class="pl-2 border-l border-rule space-y-0.5 mt-1"
                >
                    <div class="font-mono text-xs">
                        <span class="text-gray-400">// Check if falsy</span>
                    </div>
                    <div class="font-mono text-xs">
                        if (!user) return <span class="text-gray-400"
                            >// guard clause</span>
                    </div>
                    <div class="font-mono text-xs mt-1">
                        <span class="text-gray-400">// Toggle boolean</span>
                    </div>
                    <div class="font-mono text-xs">
                        isVisible = !isVisible
                    </div>
                    <div class="font-mono text-xs mt-1">
                        <span class="text-gray-400"
                            >// Convert to boolean (double negation)</span>
                    </div>
                    <div class="font-mono text-xs">
                        const hasItems = !!arr.length <span
                            class="text-gray-400">// true/false</span>
                    </div>
                </div>
            </ProTip>
        </MethodCard>

    </MethodCard>

