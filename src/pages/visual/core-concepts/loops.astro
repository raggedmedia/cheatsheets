        methodName="break"
        signature="break"
        description="Exit loop immediately"
        mutates={false}
    >
        <div class="p-4 rounded border-t border-rule">
            <!-- Code -->
            <div class="font-mono text-sm mb-4">
                <span class="text-purple-300">for</span>
                <span class="text-purple-300">(</span><span
                    class="text-gray-400">const</span
                >
                <span class="text-blue-300">item</span>
                <span class="text-purple-300">of</span>
                <span class="text-orange-300">['a', 'b', 'c', 'd']</span><span
                    class="text-purple-300">) {"{"}</span
                >
                <div class="ml-4">
                    <span class="text-purple-300">if</span>
                    <span class="text-purple-300">(</span><span
                        class="text-blue-300">item</span
                    >
                    <span class="text-purple-300">===</span>
                    <span class="text-green-300">'c'</span><span
                        class="text-purple-300">)</span
                    >
                    <span class="text-red-300">break</span>
                </div>
                <div class="ml-4">
                    <span class="text-gray-400">console.log(item)</span>
                </div>
                <span class="text-purple-300">{"}"}</span>
            </div>

            <!-- Flow visualization -->
            <div class="space-y-2 text-xs">
                <div class="text-gray-400 mb-2">
                    Exits the loop when it reaches break:
                </div>

                <div
                    class="bg-green-900 p-2 rounded"
                >
                    <div class="font-mono text-sm">
                        item = <span class="text-green-300">'a'</span>
                    </div>
                    <div class="text-gray-400 text-xs mt-1">
                        <Mark type="yes" /> Not 'c', console.log('a')
                    </div>
                </div>

                <div
                    class="bg-green-900 p-2 rounded"
                >
                    <div class="font-mono text-sm">
                        item = <span class="text-green-300">'b'</span>
                    </div>
                    <div class="text-gray-400 text-xs mt-1">
                        <Mark type="yes" /> Not 'c', console.log('b')
                    </div>
                </div>

                <div class="bg-red-900 p-2 rounded">
                    <div class="font-mono text-sm">
                        item = <span class="text-red-300">'c'</span>
                    </div>
                    <div class="text-red-300 text-xs mt-1 font-bold">
                        <Mark type="warn" /> 'break' - exit the loop now
                    </div>
                </div>

                <div
                    class="p-2 rounded opacity-40 border-t border-rule"
                >
                    <div class="font-mono text-sm">
                        item = <span class="text-gray-500">'d'</span>
                    </div>
                    <div class="text-gray-500 text-xs mt-1">
                        Never reached
                    </div>
                </div>

                <div
                    class="bg-blue-900 mt-3 p-2 rounded text-center"
                >
                    <div class="text-blue-300 font-bold">
                        Loop exits → code after loop runs
                    </div>
                </div>
            </div>
        </div>

        <MutableOrNot mutates={false} message="">
            Exits the innermost loop completely. Cannot be used in <code
                >forEach()</code
            >.
        </MutableOrNot>

        <ProTip>
            <div>Common use case - early exit:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
