        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            <strong>Returns a value</strong> (not a statement). Good for assignments,
            JSX and short conditionals. Avoid deep nesting.
        </div>

        <ProTip>
            <div><strong>When to use ternary:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-green-400">// Simple assignment <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs">
                    const status = isActive ? 'online' : 'offline'
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-green-400">// JSX conditionals <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs">
                    &lt;div&gt;{"{"}isLoading ? 'Loading...' : data{
                        "}"
                    }&lt;/div&gt;
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-red-400">// Avoid deep nesting <Mark type="no" /></span>
                </div>
                <div class="font-mono text-xs">
                    a ? b ? c : d : e ? f : g <span class="text-red-400"
                        >// hard to read!</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- NULLISH & OPTIONAL -->
    <!-- ============================================ -->

    <SectionTitle id="nullish" color="cyan">
        Nullish & optional
    </SectionTitle>

    <!-- NULLISH COALESCING -->
    <MethodCard
        id="nullish-coalescing"
        methodName="Nullish coalescing (??)"
        signature="value ?? fallback"
        description="Return fallback only if value is null or undefined"
        mutates={false}
    >
        <div class="p-4 rounded border-t border-rule">
            <!-- Inline expression -->
            <div class="font-mono text-sm mb-4">
                <span class="text-gray-400">const</span>
                <span class="text-blue-300">name</span> =
                <span class="text-orange-300 ml-2">username</span>
                <span class="text-purple-300 mx-2">??</span>
                <span class="text-green-300">'Guest'</span>
            </div>

            <!-- Comparison with || -->
            <div class="space-y-3">
                <div
                    class="bg-cyan-900 p-3 rounded"
                >
                    <div class="text-xs text-cyan-300 font-bold mb-2">
                        ?? (Nullish coalescing)
                    </div>
                    <div class="text-xs text-gray-300 space-y-1">
                        <div>
                            Returns the fallback <strong>only</strong> if the value is:
                        </div>
                        <div class="ml-3">
                            • <code class="text-yellow-300">null</code>
                        </div>
                        <div class="ml-3">
                            • <code class="text-yellow-300">undefined</code>
                        </div>
                        <div class="mt-2 text-green-300">
                            <Mark type="yes" /> Keeps: <code>0</code>, <code>false</code>, <code
                                >""</code>
                        </div>
                    </div>
                </div>

                <div
                    class="bg-orange-900 p-3 rounded"
                >
                    <div class="text-xs text-orange-300 font-bold mb-2">
                        || (Logical OR)
                    </div>
                    <div class="text-xs text-gray-300 space-y-1">
                        <div>
                            Returns the fallback if the value is <strong
                                >any falsy</strong
                            > value:
                        </div>
                        <div class="ml-3">
                            • <code class="text-yellow-300">null</code>, <code
                                class="text-yellow-300">undefined</code>
                        </div>
                        <div class="ml-3">
                            • <code class="text-yellow-300">0</code>, <code
                                class="text-yellow-300">false</code
                            >, <code class="text-yellow-300">""</code>, <code
                                class="text-yellow-300">NaN</code>
                        </div>
                        <div class="mt-2 text-red-300">
                            <Mark type="warn" /> Replaces 'all' falsy values
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Only treats <code
                >null</code
            > and <code
                >undefined</code
            > as nullish. <strong>0, false, "" are valid values.</strong>
        </div>

        <ProTip>
            <div><strong>?? vs || difference:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">const count = 0</div>
                <div class="font-mono text-xs mt-1">
                    count || 10 <span class="text-red-400"
                        >// 10 (0 is falsy) <Mark type="no" /></span>
                </div>
                <div class="font-mono text-xs">
                    count ?? 10 <span class="text-green-400"
                        >// 0 (0 is valid) <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs mt-1">const name = ''</div>
                <div class="font-mono text-xs">
                    name || 'Guest' <span class="text-red-400"
                        >// 'Guest' (empty string is falsy) <Mark type="no" /></span>
                </div>
                <div class="font-mono text-xs">
                    name ?? 'Guest' <span class="text-green-400"
                        >// '' (empty string is valid) <Mark type="yes" /></span>
                </div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Use ?? when 0, false, "" are meaningful values</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OPTIONAL CHAINING -->
    <MethodCard
        id="optional-chaining"
        methodName="Optional chaining (?.)"
        signature="obj?.prop?.nested"
        description="Safely access nested properties (returns undefined if null or undefined)"
        mutates={false}
    >
        <div class="p-4 rounded border-t border-rule">
            <!-- Chain visualization -->
            <div class="font-mono text-sm mb-4">
                <span class="text-gray-400">const</span>
                <span class="text-blue-300">city</span> =
                <span class="text-orange-300 ml-2">user</span><span
                    class="text-purple-300">?.</span
                ><span class="text-orange-300">address</span><span
                    class="text-purple-300">?.</span
                ><span class="text-orange-300">city</span>
            </div>

            <!-- Step-by-step evaluation -->
            <div class="space-y-2 text-xs">
                <div
                    class="p-2 rounded border-l-4 border-t border-rule"
                >
                    <div class="text-cyan-300 font-bold mb-1">
                        1. Check user
                    </div>
                    <div class="text-gray-300">
                        If <code class="text-yellow-300">null</code> or <code
                            class="text-yellow-300">undefined</code
                        > → return <code class="text-yellow-300"
                            >undefined</code>
                    </div>
                    <div class="text-gray-300">
                        Otherwise → continue to the next property
                    </div>
                </div>

                <div
                    class="p-2 rounded border-l-4 border-t border-rule"
                >
                    <div class="text-cyan-300 font-bold mb-1">
                        2. Check user.address
                    </div>
                    <div class="text-gray-300">
                        If <code class="text-yellow-300">null</code> or <code
                            class="text-yellow-300">undefined</code
                        > → return <code class="text-yellow-300"
                            >undefined</code>
                    </div>
                    <div class="text-gray-300">
                        Otherwise → continue to the next property
                    </div>
                </div>

                <div
                    class="bg-green-900 p-2 rounded border-l-4"
                >
                    <div class="text-green-300 font-bold mb-1">
                        3. Access city
                    </div>
                    <div class="text-gray-300">
                        Return the value (or <code class="text-yellow-300"
                            >undefined</code
                        > if it doesn't exist)
                    </div>
                </div>
            </div>

            <!-- Without vs With -->
            <div class="mt-4 pt-4 border-t border-gray-700">
                <div class="text-xs space-y-2">
                    <div>
                        <span class="text-red-300"><Mark type="no" /> Without:</span>
                        <div class="font-mono text-xs text-gray-400 mt-1">
                            user && user.address && user.address.city
                        </div>
                    </div>
                    <div>
                        <span class="text-green-300"><Mark type="yes" /> With:</span>
                        <div class="font-mono text-xs text-gray-400 mt-1">
                            user?.address?.city
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-gray-300 text-sm mt-3 p-3 rounded border-t border-rule"
        >
            Stops evaluation and returns <code
                >undefined</code
            > if the left side is nullish. <strong
                >Prevents 'Cannot read property' errors.</strong
            >
        </div>

        <ProTip>
            <div><strong>Safe property access:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400">// Works with methods too</span>
                </div>
                <div class="font-mono text-xs">user?.getName?.()</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// And array indexes</span>
                </div>
                <div class="font-mono text-xs">arr?.[0]?.property</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400"
                        >// Combine with function calls</span>
                </div>
                <div class="font-mono text-xs">
                    obj.method?.() <span class="text-gray-400"
                        >// only call if method exists</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- COMBINING ?? AND ?. -->
    <MethodCard
        id="combining"
        methodName="Combining ?? and ?."
        signature="obj?.prop ?? defaultValue"
        description="Safe access with fallback"
        mutates={false}
    >
        <div class="p-4 rounded border-t border-rule">
            <!-- Full expression -->
            <div class="font-mono text-sm mb-4">
                <span class="text-gray-400">const</span>
