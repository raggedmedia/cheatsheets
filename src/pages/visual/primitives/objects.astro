---
import "~styles/styles.css";
import MethodCard from "~components/visual-js/MethodCard.astro";
import Node from "~components/visual-js/Node.astro";
import Arrow from "~components/visual-js/Arrow.astro";
import ReturnValue from "~components/visual-js/ReturnValue.astro";
import MutableOrNot from "~components/visual-js/MutableOrNot.astro";
import ProcessContent from "~components/visual-js/ProcessContent.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import SubSectionTitle from "~components/visual-js/SubSectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Flow from "~components/visual-js/Flow.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Objects">
    <ProTip>
        <div>
            <Mark type="warn" /> <strong>Objects are not iterable.</strong> Unlike arrays and strings,
            objects don't work with <code>for...of</code> or array spread (<code>[...obj]</code>).
            Object spread (<code>{"{"} ...obj {"}"}</code>) works.
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                <span class="text-red-400">// This won't work:</span>
            </div>
            <div class="font-mono text-xs">
                for (const item of obj) {"{"} ... {"}"}
                <span class="text-red-400">// TypeError! <Mark type="no" /></span>
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-green-400">// Use these instead:</span>
            </div>
            <div class="font-mono text-xs">
                Object.keys(obj) → array of keys
            </div>
            <div class="font-mono text-xs">
                Object.values(obj) → array of values
            </div>
            <div class="font-mono text-xs">
                Object.entries(obj) → array of [key, value] pairs
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-green-400">// Then you can iterate:</span>
            </div>
            <div class="font-mono text-xs">
                for (const [k, v] of Object.entries(obj)) {"{"} ... {"}"} <Mark type="yes" />
            </div>
        </div>
    </ProTip>

    <ProTip>
        <div>
            Objects are <strong>mutable</strong> - you can change properties even
            with <code
                >const</code
            >
        </div>
        <div
            class="pl-2 border-l border-rule mt-1 font-mono text-xs"
        >
            const obj = {"{"}a: 1{"}"}; obj.a = 2 <Mark type="yes" /> <span class="text-gray-400"
                >// allowed!</span
            >
        </div>
        <div class="mt-1.5 text-xs">
            Use spread (<code
                >{"{"} ...obj {"}"}</code
            >) or <code
                >structuredClone()</code
            > to copy an object. A copy is not immutable.
        </div>
    </ProTip>

    <ProTip>
        <div>
            <strong>Getting object 'length':</strong> Objects don't have a <code
                >.length</code
            > property, but you can count properties:
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                const user = {"{"} name: "Alice", age: 25, city: "NYC" {"}"};
            </div>
            <div class="font-mono text-xs">
                Object.keys(user).length → 3 <span class="text-green-400"
                    >// count of properties</span
                >
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-blue-400">// Other ways to count:</span>
            </div>
            <div class="font-mono text-xs">
                Object.values(user).length → 3
            </div>
            <div class="font-mono text-xs">
                Object.entries(user).length → 3
            </div>
        </div>
    </ProTip>

    <!-- ============================================ -->
    <!-- MUTATES THE OBJECT -->
    <!-- ============================================ -->

    <SectionTitle id="mutates" color="red">
        Mutates the object
    </SectionTitle>

    <!-- === ADD / REMOVE / CHANGE === -->
    <SubSectionTitle id="add-remove-change" parentColor="red"
        >Add / remove / change</SubSectionTitle
    >

    <!-- PROPERTY ASSIGNMENT -->
    <MethodCard
        id="property-assignment"
        methodName="Property assignment"
        signature="obj.key = value"
        description="Adds or overwrites a property on an object"
        mutates={true}
    >
        <!-- ADD EXAMPLE -->
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">{"{"}a: 1{"}"}</div>
            </Node>

            <Arrow label="mutates" />

            <Node label="Operation" type="process">
                <ProcessContent
                    name="obj.b = 2"
                    description="Add new property"
                />
            </Node>

            <Arrow />

            <Node label="Modified Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>
        </Flow>

        <!-- CHANGE EXAMPLE -->
        <Flow class="mt-2">
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>

            <Arrow label="mutates" />

            <Node label="Operation" type="process">
                <ProcessContent
                    name="obj.a = 99"
                    description="Change existing property"
                />
            </Node>

            <Arrow />

            <Node label="Modified Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 99, b: 2{"}"}
                </div>
            </Node>
        </Flow>

        <!-- REMOVE EXAMPLE -->
        <Flow class="mt-2">
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 99, b: 2{"}"}
                </div>
            </Node>

            <Arrow label="mutates" />

            <Node label="Operation" type="process">
                <ProcessContent
                    name="delete obj.b"
                    description="Remove property"
                />
            </Node>

            <Arrow />

            <Node label="Modified Object" type="output">
                <div class="text-center text-sm font-mono">{"{"}a: 99{"}"}</div>
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Modifies the original object. Returns the assigned value (or true
            for delete).
        </MutableOrNot>
    </MethodCard>

    <!-- DELETE -->
    <MethodCard
        id="delete"
        methodName="delete"
        signature="delete obj.key"
        description="Removes a property from an object"
        mutates={true}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>

            <Arrow label="mutates" />

            <Node label="Operation" type="process">
                <ProcessContent
                    name="delete obj.b"
                    description="Remove property"
                />
            </Node>

            <Arrow />

            <Node label="Modified Object" type="output">
                <div class="text-center text-sm font-mono">{"{"}a: 1{"}"}</div>
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ReturnValue value="true" type="boolean" />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Removes the property from the original object. Returns <code
                >true</code
            > if the delete succeeds.
        </MutableOrNot>
    </MethodCard>

    <!-- PROPERTY SHORTHAND -->
    <MethodCard
        id="property-shorthand"
        methodName="Property shorthand"
        signature="{ name, age }"
        description="Create object properties from variables with the same name"
        mutates={false}
    >
        <Flow>
            <Node label="Variables" type="input">
                <div class="text-center text-sm font-mono">name = "Alice"</div>
                <div class="text-center text-sm font-mono">age = 25</div>
            </Node>

            <Arrow label="shorthand" />

            <Node label="Syntax" type="process">
                <ProcessContent
                    name="{ name, age }"
                    description="ES6 shorthand"
                />
            </Node>

            <Arrow label="creates" />

            <Node label="New Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}name: "Alice", age: 25{"}"}
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            ES6 shorthand: <code
                >{"{"} name {"}"}</code
            > is the same as <code
                >{"{"} name: name {"}"}</code
            >.
        </MutableOrNot>

        <ProTip>
            <div>
                <strong>Common in function returns and destructuring:</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    function getUser() {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;const name = "Bob", age = 30;
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return {"{"} name, age {"}"}; <span
                        class="text-green-400"
                        >// instead of {"{"}name: name, age: age{"}"}</span
                    >
                </div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- COMPUTED PROPERTY NAMES -->
    <MethodCard
        id="computed-property"
        methodName="Computed property names"
        signature="{ [key]: value }"
        description="Use dynamic expressions as property keys"
        mutates={false}
    >
        <Flow>
            <Node label="Dynamic Key" type="input">
                <div class="text-center text-sm font-mono">
                    key = "username"
                </div>
            </Node>

            <Arrow label="computed" />

            <Node label="Syntax" type="process">
                <ProcessContent
                    name="{ [key]: 'Alice' }"
                    description="Dynamic key in []"
                />
            </Node>

            <Arrow label="creates" />

            <Node label="New Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}username: "Alice"{"}"}
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns a <code
                >new object</code
            >. The expression in <code
                >[brackets]</code
            > sets the property key.
        </MutableOrNot>

        <ProTip>
            <div><strong>Useful for dynamic object building:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">const field = "email";</div>
                <div class="font-mono text-xs">const user = {"{"}</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;name: "Alice",
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;[field]: "alice@email.com" <span
                        class="text-green-400">// key is "email"</span
                    >
                </div>
                <div class="font-mono text-xs">{"}"};</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OBJECT.ASSIGN -->
    <MethodCard
        id="assign"
        methodName="Object.assign()"
        signature="Object.assign(target, ...sources)"
        description="Copies properties from source objects into target"
        mutates={true}
    >
        <Flow>
            <Node label="Target" type="input">
                <div class="text-center text-sm font-mono">{"{"}a: 1{"}"}</div>
            </Node>

            <Arrow label="merges with" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Object.assign(target, {b: 2})"
                    description="Copy properties to target"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Modified Target" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Mutates the target object. Returns the modified target. Later
            sources overwrite earlier ones.
        </MutableOrNot>

        <ProTip>
            <div>Use an empty object as the target to merge without mutation:</div>
            <div
                class="pl-2 border-l border-rule font-mono text-xs"
            >
                Object.assign({"{"}{"}"}, obj1, obj2) → new merged object <Mark type="yes" />
            </div>
        </ProTip>
    </MethodCard>

    <!-- === LOCK OR PROTECT === -->
    <SubSectionTitle id="lock-protect" parentColor="red"
        >Lock or protect</SubSectionTitle
    >

    <!-- OBJECT.FREEZE -->
    <MethodCard
        id="freeze"
        methodName="Object.freeze()"
        signature="Object.freeze(obj)"
        description="Makes an object immutable (shallow). No add, remove or edit."
        mutates={true}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">{"{"}a: 1{"}"}</div>
            </Node>

            <Arrow label="freezes" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Object.freeze(obj)"
                    description="Lock all changes"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Frozen Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1{"}"} 
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Makes the object immutable. Returns the same object. Later changes
            fail silently in non-strict mode.
        </MutableOrNot>

        <ProTip>
            <div><strong>What happens if you try to change it?</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const obj = Object.freeze({"{"}a: 1{"}"})
                </div>
                <div class="font-mono text-xs">
                    obj.a = 99 <span class="text-red-400"
                        >// silently ignored (non-strict mode)</span
                    >
                </div>
                <div class="font-mono text-xs">
                    obj.b = 2 <span class="text-red-400"
                        >// silently ignored (non-strict mode)</span
                    >
                </div>
                <div class="font-mono text-xs">
                    delete obj.a <span class="text-red-400"
                        >// silently ignored (non-strict mode)</span
                    >
                </div>
                <div class="font-mono text-xs mt-1">
                    'use strict'; obj.a = 99 <span class="text-red-400"
                        >// TypeError <Mark type="no" /></span
                    >
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div>
                <Mark type="warn" /> <strong>Shallow freeze.</strong> You can still change nested
                objects:
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const obj = Object.freeze({"{"}user: {"{"}id: 1{"}"}{"}"})
                </div>
                <div class="font-mono text-xs">
                    obj.user.id = 999 <Mark type="yes" /> <span class="text-gray-400"
                        >// nested still mutable!</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OBJECT.SEAL -->
    <MethodCard
        id="seal"
        methodName="Object.seal()"
        signature="Object.seal(obj)"
        description="Prevents adding or removing properties, but allows edits to existing ones"
        mutates={true}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">{"{"}a: 1{"}"}</div>
            </Node>

            <Arrow label="seals" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Object.seal(obj)"
                    description="Lock structure"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Sealed Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1{"}"} 
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Prevents adding or removing properties. You can still edit values.
            Returns the same object.
        </MutableOrNot>

        <ProTip>
            <div><strong>What happens if you try to add or remove?</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const obj = Object.seal({"{"}a: 1{"}"})
                </div>
                <div class="font-mono text-xs">
                    obj.a = 99 <Mark type="yes" /> <span class="text-green-400"
                        >// editing works!</span
                    >
                </div>
                <div class="font-mono text-xs">
                    obj.b = 2 <span class="text-red-400"
                        >// silently ignored (can't add)</span
                    >
                </div>
                <div class="font-mono text-xs">
                    delete obj.a <span class="text-red-400"
                        >// silently ignored (can't remove)</span
                    >
                </div>
                <div class="font-mono text-xs mt-1">
                    'use strict'; obj.b = 2 <span class="text-red-400"
                        >// TypeError <Mark type="no" /></span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- ============================================ -->
    <!-- DOES NOT MUTATE -->
    <!-- ============================================ -->

    <SectionTitle id="immutable" color="green">
        Does not mutate (returns new value)
    </SectionTitle>

    <ProTip>
        <div>
            Use spread or <code
                >Object.assign({"{"}{"}"}, obj)</code
            > for shallow copies
        </div>
        <div
            class="pl-2 border-l border-rule font-mono text-xs mt-1"
        >
            const copy = {"{"} ...original {"}"}
            <span class="text-gray-400">// cleaner than Object.assign</span>
        </div>
    </ProTip>

    <!-- === CLONE / MERGE === -->
    <SubSectionTitle id="clone-merge" parentColor="green"
        >Clone / merge</SubSectionTitle
    >

    <!-- SPREAD -->
    <MethodCard
        id="spread"
        methodName="Spread { ...obj }"
        signature="{ ...obj }"
        description="Creates a shallow copy of an object"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>

            <Arrow label="spreads" />

            <Node label="Syntax" type="process">
                <ProcessContent name="{ ...obj }" description="Shallow copy" />
            </Node>

            <Arrow label="returns" />

            <Node label="New Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Creates a <code
                >new object</code
            > with copied properties. The original stays unchanged.
        </MutableOrNot>

        <ProTip>
            <div>Spread is the modern way to clone and merge objects:</div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    const merged = {"{"} ...obj1, ...obj2 {"}"}
                    <span class="text-gray-400">// merge</span>
                </div>
                <div class="font-mono text-xs">
                    const updated = {"{"} ...obj, key: newValue {"}"}
                    <span class="text-gray-400">// update</span>
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- STRUCTURED CLONE -->
    <MethodCard
        id="structuredClone"
        methodName="structuredClone()"
        signature="structuredClone(obj)"
        description="Creates a deep copy of an object (all nested levels)"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}user: {"{"}id: 1{"}"}{"}"}
                </div>
            </Node>

            <Arrow label="deep clones" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="structuredClone(obj)"
                    description="Deep copy all levels"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New Object" type="output">
                <div class="text-center text-sm font-mono">
                    {"{"}user: {"{"}id: 1{"}"}{"}"}
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Creates a fully independent <code
                >deep copy</code
            >. It also clones nested objects.
        </MutableOrNot>
    </MethodCard>

    <!-- === INSPECT / READ === -->
    <SubSectionTitle id="inspect-read" parentColor="green"
        >Inspect / read</SubSectionTitle
    >

    <!-- OBJECT.KEYS -->
    <MethodCard
        id="keys"
        methodName="Object.keys()"
        signature="Object.keys(obj)"
        description="Returns an array of the object's own property names"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2, c: 3{"}"}
                </div>
            </Node>

            <Arrow label="extracts keys" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Object.keys(obj)"
                    description="Get property names"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <div class="text-center text-sm font-mono">['a', 'b', 'c']</div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >array</code
            > of own enumerable property names. You can chain array methods on it.
        </MutableOrNot>
    </MethodCard>

    <!-- OBJECT.VALUES -->
    <MethodCard
        id="values"
        methodName="Object.values()"
        signature="Object.values(obj)"
        description="Returns an array of the object's own property values"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2, c: 3{"}"}
                </div>
            </Node>

            <Arrow label="extracts values" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Object.values(obj)"
                    description="Get property values"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <div class="text-center text-sm font-mono">[1, 2, 3]</div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >array</code
            > of own enumerable property values. You can chain array methods on it.
        </MutableOrNot>
    </MethodCard>

    <!-- OBJECT.ENTRIES -->
    <MethodCard
        id="entries"
        methodName="Object.entries()"
        signature="Object.entries(obj)"
        description="Returns an array of [key, value] pairs"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">
                    {"{"}a: 1, b: 2{"}"}
                </div>
            </Node>

            <Arrow label="converts" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Object.entries(obj)"
                    description="Get [k,v] pairs"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <div class="text-center text-sm font-mono">
                    [['a', 1], ['b', 2]]
                </div>
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns <code
                >array</code
            > of [key, value] pairs. Chain array methods on it to iterate and
            transform.
        </MutableOrNot>

        <ProTip>
            <div>
                Combine with <code
                    >Object.fromEntries()</code
                > to map or filter objects:
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400">// Double all values</span>
                </div>
                <div class="font-mono text-xs">Object.fromEntries(</div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;Object.entries(obj).map(([k,v]) =&gt; [k, v*2])
                </div>
                <div class="font-mono text-xs">)</div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- OBJECT.HASOWN -->
    <MethodCard
        id="hasOwn"
        methodName="Object.hasOwn()"
        signature="Object.hasOwn(obj, key)"
        description="Checks if an object has its own property (not inherited)"
        mutates={false}
    >
        <Flow>
            <Node label="Input Object" type="input">
                <div class="text-center text-sm font-mono">{"{"}a: 1{"}"}</div>
            </Node>

