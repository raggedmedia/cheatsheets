                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;if (err.status &gt;= 400
                    && err.status &lt; 500) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;throw err <span
                        class="text-gray-400">// user error, don't retry</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{"}"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span
                        class="text-yellow-400"
                        >// Retry on network/server errors (5xx, timeout)</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;if (attempt ===
