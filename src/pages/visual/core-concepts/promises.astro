            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    async function retry(fn, maxAttempts = 3) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;for (let attempt = 1; attempt &lt;= maxAttempts;
                    attempt++) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;try {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return await fn() <span
                        class="text-gray-400">// success!</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"} catch (err) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;if (attempt ===
                    maxAttempts) throw err <span class="text-gray-400"
                        >// give up</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;console.log(`Attempt ${
                        "{"
                    }attempt{"}"} failed, retrying...`)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"}
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"}</div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="font-mono text-xs mt-1">
                    <span class="text-gray-400">// Usage:</span>
                </div>
                <div class="font-mono text-xs">
                    const data = await retry(() =&gt; fetch('/api/data'))
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div>
                <strong>Pattern 2: retry with delay (linear backoff)</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    function delay(ms) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;return new Promise(resolve =&gt;
                    setTimeout(resolve, ms))
                </div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="font-mono text-xs mt-1">
                    async function retryWithDelay(fn, maxAttempts = 3, delayMs =
                    1000) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;for (let attempt = 1; attempt &lt;= maxAttempts;
                    attempt++) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;try {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return await fn()
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"} catch (err) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;if (attempt ===
                    maxAttempts) throw err
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;console.log(`Retry ${
                        "{"
                    }attempt{"}"} in ${"{"}delayMs{"}"}ms...`)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;await delay(delayMs) <span
                        class="text-gray-400">// wait before retry</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"}
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"}</div>
                <div class="font-mono text-xs">{"}"}</div>
            </div>
        </ProTip>

        <ProTip>
            <div>
                <strong
                    >Pattern 3: exponential backoff (best for APIs)</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    async function retryWithBackoff(fn, maxAttempts = 5) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;for (let attempt = 1; attempt &lt;= maxAttempts;
                    attempt++) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;try {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return await fn()
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"} catch (err) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;if (attempt ===
                    maxAttempts) throw err
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span
                        class="text-yellow-400">// 1s, 2s, 4s, 8s, 16s...</span>
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;const delayMs =
                    Math.pow(2, attempt - 1) * 1000
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;console.log(`Attempt ${
                        "{"
                    }attempt{"}"} failed, waiting ${"{"}delayMs{"}"}ms...`)
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;await new Promise(r
                    =&gt; setTimeout(r, delayMs))
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;{"}"}
                </div>
                <div class="font-mono text-xs">&nbsp;&nbsp;{"}"}</div>
                <div class="font-mono text-xs">{"}"}</div>
                <div class="text-xs mt-1 text-gray-400">
                    <Mark type="yes" /> Delays double each time, which puts less load on the server
                </div>
            </div>
        </ProTip>

        <ProTip>
            <div>
                <strong>Pattern 4: conditional retry (smart retries)</strong>
            </div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs">
                    async function retryIfRetryable(fn, maxAttempts = 3) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;for (let attempt = 1; attempt &lt;= maxAttempts;
                    attempt++) {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;try {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return await fn()
                </div>
                <div class="font-mono text-xs">
