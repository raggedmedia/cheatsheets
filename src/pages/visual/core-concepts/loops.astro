                    &nbsp;&nbsp;if (item === 'target') {"{"}
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;console.log('Found it!')
                </div>
                <div class="font-mono text-xs">
                    &nbsp;&nbsp;&nbsp;&nbsp;break <span class="text-gray-400"
