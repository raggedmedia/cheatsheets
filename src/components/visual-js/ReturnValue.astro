---
interface Props {
    value: string | number;
    type: string;
}

const { value, type } = Astro.props;
---

<div class="py-2 px-3 bg-gray-900 border-b-[3px] border-gray-600 text-center font-mono font-semibold text-sm">
    {value}
    <div class="font-sans text-xs font-normal text-gray-400 mt-0.5">{type}</div>
</div>
