    <!-- COMPARISON -->
    <!-- ============================================ -->

    <SectionTitle id="comparison" color="red">
        Pointer vs mouse vs touch events
    </SectionTitle>

    <MethodCard
        id="event-comparison"
        methodName="When to use which events"
        signature="Pointer Events vs legacy events"
        description="The differences, and when to use each"
        mutates={false}
    >
        <div class="p-6 rounded">
            <div class="space-y-4">
                <!-- Pointer Events -->
                <div class="bg-green-900 rounded p-3">
                    <div class="text-green-300 space-y-1">
                        <div class="text-yellow-400 font-bold text-sm mb-1"><Mark type="yes" /> Pointer Events (recommended)</div>
                        <div class="font-mono text-xs">pointerdown, pointermove, pointerup, etc.</div>
                        <div class="text-xs mt-2 space-y-0.5">
                            <div><span class="text-green-400"><Mark type="yes" /></span> Works for mouse, touch, and stylus</div>
                            <div><span class="text-green-400"><Mark type="yes" /></span> More information (pressure, tilt, etc.)</div>
                            <div><span class="text-green-400"><Mark type="yes" /></span> Multi-touch support via pointerId</div>
                            <div><span class="text-green-400"><Mark type="yes" /></span> Pointer capture for drag operations</div>
                            <div><span class="text-green-400"><Mark type="yes" /></span> One code path for all input types</div>
                            <div><span class="text-green-400"><Mark type="yes" /></span> Widely supported (all modern browsers)</div>
                        </div>
                    </div>
                </div>

                <!-- Mouse Events -->
                <div class="bg-blue-900 rounded p-3">
                    <div class="text-blue-300 space-y-1">
                        <div class="text-yellow-400 font-bold text-sm mb-1">Mouse events (legacy)</div>
                        <div class="font-mono text-xs">mousedown, mousemove, mouseup, etc.</div>
                        <div class="text-xs mt-2 space-y-0.5">
                            <div><span class="text-blue-400">→</span> Only for mouse input</div>
                            <div><span class="text-blue-400">→</span> Simple, well-understood</div>
                            <div><span class="text-yellow-400"><Mark type="warn" /></span> Partly works on touch (emulated, no multi-touch)</div>
                            <div><span class="text-yellow-400"><Mark type="warn" /></span> Need separate touch handlers</div>
                            <div class="text-gray-400 mt-1">Use for desktop-only apps, or with separate touch handling</div>
                        </div>
                    </div>
                </div>

                <!-- Touch Events -->
                <div class="bg-orange-900 rounded p-3">
                    <div class="text-orange-300 space-y-1">
                        <div class="text-yellow-400 font-bold text-sm mb-1">Touch events (legacy)</div>
                        <div class="font-mono text-xs">touchstart, touchmove, touchend, etc.</div>
                        <div class="text-xs mt-2 space-y-0.5">
                            <div><span class="text-orange-400">→</span> Only for touch input</div>
                            <div><span class="text-orange-400">→</span> Access to touches array</div>
                            <div><span class="text-yellow-400"><Mark type="warn" /></span> More complex API</div>
                            <div><span class="text-yellow-400"><Mark type="warn" /></span> Need separate mouse handlers</div>
                            <div><span class="text-red-400"><Mark type="no" /></span> Doesn't fire for mouse; stylus support varies</div>
                            <div class="text-gray-400 mt-1">Use when you need specific touch gesture handling</div>
                        </div>
                    </div>
                </div>

                <!-- Comparison table -->
                <div class="rounded p-3 border-t border-rule">
                    <div class="text-gray-300 text-xs space-y-1">
                        <div class="font-bold text-yellow-400 mb-2">Feature comparison:</div>
                        <div class="grid grid-cols-4 gap-2">
                            <div class="font-bold">Feature</div>
                            <div class="font-bold">Pointer</div>
                            <div class="font-bold">Mouse</div>
                            <div class="font-bold">Touch</div>

                            <div>Works on mouse</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>

                            <div>Works on touch</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-yellow-400">~</div>
                            <div class="text-green-400"><Mark type="yes" /></div>

                            <div>Works on stylus</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-yellow-400">~</div>
                            <div class="text-yellow-400">~</div>

                            <div>Pressure support</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>

                            <div>Tilt support</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>

                            <div>Pointer capture</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>

                            <div>Multi-touch</div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                            <div class="text-red-400"><Mark type="no" /></div>
                            <div class="text-green-400"><Mark type="yes" /></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ProTip>
            <div><strong>Migration guide:</strong></div>
            <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
                <div class="font-mono text-xs"><span class="text-gray-400">// Replace these:</span></div>
                <div class="font-mono text-xs">mousedown → pointerdown</div>
                <div class="font-mono text-xs">mousemove → pointermove</div>
                <div class="font-mono text-xs">mouseup → pointerup</div>
                <div class="font-mono text-xs">mouseenter → pointerenter</div>
                <div class="font-mono text-xs">mouseleave → pointerleave</div>
                <div class="font-mono text-xs mt-1"><span class="text-gray-400">// Add this CSS to prevent default touch behavior:</span></div>
                <div class="font-mono text-xs">element{'{'} touch-action: none; }</div>
            </div>
        </ProTip>

        <InfoBox>
            <div><strong>Bottom line</strong></div>
            <div class="pl-2 border-l border-rule space-y-1 mt-2">
                <div class="text-sm">For <strong>new projects</strong>: always use Pointer Events</div>
                <div class="text-sm">For <strong>existing projects</strong>: migrate when you can</div>
                <div class="text-sm">For <strong>desktop-only apps</strong>: mouse events work, but Pointer Events cost nothing extra</div>
                <div class="text-sm">For <strong>mobile-only apps</strong>: touch events work, but Pointer Events are better</div>
                <div class="text-sm mt-2 text-yellow-300">Pointer Events are the future-proof choice.</div>
            </div>
        </InfoBox>
    </MethodCard>

