---
import "~styles/styles.css";
import MethodCard from "~components/visual-js/MethodCard.astro";
import Node from "~components/visual-js/Node.astro";
import ArrayDisplay from "~components/visual-js/ArrayDisplay.astro";
import Arrow from "~components/visual-js/Arrow.astro";
import ReturnValue from "~components/visual-js/ReturnValue.astro";
import MutableOrNot from "~components/visual-js/MutableOrNot.astro";
import ProcessContent from "~components/visual-js/ProcessContent.astro";
import ProTip from "~components/visual-js/ProTip.astro";
import SectionTitle from "~components/visual-js/SectionTitle.astro";
import SubSectionTitle from "~components/visual-js/SubSectionTitle.astro";
import VisualLayout from "src/layouts/VisualLayout.astro";
import Flow from "~components/visual-js/Flow.astro";
import Mark from "~components/visual-js/Mark.astro";
---

<VisualLayout pageTitle="Arrays">
    <ProTip>
        <div>
            <strong>Arrays are iterable.</strong> Arrays (along with strings, Maps,
            and Sets) are one of the few iterable types in JavaScript.
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                <span class="text-green-400">// Works with for...of loops:</span
                >
            </div>
            <div class="font-mono text-xs">
                for (const item of [1, 2, 3]) {"{"} console.log(item) {"}"}
            </div>
            <div class="font-mono text-xs mt-1">
                <span class="text-green-400"
                    >// Works with spread operator:</span
                >
            </div>
            <div class="font-mono text-xs">const copy = [...arr]</div>
            <div class="font-mono text-xs mt-1">
                <span class="text-red-400"
                    >// Objects are NOT iterable (need
                    Object.keys/values/entries)</span
                >
            </div>
        </div>
    </ProTip>

    <ProTip>
        <div>
            <strong>Array length property:</strong> Get the number of elements
            with <code
                >arr.length</code
            >
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5 mt-1">
            <div class="font-mono text-xs">
                const nums = [1, 2, 3, 4, 5];
            </div>
            <div class="font-mono text-xs">nums.length → 5</div>
            <div class="font-mono text-xs mt-1">
                <span class="text-green-400"
                    >// Writable! Set length to truncate:</span
                >
            </div>
            <div class="font-mono text-xs">nums.length = 3 → [1, 2, 3]</div>
        </div>
    </ProTip>

    <!-- ============================================ -->
    <!-- CONVERTING TO ARRAYS -->
    <!-- ============================================ -->

    <SectionTitle id="converting" color="blue">
        Converting to arrays
    </SectionTitle>

    <!-- === STRING TO ARRAY === -->
    <SubSectionTitle id="string-to-array" parentColor="blue"
        >String to array</SubSectionTitle
    >

    <!-- SPLIT -->
    <MethodCard
        id="split"
        methodName="split()"
        signature="str.split(separator)"
        description="Splits a string into an array of substrings"
        mutates={false}
    >
        <Flow>
            <Node label="String" type="input">
                <div class="text-center text-sm font-mono">"hello"</div>
            </Node>

            <Arrow label="splits" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="split('')"
                    description="Split into characters"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <ArrayDisplay
                    values={["h", "e", "l", "l", "o"]}
                    highlightIndices={[0, 1, 2, 3, 4]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns a <code
                >new array</code
            >. Use <code
                >split('')</code
            > for chars, <code
                >split(' ')</code
            > for words.
        </MutableOrNot>
    </MethodCard>

    <!-- ARRAY.FROM STRING -->
    <MethodCard
        id="array-from-string"
        methodName="Array.from()"
        signature="Array.from(string)"
        description="Creates an array from a string or other iterable"
        mutates={false}
    >
        <Flow>
            <Node label="String" type="input">
                <div class="text-center text-sm font-mono">"abc"</div>
            </Node>

            <Arrow label="converts" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Array.from(str)"
                    description="String to array"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <ArrayDisplay
                    values={["a", "b", "c"]}
                    highlightIndices={[0, 1, 2]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Static method. Returns a <code
                >new array</code
            > from any iterable or array-like object.
        </MutableOrNot>
    </MethodCard>

    <!-- SPREAD STRING -->
    <MethodCard
        id="spread-string"
        methodName="Spread [...str]"
        signature="[...string]"
        description="Uses the spread operator to convert a string to an array"
        mutates={false}
    >
        <Flow>
            <Node label="String" type="input">
                <div class="text-center text-sm font-mono">"hello"</div>
            </Node>

            <Arrow label="spreads" />

            <Node label="Syntax" type="process">
                <ProcessContent
                    name="[...str]"
                    description="Spread into array"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <ArrayDisplay
                    values={["h", "e", "l", "l", "o"]}
                    highlightIndices={[0, 1, 2, 3, 4]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Modern syntax. Creates a <code
                >new array</code
            > with each character as an element.
        </MutableOrNot>
    </MethodCard>

    <!-- === NUMBER TO ARRAY === -->
    <SubSectionTitle id="number-to-array" parentColor="blue"
        >Number to array</SubSectionTitle
    >

    <!-- NUMBER TO DIGITS -->
    <MethodCard
        id="number-to-digits"
        methodName="String() + split()"
        signature="String(num).split('')"
        description="Converts a number to an array of digit strings"
        mutates={false}
    >
        <Flow>
            <Node label="Number" type="input">
                <div class="text-center text-sm font-mono">12345</div>
            </Node>

            <Arrow label="converts" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="String(num).split('')"
                    description="To string, then split"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <ArrayDisplay
                    values={["1", "2", "3", "4", "5"]}
                    highlightIndices={[0, 1, 2, 3, 4]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns an array of <code
                >digit strings</code
            >. Use <code
                >.map(Number)</code
            > to convert to numbers.
        </MutableOrNot>
    </MethodCard>

    <!-- ARRAY.FROM NUMBER -->
    <MethodCard
        id="array-from-number"
        methodName="Array.from() + map"
        signature="Array.from(String(num), Number)"
        description="Converts a number to an array of digit numbers"
        mutates={false}
    >
        <Flow>
            <Node label="Number" type="input">
                <div class="text-center text-sm font-mono">123</div>
            </Node>

            <Arrow label="converts" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="Array.from(String(num), Number)"
                    description="String then map to numbers"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Array" type="output">
                <ArrayDisplay
                    values={[1, 2, 3]}
                    highlightIndices={[0, 1, 2]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Returns an array of <code
                >digit numbers</code
            >. The second parameter is a map function.
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- MUTATES THE ARRAY -->
    <!-- ============================================ -->

    <SectionTitle id="mutates" color="red"> Mutates the array </SectionTitle>

    <!-- === INSERT / REMOVE === -->
    <SubSectionTitle id="insert-remove" parentColor="red"
        >Insert / remove</SubSectionTitle
    >

    <!-- PUSH -->
    <MethodCard
        id="push"
        methodName="push()"
        signature="arr.push(...items)"
        description="Adds elements to the end of an array and returns the new length"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent name="push('d')" description="Add to end" />
            </Node>

            <Arrow />

            <Node label="Modified Array" type="output">
                <ArrayDisplay
                    values={["a", "b", "c", "d"]}
                    highlightIndices={[3]}
                    highlightType="added"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ReturnValue value={4} type="new length" />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Modifies the original array in place. Returns <code
                >number</code
            > (new length), not the array. <Mark type="warn" /> Cannot be chained with other array
            methods.
        </MutableOrNot>
    </MethodCard>

    <!-- POP -->
    <MethodCard
        id="pop"
        methodName="pop()"
        signature="arr.pop()"
        description="Removes and returns the last element from an array"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent name="pop()" description="Remove last" />
            </Node>

            <Arrow />

            <Node label="Modified Array" type="output">
                <ArrayDisplay values={["a", "b"]} />
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ReturnValue value="'c'" type="removed item" />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Shortens the original array. Returns the removed <code
                >element</code
            > (or undefined if empty). <Mark type="warn" /> Cannot be chained with other array methods.
        </MutableOrNot>
    </MethodCard>

    <!-- UNSHIFT -->
    <MethodCard
        id="unshift"
        methodName="unshift()"
        signature="arr.unshift(...items)"
        description="Adds elements to the start of an array and returns the new length"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["b", "c", "d"]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="unshift('a')"
                    description="Add to start"
                />
            </Node>

            <Arrow />

            <Node label="Modified Array" type="output">
                <ArrayDisplay
                    values={["a", "b", "c", "d"]}
                    highlightIndices={[0]}
                    highlightType="added"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ReturnValue value={4} type="new length" />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Modifies the original array in place. All existing elements shift
            to higher indices. Returns <code
                >number</code
            > (new length). <Mark type="warn" /> Cannot be chained with other array methods.
        </MutableOrNot>
    </MethodCard>

    <!-- SHIFT -->
    <MethodCard
        id="shift"
        methodName="shift()"
        signature="arr.shift()"
        description="Removes and returns the first element from an array"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent name="shift()" description="Remove first" />
            </Node>

            <Arrow />

            <Node label="Modified Array" type="output">
                <ArrayDisplay values={["b", "c"]} />
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ReturnValue value="'a'" type="removed item" />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Shortens the original array. All remaining elements shift to
            lower indices. Returns the removed <code
                >element</code
            > (or undefined if empty). <Mark type="warn" /> Cannot be chained with other array methods.
        </MutableOrNot>
    </MethodCard>

    <!-- SPLICE -->
    <MethodCard
        id="splice"
        methodName="splice()"
        signature="arr.splice(start, deleteCount, ...items)"
        description="Removes, replaces, or adds elements at any position in the array"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c", "d"]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="splice(1, 2, 'X', 'Y')"
                    description="At index 1, remove 2, insert 'X', 'Y'"
                />
            </Node>

            <Arrow />

            <Node label="Modified Array" type="output">
                <ArrayDisplay
                    values={["a", "X", "Y", "d"]}
                    highlightIndices={[1, 2]}
                    highlightType="added"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Return Value" type="output">
                <ArrayDisplay
                    values={["b", "c"]}
                    highlightIndices={[0, 1]}
                    highlightType="removed"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Returns an <code
                >array</code
            > of removed elements. Removes, adds or replaces items at any index.
        </MutableOrNot>

        <ProTip>
            <div>Set deleteCount to 0 to insert without deleting:</div>
            <div
                class="pl-2 border-l border-rule text-xs"
            >
                <code>arr.splice(2, 0, 'x', 'y')</code> inserts <code>'x'</code> and <code>'y'</code> at index 2.
            </div>
        </ProTip>
    </MethodCard>

    <!-- === REORDER === -->
    <SubSectionTitle id="reorder" parentColor="red">Reorder</SubSectionTitle>

    <!-- SORT -->
    <MethodCard
        id="sort"
        methodName="sort()"
        signature="arr.sort(compareFn?)"
        description="Sorts the array in place and returns the same array"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={[3, 1, 4, 2]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="sort((a, b) => a - b)"
                    description="Ascending order"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Same Array (Sorted)" type="output">
                <ArrayDisplay
                    values={[1, 2, 3, 4]}
                    highlightIndices={[0, 1, 2, 3]}
                    highlightType="transformed"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Sorts in place. Returns the <code
                >same array</code
            > (not a copy).
        </MutableOrNot>

        <ProTip>
            <div>
                Without a compare function, sort treats values as strings.
            </div>

            <div class="pl-2 border-l border-rule">
                <div class="font-mono text-xs">
                    ['b','d','a','c'].sort() → ['a','b','c','d']
                </div>
                <div class="font-mono text-xs">
                    ['b','d','a','c'].sort().reverse() → ['d','c','b','a']
                </div>
            </div>

            <div>For numbers, use a compare function:</div>

            <div class="pl-2 border-l border-rule">
                <div class="font-mono text-xs">
                    [2,4,1,3].sort((a,b) => a-b) → [1,2,3,4] <span
                        class="text-gray-400">// ascending</span
                    >
                </div>
                <div class="font-mono text-xs">
                    [2,4,1,3].sort((a,b) => b-a) → [4,3,2,1] <span
                        class="text-gray-400">// descending</span
                    >
                </div>
                <div class="font-mono text-xs text-gray-400">
                    // OR: .sort((a,b) => a-b).reverse() → [4,3,2,1]
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- REVERSE -->
    <MethodCard
        id="reverse"
        methodName="reverse()"
        signature="arr.reverse()"
        description="Reverses the array in place and returns the same array"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c"]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent name="reverse()" description="Flip order" />
            </Node>

            <Arrow label="returns" />

            <Node label="Same Array (Reversed)" type="output">
                <ArrayDisplay
                    values={["c", "b", "a"]}
                    highlightIndices={[0, 1, 2]}
                    highlightType="transformed"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Reverses in place. Returns the <code
                >same array</code
            > (not a copy).
        </MutableOrNot>
    </MethodCard>

    <!-- === OVERWRITE / MOVE === -->
    <SubSectionTitle id="overwrite-move" parentColor="red"
        >Overwrite / move</SubSectionTitle
    >

    <!-- FILL -->
    <MethodCard
        id="fill"
        methodName="fill()"
        signature="arr.fill(value, start?, end?)"
        description="Overwrites a section of the array with a static value"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={[1, 2, 3, 4, 5]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="fill(0, 1, 4)"
                    description="Fill indices 1-3 with 0"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Same Array (Modified)" type="output">
                <ArrayDisplay
                    values={[1, 0, 0, 0, 5]}
                    highlightIndices={[1, 2, 3]}
                    highlightType="transformed"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Overwrites in place. Returns the <code
                >same array</code
            >. End index is exclusive.
        </MutableOrNot>

        <ProTip>
            <div>Use it to fill array holes (empty slots):</div>
            <div class="pl-2 border-l border-rule space-y-0.5">
                <div class="font-mono text-xs">
                    Array(5).fill(0) → [0, 0, 0, 0, 0] <span
                        class="text-gray-400">// no holes!</span
                    >
                </div>
                <div class="font-mono text-xs">
                    Array(5) → [empty × 5] <span class="text-gray-400"
                        >// has holes, methods skip these</span
                    >
                </div>
            </div>
        </ProTip>
    </MethodCard>

    <!-- COPYWITHIN -->
    <MethodCard
        id="copyWithin"
        methodName="copyWithin()"
        signature="arr.copyWithin(target, start, end?)"
        description="Copies part of an array to another position in the same array"
        mutates={true}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={[1, 2, 3, 4, 5]} />
            </Node>

            <Arrow label="mutates" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="copyWithin(0, 3)"
                    description="Copy from index 3 to start"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="Same Array (Modified)" type="output">
                <ArrayDisplay
                    values={[4, 5, 3, 4, 5]}
                    highlightIndices={[0, 1]}
                    highlightType="transformed"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={true} message="">
            Copies within the same array. Returns the <code
                >same array</code
            >. Does not change the array length.
        </MutableOrNot>
    </MethodCard>

    <!-- ============================================ -->
    <!-- DOES NOT MUTATE (returns new value) -->
    <!-- ============================================ -->
    <SectionTitle id="immutable" color="green">
        Does not mutate (returns new value)
    </SectionTitle>

    <ProTip>
        <div>
            Chain immutable methods for cleaner, functional code:
        </div>
        <div class="pl-2 border-l border-rule space-y-0.5">
            <div class="font-mono text-xs">
                users.filter(u =&gt; u.active).map(u =&gt; u.name).slice(0, 10)
            </div>
            <div class="font-mono text-xs text-gray-400">
                // Filter → transform → take first 10 (all chainable!)
            </div>
        </div>
    </ProTip>

    <!-- === BUILD NEW ARRAYS === -->
    <SubSectionTitle id="build-arrays" parentColor="green"
        >Build new arrays</SubSectionTitle
    >

    <!-- MAP -->
    <MethodCard
        id="map"
        methodName="map()"
        signature="arr.map(fn)"
        description="Creates a new array by transforming each element with a function"
        mutates={false}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={[1, 2, 3]} />
            </Node>

            <Arrow label="transforms" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="map(n => n * 2)"
                    description="Double each value"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New Array" type="output">
                <ArrayDisplay
                    values={[2, 4, 6]}
                    highlightIndices={[0, 1, 2]}
                    highlightType="transformed"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Does not change the original array. Returns a <code
                >new array</code
            > with the same length and transformed values.
        </MutableOrNot>

        <ProTip>
            <div>
                Need the results? Use <code
                    >map()</code
                >. Just doing side effects? Use <code
                    >forEach()</code
                >.
            </div>
            <div
                class="pl-2 border-l border-rule font-mono text-xs"
            >
                const ids = users.map(u => u.id) <Mark type="yes" /><br />
                users.forEach(u => console.log(u)) <Mark type="yes" />
            </div>
        </ProTip>
    </MethodCard>

    <!-- FILTER -->
    <MethodCard
        id="filter"
        methodName="filter()"
        signature="arr.filter(fn)"
        description="Creates a new array with elements that pass a test function"
        mutates={false}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={[1, 2, 3, 4, 5]} />
            </Node>

            <Arrow label="filters" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="filter(n => n % 2 === 0)"
                    description="Keep even numbers"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New Array" type="output">
                <ArrayDisplay
                    values={[2, 4]}
                    highlightIndices={[0, 1]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Does not change the original array. Returns a <code
                >new array</code
            > (can be shorter) with only the items that pass.
        </MutableOrNot>

        <ProTip>
            <div>
                Use <code
                    >filter(Boolean)</code
                > to remove all falsy values in one call.
            </div>
            <div
                class="pl-2 border-l border-rule font-mono text-xs"
            >
                [0, 1, false, 2, '', 3, null].filter(Boolean) → [1, 2, 3]
            </div>
        </ProTip>
    </MethodCard>

    <!-- SLICE -->
    <MethodCard
        id="slice"
        methodName="slice()"
        signature="arr.slice(start, end)"
        description="Returns a shallow copy of a portion of an array"
        mutates={false}
    >
        <Flow>
            <Node label="Input Array" type="input">
                <ArrayDisplay values={["a", "b", "c", "d", "e"]} />
            </Node>

            <Arrow label="extracts" />

            <Node label="Method" type="process">
                <ProcessContent
                    name="slice(1, 4)"
                    description="Copy indices 1-3"
                />
            </Node>

            <Arrow label="returns" />

            <Node label="New Array" type="output">
                <ArrayDisplay
                    values={["b", "c", "d"]}
                    highlightIndices={[0, 1, 2]}
                    highlightType="added"
                />
            </Node>
        </Flow>

        <MutableOrNot mutates={false} message="">
            Does not change the original array. Returns a <code
                >new array</code
            > with the extracted section. The end index is exclusive. Supports
            negative indices.
        </MutableOrNot>

        <ProTip>
            <div class="pl-2 border-l border-rule">
                <div class="text-xs">
                    <code>slice(1, -1)</code> removes the first and last items.
                </div>
                <div class="text-xs">
                    <code>slice(-3)</code> gets the last 3 items.
                </div>
                <div class="text-xs">
                    <code>slice(0)</code> or <code>[...arr]</code> makes a shallow copy of the whole array.
                </div>
            </div>
            <div class="mt-1.5 text-xs">
                <Mark type="warn" /> <strong>Shallow vs deep copy:</strong>
            </div>
            <div class="pl-2 border-l border-rule mt-1 space-y-1">
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Simple values (strings/numbers) - shallow copy is
                        fine:</span
                    ><br />
                    const copy = [1, 2, 3].slice(0)<br />
                    copy[0] = 999 → original unaffected <Mark type="yes" />
                </div>
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Nested objects - shallow copy shares references!</span
                    ><br />
                    const users = [{"{"}id:1{"}"}, {"{"}id:2{"}"}]<br />
                    const copy = users.slice(0)<br />
                    copy[0].id = 999 → original[0].id is also 999 <Mark type="no" />
                </div>
                <div class="font-mono text-xs">
                    <span class="text-gray-400"
                        >// Deep copy - fully independent:</span
                    ><br />
                    const deep = structuredClone(users)<br />
                    deep[0].id = 999 → original unaffected <Mark type="yes" />
                </div>
            </div>
        </ProTip>
    </MethodCard>

