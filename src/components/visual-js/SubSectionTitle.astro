---
import { stripLeadingEmoji } from "../../lib/strip-emoji";

interface Props {
    id: string;
    parentColor?: string;
}

const { id } = Astro.props;
const html = stripLeadingEmoji(await Astro.slots.render("default"));
---

<h3
    id={id}
    class="text-sm font-semibold uppercase tracking-wide text-gray-400 mt-8 mb-1 scroll-mt-6"
    set:html={html}
/>
